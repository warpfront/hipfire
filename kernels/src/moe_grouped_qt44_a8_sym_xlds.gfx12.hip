// GEN-MOE packet A winner M3: `moe_grouped_qt44_a8_sym_gfx1201_xlds_nt4r1w8` — nt4 x rf1, 8 waves (block 256, dynamic LDS 17920),
// X epoch tile of a 4-tile (64-slot) expert run staged once per CTA in a 2-stage LDS ring shared by 8 waves.
// Launch: block 256, dynamic LDS 17920 B, grid [M / 128, m_total / 16, 1] (the nt2r2 grid; non-leader tiles return).
// Route: Gpu::gemm_mq4g256v2_moe_grouped_a8_sym behind HIPFIRE_MOE_A8_XLDS (developer, default OFF), gfx1201, m_total >= MOE_A8_XLDS_MIN_ROWS.
#define MC_NT 4
#define MC_RF 1
#define MC_NW 8
#define MC_ASINGLE 0

// Body of the M3 candidate (generated by mk_cands.py from moe_body.inc). Own export, same 72-byte kernarg ABI as
// the nt{1,2}r{1,2} entries, same arithmetic and output semantics as
// kernels/src/moe_grouped_qt44_a8_sym.gfx12.hip:
//   C_h = exact int32 sum over the 8 K16 WMMA steps of an epoch; sum = fma(RN(float(sc_h) * d_h), float(C_h), sum) in
//   ascending epoch order from +0; dead slots (sorted_slot_index < 0) contribute x = 0, d = 0; rows pos >= m_total are
//   not stored; tiles outside the expert's tile run are not computed or stored; non-leader tiles / bad experts return.
// Schedule: the activation epoch tile of the whole tile run (MC_NT x 16 slots x (128 qs + d)) is loaded ONCE per CTA
// (cooperative coalesced 8-byte global loads, one epoch ahead in registers), staged in a double-buffered LDS ring
// (one barrier per epoch) and read by every wave from LDS (the incumbent re-reads it per wave from global/L2).
// Weights stay register-direct (one epoch ahead, the incumbent's A loads). CTA = MC_NW waves x MC_RF 16-row fragments =
// 128 weight rows (the contract grid x = M / 128).

#include <hip/hip_runtime.h>
#include <stdint.h>

#if !defined(__gfx1201__) && defined(__HIP_DEVICE_COMPILE__)
#error "moe_grouped_qt44_a8_sym_xlds is gfx1201-only"
#endif

#define MC_ROWS (MC_NT * 16)
#define MC_QPITCH 136
#define MC_STAGE_QS (MC_ROWS * MC_QPITCH)
#define MC_STAGE (MC_ROWS * (MC_QPITCH + 4))
#define MC_NTH (MC_NW * 32)
#define MC_CPT (MC_ROWS * 16 / MC_NTH)
static_assert(MC_NW * MC_RF == 8, "CTA must cover 128 weight rows");
static_assert((MC_ROWS * 16) % MC_NTH == 0, "chunk count must divide the thread count");
static_assert(MC_ROWS <= MC_NTH, "one d per thread");

struct a8_block_i8_128 {
    float d;
    int s;
    signed char qs[128];
};

typedef int a8_i32x2 __attribute__((ext_vector_type(2)));
typedef int a8_i32x8 __attribute__((ext_vector_type(8)));
typedef unsigned a8_u32x2 __attribute__((ext_vector_type(2)));
typedef float mc_f32x4 __attribute__((ext_vector_type(4)));

// ---- global access points (MOE_INSTR: range-checked copy used by the card guard, mk_instr_moe.py) ---------------
// which: 0 expert weights (bytes of one slab), 1 Xq, 2 Y, 3 tile_ids, 4 expert_offsets, 5 sorted_slot_index, 6 ptr table
// Expert weights are read through address-space-1 (global) pointers so every load of the kernel is a `global_load_*`
// (the integer pointer table would otherwise give generic `flat_load_*`, a different in-order counter family).
typedef const __attribute__((address_space(1))) unsigned char* mc_gptr;
#ifdef MOE_INSTR
__device__ unsigned long long moe_oob[8];
__device__ unsigned long long moe_lim[8];  // extents in BYTES, set by the host
template <class T>
static __device__ __forceinline__ T mg_ld(int which, const void* base, const void* p) {
    const long long i = (long long)((const char*)p - (const char*)base);
    if (i < 0 || (unsigned long long)i + sizeof(T) > moe_lim[which]) {
        atomicAdd(&moe_oob[which], 1ull);
        T z = {};
        return z;
    }
    return *(const T*)p;
}
template <class T>
static __device__ __forceinline__ T mg_ldw(int which, mc_gptr base, mc_gptr p) {
    const long long i = (long long)((unsigned long long)p - (unsigned long long)base);
    if (i < 0 || (unsigned long long)i + sizeof(T) > moe_lim[which]) {
        atomicAdd(&moe_oob[which], 1ull);
        T z = {};
        return z;
    }
    return *(const __attribute__((address_space(1))) T*)p;
}
template <class T>
static __device__ __forceinline__ void mg_st(int which, void* base, void* p, T v) {
    const long long i = (long long)((char*)p - (char*)base);
    if (i < 0 || (unsigned long long)i + sizeof(T) > moe_lim[which]) {
        atomicAdd(&moe_oob[which], 1ull);
        return;
    }
    *(T*)p = v;
}
#else
template <class T>
static __device__ __forceinline__ T mg_ldw(int, mc_gptr, mc_gptr p) {
    return *(const __attribute__((address_space(1))) T*)p;
}
template <class T>
static __device__ __forceinline__ T mg_ld(int, const void*, const void* p) {
    return *(const T*)p;
}
template <class T>
static __device__ __forceinline__ void mg_st(int, void*, void* p, T v) {
    *(T*)p = v;
}
#endif

// LDS-only workgroup barrier (the gdn_chunk_scan / F2a idiom): the wave waits for its own LDS operations, global
// loads in flight stay in flight.
extern "C" __device__ void mc_wait_dscnt(unsigned short) __asm("llvm.amdgcn.s.wait.dscnt");
#define MC_BAR()                                                        \
    do {                                                                \
        __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local"); \
        mc_wait_dscnt(0);                                               \
        __builtin_amdgcn_s_barrier();                                   \
        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local"); \
    } while (0)

__device__ __forceinline__ float a8_f16_lo(unsigned int w) {
    return (float)__builtin_bit_cast(_Float16, (unsigned short)(w & 0xFFFFu));
}

struct a8_aop {
    unsigned w[8];
    float sc;
};

__device__ __forceinline__ void a8_load_a(a8_aop& o, mc_gptr wbase, mc_gptr row, int h, int hi) {
    mc_gptr g = row + (size_t)(h >> 1) * 136;
    o.sc = a8_f16_lo(mg_ldw<unsigned int>(0, wbase, g + 4 * (h & 1)));
    mc_gptr p = g + 8 + 64 * (h & 1) + 32 * hi;
#pragma unroll
    for (int s = 0; s < 4; ++s) {
        const a8_u32x2 v = mg_ldw<a8_u32x2>(0, wbase, p + 8 * s);
        o.w[2 * s] = v.x;
        o.w[2 * s + 1] = v.y;
    }
}

__device__ __forceinline__ a8_i32x2 a8_expand(unsigned w) {
    const unsigned lo = ((w & 0x0F0F0F0Fu) + 0x78787878u) ^ 0x80808080u;
    const unsigned hi = (((w >> 4) & 0x0F0F0F0Fu) + 0x78787878u) ^ 0x80808080u;
    a8_i32x2 r;
    r.x = (int)lo;
    r.y = (int)hi;
    return r;
}

// One epoch from the staged X tile `st` (LDS): the incumbent's per-(tile, fragment) int32 chain and fold.
template <bool FULL>
__device__ __forceinline__ void mc_epoch(float (&sum)[MC_NT][MC_RF][8], a8_aop (&a)[MC_RF],
                                         const unsigned char* st, int ntv, int lr, int hi, mc_gptr wbase,
                                         mc_gptr const (&wrow)[MC_RF], int hnext) {
    float scr[MC_RF][8];
    a8_i32x2 ax[MC_RF][8];
#pragma unroll
    for (int rf = 0; rf < MC_RF; ++rf) {
#pragma unroll
        for (int j = 0; j < 8; ++j) scr[rf][j] = __shfl(a[rf].sc, 8 * hi + j, 32);
#pragma unroll
        for (int s = 0; s < 8; ++s) ax[rf][s] = a8_expand(a[rf].w[s]);
    }
#if MC_ASINGLE
    // single A register set: the next epoch's weights are fetched into the same registers right after the expand,
    // under this epoch's WMMA chain (hnext < 0: no next epoch)
    if (hnext >= 0) {
#pragma unroll
        for (int rf = 0; rf < MC_RF; ++rf) a8_load_a(a[rf], wbase, wrow[rf], hnext, hi);
    }
#endif
#pragma unroll
    for (int i = 0; i < MC_NT; ++i) {
        if (!FULL && i >= ntv) break;
        const unsigned char* qs = st + (i * 16 + lr) * MC_QPITCH + 64 * hi;
        const float xd = *(const float*)(st + MC_STAGE_QS + (i * 16 + lr) * 4);
        a8_u32x2 xv[8];
#pragma unroll
        for (int s = 0; s < 8; ++s) xv[s] = *(const a8_u32x2*)(qs + 8 * s);
#pragma unroll
        for (int rf = 0; rf < MC_RF; ++rf) {
            a8_i32x8 c = {0, 0, 0, 0, 0, 0, 0, 0};
#pragma unroll
            for (int s = 0; s < 8; ++s) {
                const a8_i32x2 x2 = {(int)xv[s].x, (int)xv[s].y};
                c = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32_gfx12(true, ax[rf][s], true, x2, c, false);
            }
#pragma unroll
            for (int j = 0; j < 8; ++j)
                sum[i][rf][j] = __fmaf_rn(__fmul_rn(scr[rf][j], xd), (float)c[j], sum[i][rf][j]);
        }
    }
}

struct mc_xregs {
    a8_u32x2 q[MC_CPT];
    float d;
};

template <bool FULL>
__device__ __forceinline__ void mc_body(mc_gptr wbase, mc_gptr const (&wrow)[MC_RF],
                                        const a8_block_i8_128* xbase, const int (&xoff)[MC_CPT], int dsl,
                                        float* __restrict__ Y, int tile, int ntv, int rbase, int M, int K,
                                        int m_total, size_t x_src_rows, int lr, int hi, int tid) {
    extern __shared__ __attribute__((aligned(16))) unsigned char mc_smem[];
    float sum[MC_NT][MC_RF][8];
#pragma unroll
    for (int i = 0; i < MC_NT; ++i)
#pragma unroll
        for (int rf = 0; rf < MC_RF; ++rf)
#pragma unroll
            for (int j = 0; j < 8; ++j) sum[i][rf][j] = 0.0f;

    const int epochs = K >> 7;  // even (K % 256 == 0)
    const int part = tid & 15;
    const int row0 = tid >> 4;
    a8_aop a0[MC_RF];
#if !MC_ASINGLE
    a8_aop a1[MC_RF];
#endif
    mc_xregs xc;
#define MC_LOADX(h)                                                                                        \
    do {                                                                                                   \
        _Pragma("unroll") for (int c = 0; c < MC_CPT; ++c) {                                               \
            /* branchless: a dead row reads row 0 of the epoch (always in bounds) and is zeroed by a select */ \
            const a8_block_i8_128* b = xbase + (size_t)(h) * x_src_rows + max(xoff[c], 0);                 \
            const a8_u32x2 z = mg_ld<a8_u32x2>(1, xbase, b->qs + 8 * part);                                \
            xc.q[c] = xoff[c] >= 0 ? z : (a8_u32x2){0u, 0u};                                               \
        }                                                                                                  \
        const float dz = mg_ld<float>(1, xbase, &(xbase + (size_t)(h) * x_src_rows + max(dsl, 0))->d);    \
        xc.d = dsl >= 0 ? dz : 0.0f;                                                                       \
    } while (0)
#define MC_STOREX(buf)                                                                                     \
    do {                                                                                                   \
        unsigned char* st_ = mc_smem + (buf) * MC_STAGE;                                                   \
        _Pragma("unroll") for (int c = 0; c < MC_CPT; ++c)                                                 \
            *(a8_u32x2*)(st_ + (c * (MC_NTH / 16) + row0) * MC_QPITCH + 8 * part) = xc.q[c];               \
        if (tid < MC_ROWS) *(float*)(st_ + MC_STAGE_QS + tid * 4) = xc.d;                                  \
    } while (0)
#define MC_LOADA(h, A)                                                                                     \
    do {                                                                                                   \
        _Pragma("unroll") for (int rf = 0; rf < MC_RF; ++rf) a8_load_a(A[rf], wbase, wrow[rf], (h), hi);  \
    } while (0)

    MC_LOADX(0);
    MC_LOADA(0, a0);
    MC_STOREX(0);
    MC_BAR();
    for (int h = 0; h < epochs; h += 2) {
#if MC_ASINGLE
        MC_LOADX(h + 1);
        mc_epoch<FULL>(sum, a0, mc_smem, ntv, lr, hi, wbase, wrow, h + 1);
        MC_STOREX(1);
        MC_BAR();
        if (h + 2 < epochs) MC_LOADX(h + 2);
        mc_epoch<FULL>(sum, a0, mc_smem + MC_STAGE, ntv, lr, hi, wbase, wrow, h + 2 < epochs ? h + 2 : -1);
#else
        MC_LOADA(h + 1, a1);
        MC_LOADX(h + 1);
        mc_epoch<FULL>(sum, a0, mc_smem, ntv, lr, hi, wbase, wrow, -1);
        MC_STOREX(1);
        MC_BAR();
        if (h + 2 < epochs) {
            MC_LOADA(h + 2, a0);
            MC_LOADX(h + 2);
        }
        mc_epoch<FULL>(sum, a1, mc_smem + MC_STAGE, ntv, lr, hi, wbase, wrow, -1);
#endif
        if (h + 2 < epochs) {
            MC_STOREX(0);
            MC_BAR();
        }
    }
#undef MC_LOADX
#undef MC_STOREX
#undef MC_LOADA
#pragma unroll
    for (int i = 0; i < MC_NT; ++i) {
        if (!FULL && i >= ntv) break;
        const int pos = (tile + i) * 16 + lr;
        if (pos < m_total) {
#pragma unroll
            for (int rf = 0; rf < MC_RF; ++rf) {
                float* y = Y + (size_t)pos * M + rbase + rf * 16 + 8 * hi;
                mg_st<mc_f32x4>(2, Y, y, (mc_f32x4){sum[i][rf][0], sum[i][rf][1], sum[i][rf][2], sum[i][rf][3]});
                mg_st<mc_f32x4>(2, Y, y + 4, (mc_f32x4){sum[i][rf][4], sum[i][rf][5], sum[i][rf][6], sum[i][rf][7]});
            }
        }
    }
}

extern "C" __global__ __launch_bounds__(MC_NTH) void moe_grouped_qt44_a8_sym_gfx1201_xlds_nt4r1w8(
    const unsigned long long* __restrict__ expert_weight_ptrs, const int* __restrict__ expert_tile_ids,
    const int* __restrict__ expert_offsets, const int* __restrict__ sorted_slot_index,
    const a8_block_i8_128* __restrict__ Xq, float* __restrict__ Y, int M, int K, int x_row_div, int m_total,
    int x_src_rows, int n_experts) {
    const int tile = blockIdx.y;
    if (tile * 16 >= m_total) return;
    const int e = mg_ld<int>(3, expert_tile_ids, expert_tile_ids + tile);
    if (e < 0 || e >= n_experts) return;
    const int first = mg_ld<int>(4, expert_offsets, expert_offsets + e) >> 4;
    if (((tile - first) % MC_NT) != 0) return;
    const int tiles_total = m_total >> 4;
    int ntv = 1;
    while (ntv < MC_NT && tile + ntv < tiles_total && mg_ld<int>(3, expert_tile_ids, expert_tile_ids + tile + ntv) == e)
        ++ntv;

    const int tid = threadIdx.x;
    const int wave = tid >> 5, lane = tid & 31, lr = lane & 15, hi = lane >> 4;
    const int rbase = blockIdx.x * 128 + wave * (16 * MC_RF);
    const size_t row_bytes = (size_t)(K >> 8) * 136;
    mc_gptr W = (mc_gptr)mg_ld<unsigned long long>(6, expert_weight_ptrs, expert_weight_ptrs + e);
    mc_gptr wrow[MC_RF];
#pragma unroll
    for (int rf = 0; rf < MC_RF; ++rf) wrow[rf] = W + (size_t)(rbase + rf * 16 + lr) * row_bytes;

    // cooperative X chunk map: chunk c of this thread = 8 bytes of qs, part = tid & 15, staged row c * (NTH/16) + tid / 16.
    // The slot loads and the x_row_div division run unconditionally at full EXEC (rows past the run are clamped into
    // the table and masked by a select afterwards), so no divergent region contains the uniform-denominator division.
    int xoff[MC_CPT];
#pragma unroll
    for (int c = 0; c < MC_CPT; ++c) {
        const int row = c * (MC_NTH / 16) + (tid >> 4);  // 0 .. MC_ROWS - 1
        const int i = row >> 4;
        const int tq = min(tile + i, tiles_total - 1);
        const int slot = mg_ld<int>(5, sorted_slot_index, sorted_slot_index + tq * 16 + (row & 15));
        const int q = (int)((unsigned)max(slot, 0) / (unsigned)x_row_div);
        xoff[c] = (i < ntv && slot >= 0) ? q : -1;
    }
    int dsl;
    {
        const int drow = tid & (MC_ROWS - 1);
        const int i = drow >> 4;
        const int tq = min(tile + i, tiles_total - 1);
        const int slot = mg_ld<int>(5, sorted_slot_index, sorted_slot_index + tq * 16 + (drow & 15));
        const int q = (int)((unsigned)max(slot, 0) / (unsigned)x_row_div);
        dsl = (tid < MC_ROWS && i < ntv && slot >= 0) ? q : -1;
    }
    if (ntv == MC_NT) {
        mc_body<true>(W, wrow, Xq, xoff, dsl, Y, tile, ntv, rbase, M, K, m_total, (size_t)x_src_rows, lr, hi, tid);
    } else {
        mc_body<false>(W, wrow, Xq, xoff, dsl, Y, tile, ntv, rbase, M, K, m_total, (size_t)x_src_rows, lr, hi, tid);
    }
}
