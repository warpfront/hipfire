// GEN-FA2 F2a flash prefill, q128w8-kt64 body (symbol `latent_attention_flash_prefill_fa2_q128w8`).
// Generated verbatim by `mk_cands.py` from the template `f2a_body.inc` (pmrip/fa2-cand/); never hand-edited
// beyond the symbol and header. Judged on R9700 (gfx1201), card E, fabric job j6115: bit-identical to
// `latent_attention_flash_prefill` (kernels/src/latent_attention_flash.hip) in every contract-derived row class.
// Product launch: block 256, dynamic LDS 44032, grid [ceil(n_rows / 128), n_heads, 1] (the "grid.x is ceil(n_rows/64)"
// remarks below describe the generator's original harness; the early return keeps any larger grid safe).
// Routed from `Gpu::latent_attention_flash_prefill` behind HIPFIRE_ATTN_FA2_GENERIC (default OFF).
#define F2A_NW 8
#define F2A_RING 0
#define F2A_LATE 0
#define F2A_PIPE 1
#define F2A_KT 64
#define F2A_VPW 36

// Candidate body of `latent_attention_flash_prefill` (generated by mk_cands.py from f2a_body.inc; edit the
// template, not the generated files). Same symbol, same 108-byte kernarg ABI, same output semantics as
// kernels/src/latent_attention_flash.hip (`generic_seq.latent_attention_flash_prefill`, pinned geometry wa 128,
// wb 64, dv 128, gfx12 only), different schedule (GEN-FA2 §5.1 for group-1 MHA):
//
//   * CTA = one head x one query tile of 16 * F2A_NW rows (one wave per 16 query rows; heaviest, latest tile
//     first); grid.x = the contract's ceil(n_rows / 64) tiles, CTAs past ceil(n_rows / (16 * F2A_NW)) return at
//     once (before any barrier), so no header grid is needed at any n_rows.
//   * Q (BF16-rounded once, exactly the incumbent's rounding) is resident in VGPRs as 12 B-operand fragments
//     (dq 192 = 128 + 64 shared tail); the F32 O^T accumulator (dv 128) is resident (8 x 8 VGPRs).
//   * K (ka cols 0..127 ++ kb cols 128..191 of one padded row) and V^T are STREAMED THROUGH LDS, one stage:
//     cooperative 16-byte fill, global -> VGPR prefetch of the NEXT tile issued right after the current tile's
//     stage is written (its latency hides under the whole tile), LDS-only workgroup barriers (the "local" fences
//     keep those prefetches in flight; a __syncthreads() would wait for them).
//   * S^T = K . Q^T (lane-local softmax state), O^T = V^T . P^T with the incumbent's fragment maps and key
//     permutation inside a 16-key sub-tile.
//
// Numeric recipe (GEN-FA2 §5.2) = the incumbent's, statement for statement: F32 scores * scale, tile max,
// p = exp2((s - m') * log2e) rounded to BF16 BEFORE both the PV product and the denominator, denominator summed
// from the rounded values in the fixed (sub-tile, j) order, per-lane partial l combined with one xor-16 exchange,
// `round_y`, the `*pos + pos_offset + i` / `max_rows` mask, empty rows -> zeros, shared tail head stride 0.
// With F2A_KT = 64 the key tiles, WMMA chains and the softmax update schedule are the incumbent's, so the output
// is meant to be bit-identical; with F2A_KT = 32 (F2A_RING) the running max is updated every 32 keys, which is a
// different (still deterministic) rounding schedule: the output goes to the numeric screen, not the identity gate.
//
// Requirements (the contract domain enforces them; a violating launch leaves y untouched): wa 128, wb 64, dv 128,
// blockDim.x == 32 * F2A_NW, dynamic LDS == F2A_LDS, every offset/stride a multiple of 8 elements, 16-byte
// aligned base pointers (as the incumbent).

#include <hip/hip_runtime.h>
#include <stdint.h>

#if defined(__HIP_DEVICE_COMPILE__) && !defined(__GFX12__)
#error "F2a candidates are gfx12 (gfx1201) only"
#endif

#define F2A_WA 128
#define F2A_WB 64
#define F2A_DV 128
#define F2A_DQ (F2A_WA + F2A_WB)
#define F2A_NT (F2A_NW * 32)           // threads per CTA
#define F2A_QT (16 * F2A_NW)           // query rows per CTA
#define F2A_NKS (F2A_KT / 16)          // 16-key sub-tiles per key tile
#define F2A_KP 200                     // LDS pitch of a staged K row (elements): 192 + 8 (conflict-free b128 reads)
#define F2A_KRW (F2A_NT / 8)           // K rows filled per pass (8 threads x 16 B = one 128-byte half row)
#define F2A_KR (F2A_KT / F2A_KRW)      // fill passes per thread
#define F2A_KBYTES (F2A_KT * F2A_KP * 2)
#define F2A_VBYTES (F2A_DV * F2A_VPW * 4)
#define F2A_SLOT (F2A_KBYTES + F2A_VBYTES)
#define F2A_LDS (F2A_SLOT * (F2A_RING ? 2 : 1))
#if F2A_RING
#define F2A_VGS (2 * F2A_NW)           // V column groups (8 columns) covered per pass: 2 lane halves per wave
#else
#define F2A_VGS F2A_NW
#endif
#define F2A_VG (16 / F2A_VGS)          // passes per lane over the 16 column groups

static __device__ __forceinline__ float f2a_exp(float x) {
    return __builtin_amdgcn_exp2f(x * 1.4426950408889634f);
}

typedef short __attribute__((ext_vector_type(8))) f2a_s8_t;
typedef unsigned int __attribute__((ext_vector_type(4))) f2a_u4_t;
typedef float __attribute__((ext_vector_type(8))) f2a_f8_t;

static __device__ __forceinline__ uint32_t f2a_f32_to_bf16(float f) {
    uint32_t u = __float_as_uint(f);
    if ((u & 0x7fffffffu) > 0x7f800000u) return (u >> 16) | 0x40u;
    u += 0x7fffu + ((u >> 16) & 1u);
    return u >> 16;
}

// Round-to-nearest-even of a finite value, result left in the high 16 bits.
static __device__ __forceinline__ uint32_t f2a_rne_hi(float f) {
    const uint32_t u = __float_as_uint(f);
    return (u + 0x7fffu + ((u >> 16) & 1u)) & 0xffff0000u;
}

static __device__ __forceinline__ f2a_f8_t f2a_wmma(f2a_s8_t a, f2a_s8_t b, f2a_f8_t c) {
    return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32_gfx12(a, b, c);
}

// LDS-only workgroup barrier. A __syncthreads() also waits for every outstanding global load (workgroup-scope
// fence), which would serialize the register prefetch of the next tile; the "local" fences leave them in flight.
// Each wave waits for its own LDS operations (s_wait_dscnt 0, bound by name: clang has no builtin) before it
// signals, and the explicit wait cannot be erased as redundant (see gdn_chunk_scan.gfx1201.hip).
extern "C" __device__ void f2a_wait_dscnt(unsigned short) __asm("llvm.amdgcn.s.wait.dscnt");
#define F2A_BAR()                                                         \
    do {                                                                  \
        __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");   \
        f2a_wait_dscnt(0);                                                \
        __builtin_amdgcn_s_barrier();                                     \
        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");   \
    } while (0)

// ---- global -> VGPR prefetch of one key tile ----------------------------------------------------------------
// K: row `krow0 + r * F2A_KRW` of the tile, thread `part` of 8: half-row words [part*8, part*8+8) of ka (dims
// 0..63 and 64..127) and of kb (dims 128..191). Rows at or past `kend` are never read (zero-filled).
static __device__ __forceinline__ void f2a_load_k(
    uint4 (&kr)[F2A_KR][3], const uint16_t* __restrict__ ka, const uint16_t* __restrict__ kb,
    int kb0, int kend, int h, int ka_tok, int ka_head, int kb_tok, int kb_head, int krow0, int part
) {
#pragma unroll
    for (int r = 0; r < F2A_KR; ++r) {
        const int row = kb0 + krow0 + r * F2A_KRW;
        if (row < kend) {
            const uint16_t* pa = ka + (size_t)row * ka_tok + (size_t)h * ka_head + part * 8;
            const uint16_t* pb = kb + (size_t)row * kb_tok + (size_t)h * kb_head + part * 8;
            kr[r][0] = *(const uint4*)pa;
            kr[r][1] = *(const uint4*)(pa + 64);
            kr[r][2] = *(const uint4*)pb;
        } else {
            kr[r][0] = make_uint4(0u, 0u, 0u, 0u);
            kr[r][1] = make_uint4(0u, 0u, 0u, 0u);
            kr[r][2] = make_uint4(0u, 0u, 0u, 0u);
        }
    }
}

static __device__ __forceinline__ void f2a_store_k(
    uint16_t* ksb, const uint4 (&kr)[F2A_KR][3], int krow0, int part
) {
#pragma unroll
    for (int r = 0; r < F2A_KR; ++r) {
        uint16_t* d = ksb + (size_t)(krow0 + r * F2A_KRW) * F2A_KP + part * 8;
        *(uint4*)d = kr[r][0];
        *(uint4*)(d + 64) = kr[r][1];
        *(uint4*)(d + 128) = kr[r][2];
    }
}

// V: lane = key pair `vp` of the tile (keys (4q + r) | (4q + 2 + r) of 16-key sub-tile vks, word 2q + r), one
// 8-column group g per pass. Keys at or past `kend` are never read (zero-filled).
static __device__ __forceinline__ void f2a_load_v(
    uint4 (&va)[F2A_VG], uint4 (&vb)[F2A_VG], const uint16_t* __restrict__ vv, int kb0, int kend, int h,
    int v_tok, int v_head, int vklo, int vg0
) {
    const bool oka = kb0 + vklo < kend, okb = kb0 + vklo + 2 < kend;
    const uint16_t* vpa = vv + (size_t)(oka ? kb0 + vklo : 0) * v_tok + (size_t)h * v_head;
    const uint16_t* vpb = vv + (size_t)(okb ? kb0 + vklo + 2 : 0) * v_tok + (size_t)h * v_head;
#pragma unroll
    for (int it = 0; it < F2A_VG; ++it) {
        const int g = vg0 + it * F2A_VGS;
        va[it] = make_uint4(0u, 0u, 0u, 0u);
        vb[it] = make_uint4(0u, 0u, 0u, 0u);
        if (oka) va[it] = *(const uint4*)(vpa + g * 8);
        if (okb) vb[it] = *(const uint4*)(vpb + g * 8);
    }
}

// One V^T task: 8 value columns of key pair `p`: word p of rows g*8 .. g*8+7 of the [128][F2A_VPW] table.
static __device__ __forceinline__ void f2a_v_store(uint32_t* vs, int g, int p, uint4 a, uint4 b) {
    const uint32_t aw[4] = {a.x, a.y, a.z, a.w};
    const uint32_t bw[4] = {b.x, b.y, b.z, b.w};
    uint32_t* col = vs + (g * 8) * F2A_VPW + p;
#pragma unroll
    for (int i = 0; i < 4; ++i) {
        col[(2 * i) * F2A_VPW] = (aw[i] & 0xffffu) | (bw[i] << 16);
        col[(2 * i + 1) * F2A_VPW] = (aw[i] >> 16) | (bw[i] & 0xffff0000u);
    }
}

static __device__ __forceinline__ void f2a_store_v(
    uint32_t* vs, const uint4 (&va)[F2A_VG], const uint4 (&vb)[F2A_VG], int vg0, int vp
) {
#pragma unroll
    for (int it = 0; it < F2A_VG; ++it) f2a_v_store(vs, vg0 + it * F2A_VGS, vp, va[it], vb[it]);
}

// ---- S^T = K . Q^T for one key tile from the LDS stage ----------------------------------------------------------
static __device__ __forceinline__ void f2a_ld_k(
    f2a_s8_t (&fr)[F2A_NKS], const uint16_t* ksb, int s, int l16, int hh
) {
#pragma unroll
    for (int ks = 0; ks < F2A_NKS; ++ks) {
        const uint4 u = *(const uint4*)(ksb + (size_t)(ks * 16 + l16) * F2A_KP + 16 * s + 8 * hh);
        fr[ks] = __builtin_bit_cast(f2a_s8_t, u);
    }
}

#if F2A_PIPE
// The LDS fragments are software-pipelined one contraction step ahead and the scheduler is fenced per step: left
// alone it hoists most of the 12 x F2A_NKS reads above the WMMA chain, which costs ~100 VGPRs.
static __device__ __forceinline__ void f2a_qk(
    f2a_f8_t (&acc)[F2A_NKS], const uint16_t* ksb, const f2a_s8_t (&qf)[12], int l16, int hh
) {
    f2a_s8_t cur[F2A_NKS], nxt[F2A_NKS];
    f2a_ld_k(cur, ksb, 0, l16, hh);
#pragma unroll
    for (int s = 0; s < 12; ++s) {
        if (s + 1 < 12) f2a_ld_k(nxt, ksb, s + 1, l16, hh);
#pragma unroll
        for (int ks = 0; ks < F2A_NKS; ++ks) acc[ks] = f2a_wmma(cur[ks], qf[s], acc[ks]);
        __builtin_amdgcn_sched_barrier(0);
#pragma unroll
        for (int ks = 0; ks < F2A_NKS; ++ks) cur[ks] = nxt[ks];
    }
}
#else
static __device__ __forceinline__ void f2a_qk(
    f2a_f8_t (&acc)[F2A_NKS], const uint16_t* ksb, const f2a_s8_t (&qf)[12], int l16, int hh
) {
#pragma unroll
    for (int s = 0; s < 12; ++s) {
        f2a_s8_t fr[F2A_NKS];
        f2a_ld_k(fr, ksb, s, l16, hh);
#pragma unroll
        for (int ks = 0; ks < F2A_NKS; ++ks) acc[ks] = f2a_wmma(fr[ks], qf[s], acc[ks]);
    }
}
#endif

// One tile of work of a live wave on the stage at `ksb` / `vsb`: scale, mask, online softmax, then O^T += V^T . P^T.
// `kb0` is the first key of the tile; the V^T stage must be complete when `f2a_pv` runs (it is a separate step
// so the caller can place its barrier between them).
struct F2aState {
    f2a_f8_t o[8];
    float m;
    float l;
};

static __device__ __forceinline__ void f2a_softmax(
    F2aState& st, f2a_s8_t (&pf)[F2A_NKS], const uint16_t* ksb, const f2a_s8_t (&qf)[12], int kb0, int l16, int hh,
    int lim_first, int lim_i, float scale
) {
    f2a_f8_t acc_s[F2A_NKS];
#pragma unroll
    for (int ks = 0; ks < F2A_NKS; ++ks) acc_s[ks] = f2a_f8_t{0, 0, 0, 0, 0, 0, 0, 0};
    f2a_qk(acc_s, ksb, qf, l16, hh);

    const bool need_mask = kb0 + (F2A_KT - 1) > lim_first;
    float sv[F2A_NKS][8];
    float tmax = -INFINITY;
#pragma unroll
    for (int ks = 0; ks < F2A_NKS; ++ks) {
#pragma unroll
        for (int j = 0; j < 8; ++j) {
            float s = acc_s[ks][j] * scale;
            if (need_mask) {
                const int kj = kb0 + ks * 16 + 8 * hh + j;
                s = (kj <= lim_i) ? s : -INFINITY;
            }
            sv[ks][j] = s;
            tmax = fmaxf(tmax, s);
        }
    }
    tmax = fmaxf(tmax, __shfl_xor(tmax, 16, 32));
    const float m_new = fmaxf(st.m, tmax);
    const float mshift = (m_new == -INFINITY) ? 0.0f : m_new;
    const float corr = f2a_exp(st.m - mshift);  // m == -inf -> 0 (nothing accumulated yet)
    st.m = m_new;

    float lsum = 0.0f;
#pragma unroll
    for (int ks = 0; ks < F2A_NKS; ++ks) {
        uint32_t pw[8];  // rounded probabilities, bf16 in the high half
#pragma unroll
        for (int j = 0; j < 8; ++j) {
            pw[j] = f2a_rne_hi(f2a_exp(sv[ks][j] - mshift));
            lsum += __uint_as_float(pw[j]);
        }
        // word m' packs acc[4(m'>>1) + (m'&1)] | acc[... + 2] << 16.
        uint32_t pk[4];
#pragma unroll
        for (int w = 0; w < 4; ++w) {
            const int lo = 4 * (w >> 1) + (w & 1);
            pk[w] = (pw[lo] >> 16) | pw[lo + 2];
        }
        const f2a_u4_t W = {pk[0], pk[1], pk[2], pk[3]};
        pf[ks] = __builtin_bit_cast(f2a_s8_t, W);
    }
    st.l = st.l * corr + lsum;
#pragma unroll
    for (int d = 0; d < 8; ++d) st.o[d] *= corr;
}

static __device__ __forceinline__ void f2a_ld_v(
    f2a_s8_t (&fr)[F2A_NKS], const uint32_t* vsb, int d, int l16, int hh
) {
    const uint32_t* arow = vsb + (size_t)(d * 16 + l16) * F2A_VPW;
#pragma unroll
    for (int ks = 0; ks < F2A_NKS; ++ks) {
        const uint4 u = *(const uint4*)(arow + ks * 8 + 4 * hh);
        fr[ks] = __builtin_bit_cast(f2a_s8_t, u);
    }
}

#if F2A_PIPE
static __device__ __forceinline__ void f2a_pv(
    F2aState& st, const f2a_s8_t (&pf)[F2A_NKS], const uint32_t* vsb, int l16, int hh
) {
    f2a_s8_t cur[F2A_NKS], nxt[F2A_NKS];
    f2a_ld_v(cur, vsb, 0, l16, hh);
#pragma unroll
    for (int d = 0; d < 8; ++d) {
        if (d + 1 < 8) f2a_ld_v(nxt, vsb, d + 1, l16, hh);
#pragma unroll
        for (int ks = 0; ks < F2A_NKS; ++ks) st.o[d] = f2a_wmma(cur[ks], pf[ks], st.o[d]);
        __builtin_amdgcn_sched_barrier(0);
#pragma unroll
        for (int ks = 0; ks < F2A_NKS; ++ks) cur[ks] = nxt[ks];
    }
}
#else
static __device__ __forceinline__ void f2a_pv(
    F2aState& st, const f2a_s8_t (&pf)[F2A_NKS], const uint32_t* vsb, int l16, int hh
) {
#pragma unroll
    for (int d = 0; d < 8; ++d) {
        f2a_s8_t fr[F2A_NKS];
        f2a_ld_v(fr, vsb, d, l16, hh);
#pragma unroll
        for (int ks = 0; ks < F2A_NKS; ++ks) st.o[d] = f2a_wmma(fr[ks], pf[ks], st.o[d]);
    }
}
#endif

extern "C" __global__ __launch_bounds__(F2A_NT) void latent_attention_flash_prefill_fa2_q128w8(
    const float* __restrict__ q,         // [n_rows, H, dq]
    float* __restrict__ y,               // [n_rows, H, dv]
    const uint16_t* __restrict__ ka,     // BF16 view, offset already applied
    const uint16_t* __restrict__ kb,
    const uint16_t* __restrict__ vv,
    const int* __restrict__ pos_ptr,     // device scalar: rows cached before this call
    int n_rows, int n_heads, int wa, int wb, int dv, int pos_offset, int max_rows,
    int ka_tok, int ka_head, int kb_tok, int kb_head, int v_tok, int v_head,
    float scale, int round_y
) {
    extern __shared__ __attribute__((aligned(16))) unsigned char f2a_smem[];
    // Contract guard (workgroup-uniform, before any barrier): the geometry this body was written for. The
    // contract domain and the header make a violation unreachable; the launch then leaves y untouched, which the
    // identity gate reports (no trap: the emulator has no s_trap).
    if (wa != F2A_WA || wb != F2A_WB || dv != F2A_DV || (int)blockDim.x != F2A_NT) return;

    const int ntiles = (n_rows + F2A_QT - 1) / F2A_QT;
    if ((int)blockIdx.x >= ntiles) return;  // grid.x is the contract's ceil(n_rows / 64)

    const int tid = threadIdx.x;
    const int wave = tid >> 5, lane = tid & 31, l16 = lane & 15, hh = lane >> 4;
    const int h = blockIdx.y;
    const int tile = ntiles - 1 - (int)blockIdx.x;  // heaviest tile first
    const int i0 = tile * F2A_QT;

    // Visible limit per query row: keys j <= lim_i. Rows past n_rows replicate the last row (their output is
    // never stored).
    const int base = *pos_ptr + pos_offset;
    const int wrow0 = i0 + wave * 16;
    const int row_l = wrow0 + l16;
    const int lim_row = min(row_l, n_rows - 1);
    const int lim_i = min(base + lim_row, max_rows - 1);
    const int lim_first = min(base + min(wrow0, n_rows - 1), max_rows - 1);
    const int lim_last = min(base + min(wrow0 + 15, n_rows - 1), max_rows - 1);
    const int kend = max(0, min(base + min(i0 + F2A_QT - 1, n_rows - 1), max_rows - 1) + 1);

    // ---- Q^T B-operand fragments, BF16-rounded once (the incumbent's staging rounding), resident for the loop.
    // Lane (hh, l16) holds query row wrow0 + l16, dims 16 * s + 8 * hh + e of chunk s.
    f2a_s8_t qf[12];
    {
        const bool ok = row_l < n_rows;
        const float* src = q + ((size_t)(ok ? row_l : 0) * n_heads + h) * F2A_DQ + 8 * hh;
#pragma unroll
        for (int s = 0; s < 12; ++s) {
            f2a_u4_t w = {0u, 0u, 0u, 0u};
            if (ok) {
                const float4 a = *(const float4*)(src + 16 * s);
                const float4 b = *(const float4*)(src + 16 * s + 4);
                w = f2a_u4_t{f2a_f32_to_bf16(a.x) | (f2a_f32_to_bf16(a.y) << 16),
                             f2a_f32_to_bf16(a.z) | (f2a_f32_to_bf16(a.w) << 16),
                             f2a_f32_to_bf16(b.x) | (f2a_f32_to_bf16(b.y) << 16),
                             f2a_f32_to_bf16(b.z) | (f2a_f32_to_bf16(b.w) << 16)};
            }
            qf[s] = __builtin_bit_cast(f2a_s8_t, w);
        }
    }

    F2aState st;
#pragma unroll
    for (int d = 0; d < 8; ++d) st.o[d] = f2a_f8_t{0, 0, 0, 0, 0, 0, 0, 0};
    st.m = -INFINITY;
    st.l = 0.0f;

    // Fill geometry. K: thread = (row group krow0, half-row part). V: lane = key pair vp of the tile.
    const int krow0 = tid >> 3, part = tid & 7;
#if F2A_RING
    const int vg0 = wave * 2 + hh, vp = l16;
#else
    const int vg0 = wave, vp = lane;
#endif
    const int vks = vp >> 3, vq = (vp >> 1) & 3, vr = vp & 1;
    const int vklo = vks * 16 + 4 * vq + vr;

    uint4 kr[F2A_KR][3];
    uint4 va[F2A_VG], vb[F2A_VG];

#if !F2A_RING
    // ===== single-stage KT64 schedule: K ready barrier, then V^T ready barrier =================================
    uint16_t* ksb = (uint16_t*)f2a_smem;
    uint32_t* vsb = (uint32_t*)(f2a_smem + F2A_KBYTES);
    f2a_load_k(kr, ka, kb, 0, kend, h, ka_tok, ka_head, kb_tok, kb_head, krow0, part);
#if !F2A_LATE
    f2a_load_v(va, vb, vv, 0, kend, h, v_tok, v_head, vklo, vg0);
#endif
    for (int kb0 = 0; kb0 < kend; kb0 += F2A_KT) {
        const bool more = kb0 + F2A_KT < kend;
        // K stage is free: every wave finished its QK of the previous tile before the previous V barrier.
        f2a_store_k(ksb, kr, krow0, part);
#if F2A_LATE
        // V rows of this tile are fetched under the QK + softmax math (their VGPRs are dead during the PV).
        f2a_load_v(va, vb, vv, kb0, kend, h, v_tok, v_head, vklo, vg0);
#else
        if (more) f2a_load_k(kr, ka, kb, kb0 + F2A_KT, kend, h, ka_tok, ka_head, kb_tok, kb_head, krow0, part);
#endif
        F2A_BAR();  // K ready; every wave also finished its PV (V^T reads) of the previous tile

        const bool wave_live = kb0 <= lim_last;
        f2a_s8_t pf[F2A_NKS];
        if (wave_live) f2a_softmax(st, pf, ksb, qf, kb0, l16, hh, lim_first, lim_i, scale);

        f2a_store_v(vsb, va, vb, vg0, vp);
#if F2A_LATE
        // The K rows of the next tile are fetched under the PV product (their VGPRs are dead during the softmax).
        if (more) f2a_load_k(kr, ka, kb, kb0 + F2A_KT, kend, h, ka_tok, ka_head, kb_tok, kb_head, krow0, part);
#else
        if (more) f2a_load_v(va, vb, vv, kb0 + F2A_KT, kend, h, v_tok, v_head, vklo, vg0);
#endif
        F2A_BAR();  // V^T ready; every wave finished its QK (K reads)

        if (wave_live) f2a_pv(st, pf, vsb, l16, hh);
    }
#else
    // ===== two-slot KT32 ring: one barrier per tile =====================================================
    // Slot s holds K[32][F2A_KP] then V^T[128][F2A_VPW]. Iteration t computes on slot t & 1 while the next
    // tile (prefetched into VGPRs during iteration t - 1) is written to the other slot.
    f2a_load_k(kr, ka, kb, 0, kend, h, ka_tok, ka_head, kb_tok, kb_head, krow0, part);
    f2a_load_v(va, vb, vv, 0, kend, h, v_tok, v_head, vklo, vg0);
    f2a_store_k((uint16_t*)f2a_smem, kr, krow0, part);
    f2a_store_v((uint32_t*)(f2a_smem + F2A_KBYTES), va, vb, vg0, vp);
    if (F2A_KT < kend) {
        f2a_load_k(kr, ka, kb, F2A_KT, kend, h, ka_tok, ka_head, kb_tok, kb_head, krow0, part);
        f2a_load_v(va, vb, vv, F2A_KT, kend, h, v_tok, v_head, vklo, vg0);
    }
    F2A_BAR();  // slot 0 ready
    int slot = 0;
    for (int kb0 = 0; kb0 < kend; kb0 += F2A_KT) {
        const int kn = kb0 + F2A_KT;
        if (kn < kend) {
            // The other slot was last read in the previous iteration, retired by its barrier.
            unsigned char* nb = f2a_smem + (slot ^ 1) * F2A_SLOT;
            f2a_store_k((uint16_t*)nb, kr, krow0, part);
            f2a_store_v((uint32_t*)(nb + F2A_KBYTES), va, vb, vg0, vp);
            if (kn + F2A_KT < kend) {
                f2a_load_k(kr, ka, kb, kn + F2A_KT, kend, h, ka_tok, ka_head, kb_tok, kb_head, krow0, part);
                f2a_load_v(va, vb, vv, kn + F2A_KT, kend, h, v_tok, v_head, vklo, vg0);
            }
        }
        if (kb0 <= lim_last) {
            const unsigned char* cb = f2a_smem + slot * F2A_SLOT;
            f2a_s8_t pf[F2A_NKS];
            f2a_softmax(st, pf, (const uint16_t*)cb, qf, kb0, l16, hh, lim_first, lim_i, scale);
            f2a_pv(st, pf, (const uint32_t*)(cb + F2A_KBYTES), l16, hh);
        }
        F2A_BAR();  // next slot written and visible; this slot's reads retired
        slot ^= 1;
    }
#endif

    // ---- epilogue: y = O / l (the incumbent's gfx12 path) -------------------------------------------------------
    const float l_tot = st.l + __shfl_xor(st.l, 16, 32);
    const bool row_ok = row_l < n_rows;
    float* yrow = y + ((size_t)(row_ok ? row_l : 0) * n_heads + h) * F2A_DV;
#pragma unroll
    for (int d = 0; d < 8; ++d) {
        float r[8];
#pragma unroll
        for (int j = 0; j < 8; ++j) {
            float v = (l_tot > 0.0f) ? st.o[d][j] / l_tot : 0.0f;
            if (round_y) v = __uint_as_float(f2a_f32_to_bf16(v) << 16);
            r[j] = v;
        }
        if (row_ok) {
            float4* dst = (float4*)(yrow + d * 16 + 8 * hh);
            dst[0] = make_float4(r[0], r[1], r[2], r[3]);
            dst[1] = make_float4(r[4], r[5], r[6], r[7]);
        }
    }
}
