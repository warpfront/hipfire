 "provenance": {
  "registered": "2026-11-01, before any hipfire baseline exists on this fixture",
  "rule_text": "a_d fails if new < base - max(abs_floor, z*sqrt(var_binom(base,new)), z*sd_rep_base); yield fails if new < base*(1 - max(yield_floor_rel, z*cv_rep_base)); window_ms fails if new > base*(1 + max(window_floor_rel, z*cv_rep_base)); a cell registers only with >= min_reps fresh-process reps and yield cv <= max_cv_register; every depth with reached < min_trials_per_depth is INSUFFICIENT (fails closed); a pass needs every gated cell of every class.",
  "spread_sources": {
   "radiance_b1_T1_512tok": "mgmtp/parity-mtp/radiance/b1-T1-512tok, 3 reps x 6 cells: yield/user cv 0.000-0.116 (code is high: short outputs), step_ms cv 0.003-0.055 (range up to 0.10 on code-C1), per-depth a_d sd across reps 0.000-0.049",
   "hipfire_pp2_sampled_singleton_l2": "r9700x2-par/l2/runs/l2-c1-on{1,2,3}: window-weighted tau sd 0.028-0.113 across 6 categories (range 0.056-0.216), yield cv 0.007-0.028",
   "hipfire_ep2_lanes_fresh_process": "epserve/runs e8-bench-on{1,2,3} and g3-bench-on{1,2}: out tok/s range 0.1-3.2% across fresh servers for C1-C4,C8, one 6.0% outlier (C6, n=2); AR step ms (FLOOR kREF1, n=4/3): range 0.4%",
   "reading": "z=3 against binomial SE covers within-cell sampling noise; floors cover the smallest observed cv; wider cells register wider tolerances from their own reps, so C1 cells are weak detectors and C8 cells (8x the trials) are the sharp ones"
  },
  "throughput_rule": "steady_tok_s fails if below base*(1 - max(steady_floor_rel, z*cv_rep)); ttft_ms_p50 fails if above base*(1 + max(ttft_floor_rel, z*cv_rep)); both are checked only for baselines registered from records that carry them (driver cell summaries), 2026-11-02. Floors from Radiance b1 cv (step ms <= 0.055, so 5% steady; TTFT is dominated by joint prefill of the burst and is noisier, 10%)."
 },
