# Copy to .env to change defaults. Every value below is also the compose default,
# so compose.yml works without a .env file.

# Model tag pulled on first start and served by default (~17.4 GB with its MTP, DFlash
# and vision sidecars; fits a 32 GB card or Strix Halo).
# Strix Halo flagship alternative: qwen3.8:flash-next (~125 GB).
HIPFIRE_MODEL=qwen3.8:27b-mq4-xts

# Host port for the API (the container always listens on 11435).
HIPFIRE_PORT=11435

# Host address the API (and the monitoring ports) bind to.
# 0.0.0.0 exposes the API to the network with no TLS: set an API key first with
# HIPFIRE_SERVE_ARGS=--api-key-file /path/in/container and mount that file into the container.
HIPFIRE_BIND=127.0.0.1

# 1 serves the web UI at /ui.
HIPFIRE_UI=0

# Extra arguments appended to `hipfire serve`.
HIPFIRE_SERVE_ARGS=

# Models location: a named volume, or an absolute host path (e.g. /home/you/.hipfire/models)
# to reuse models you already downloaded.
HIPFIRE_MODELS_PATH=hipfire-models

# Image to run, and the Containerfile stage to build if it is not pulled.
# full (default) carries hipcc, so a route whose kernel is not in the baked packs compiles once
# into the kernel cache. runtime is the slim image without a compiler: such a route fails instead.
HIPFIRE_IMAGE=ghcr.io/warpfront/hipfire:latest
HIPFIRE_IMAGE_TARGET=full

# Hugging Face token for gated or rate-limited model downloads (optional).
# HF_TOKEN=

# Strix Halo: add the NPU device and memlock limit (see compose.halo.yml).
# COMPOSE_FILE=compose.yml:compose.halo.yml

# Monitoring profile (docker compose --profile monitoring up -d).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Change this before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=admin
