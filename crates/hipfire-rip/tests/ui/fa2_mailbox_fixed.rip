region VBody;
region Mailbox;
region VPlane;
// Standalone RIP safety fixture, assembled only if the sealed driver accepts it.
fn emit(spec: Spec) -> Result<Emitted, String> {
    let kspec = KernelSpec {
        kernel_id: "rip_negative".into(), variant: "negative".into(),
        arch: spec.arch, symbol: "rip_negative".into(),
        kernargs: KernargLayout::new(0), user_sgpr_count: 2,
        system_sgpr_workgroup_id_y: false, workgroup_size: 32,
        group_segment_fixed_size: 32768, wave32: true, cu_mode: false,
    };
    let mut p = RegPlan::new(256, 104)?;
    for i in 0..4 { p.v::<8>("vectors", 8 * i, Live::Whole)?; }
    p.s::<8>("scalars", 0, Live::Whole)?;
    let mut b = Builder::new(kspec, p);
    let mut wg = Workgroup::new(&mut b, spec.arch)?;
    let v_body = wg.lds::<VBody>("V", 16384, 16376)?;
    let mbox = wg.lds::<Mailbox>("mailbox", 32760, 8)?;
    let (mbox, st) = wg.ds_store(mbox, Instruction::new("ds_store_2addr_b32 v0, v1, v2 offset1:1", vec![], vec![v(0),v(1),v(2)]).memory(MemoryClass::DsStore))?;
    let drained = wg.wait(st)?;
    let (mbox,) = wg.barrier((ready(mbox, drained),))?;
    wg.ds_load(&mbox, Instruction::new("ds_load_2addr_b32 v[3:4], v0 offset1:1", vec![vr(3,2)], vec![v(0)]).memory(MemoryClass::DsLoad))?;
    let (mbox,) = wg.barrier((retire(mbox),))?;
    let v_plane = join::<VPlane, _, _>(v_body, mbox)?;
    let (_v, st) = wg.ds_store(v_plane, Instruction::new("ds_store_b128 v5, v[8:11]", vec![], vec![v(5),vr(8,4)]).memory(MemoryClass::DsStore))?;
    let _ = wg.wait(st)?;
    let end = wg.exit(".Lend")?;
    wg.end(end)?;
    b.finish()
}
