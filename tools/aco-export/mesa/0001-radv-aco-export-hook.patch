diff --git a/src/amd/vulkan/radv_aco_export.inc b/src/amd/vulkan/radv_aco_export.inc
new file mode 100644
index 0000000..8308e6f
--- /dev/null
+++ b/src/amd/vulkan/radv_aco_export.inc
@@ -0,0 +1,396 @@
+/*
+ * hipfire offline developer export hook for the pinned RADV (NOT part of upstream Mesa).
+ *
+ * Included textually by radv_shader.c immediately before radv_aco_build_shader_binary() so that it
+ * can call RADV's own static helpers (radv_precompute_registers) and see the exact structures the
+ * driver itself feeds to the GPU.  It captures, for a COMPUTE shader compiled through the real
+ * SPIR-V -> NIR -> radv_postprocess_nir -> aco_compile_shader pipeline:
+ *   - the raw ACO output code words (exec_size / code_size) written byte-for-byte to shader.bin,
+ *   - the aco_callback arguments (pre-postprocess config, aco symbols, ACO's own disasm string),
+ *   - the post-radv_postprocess_binary_config config (RSRC1/2/3, float mode, LDS, scratch, regs),
+ *   - the complete ac_shader_args / radv_shader_args arg table (file/offset/size/type) with the
+ *     field name of every slot, user_sgprs_locs, inline push constant dword mask,
+ *   - radv_shader_info compute fields, aco options/info, physical device identity,
+ *   - RADV's own precomputed compute registers (via radv_precompute_registers on a shader copy),
+ *   - the final NIR text.
+ * Active only when RADV_ACO_EXPORT_DIR is set.  64-bit values are written as 16-hex-digit strings
+ * so that no JSON consumer can truncate them.
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+struct radv_aco_export_stash {
+   bool valid;
+   struct ac_shader_config config;
+   uint32_t exec_size;
+   uint32_t code_dw;
+   uint32_t *code;
+   struct aco_symbol *symbols;
+   unsigned num_symbols;
+   char *disasm;
+   unsigned disasm_size;
+};
+
+static __thread struct radv_aco_export_stash radv_aco_export_stash_tls;
+static unsigned radv_aco_export_counter;
+
+static const char *
+radv_aco_export_dir(void)
+{
+   const char *dir = getenv("RADV_ACO_EXPORT_DIR");
+   return (dir && dir[0]) ? dir : NULL;
+}
+
+static void
+radv_aco_export_stash_clear(void)
+{
+   struct radv_aco_export_stash *s = &radv_aco_export_stash_tls;
+   free(s->code);
+   free(s->symbols);
+   free(s->disasm);
+   memset(s, 0, sizeof(*s));
+}
+
+/* Called from the aco_callback with the exact callback arguments. */
+static void
+radv_aco_export_stash_callback(const struct ac_shader_config *config, const char *disasm_str, unsigned disasm_size,
+                               uint32_t exec_size, const uint32_t *code, uint32_t code_dw,
+                               const struct aco_symbol *symbols, unsigned num_symbols)
+{
+   if (!radv_aco_export_dir())
+      return;
+   radv_aco_export_stash_clear();
+   struct radv_aco_export_stash *s = &radv_aco_export_stash_tls;
+   s->config = *config;
+   s->exec_size = exec_size;
+   s->code_dw = code_dw;
+   s->code = malloc((size_t)code_dw * 4);
+   memcpy(s->code, code, (size_t)code_dw * 4);
+   s->num_symbols = num_symbols;
+   if (num_symbols) {
+      s->symbols = malloc(sizeof(*symbols) * num_symbols);
+      memcpy(s->symbols, symbols, sizeof(*symbols) * num_symbols);
+   }
+   s->disasm_size = disasm_size;
+   if (disasm_size) {
+      s->disasm = malloc(disasm_size);
+      memcpy(s->disasm, disasm_str, disasm_size);
+   }
+   s->valid = true;
+}
+
+static void
+radv_aco_export_json_str(FILE *f, const char *s)
+{
+   fputc('"', f);
+   for (; s && *s; s++) {
+      unsigned char c = (unsigned char)*s;
+      if (c == '"' || c == '\\')
+         fprintf(f, "\\%c", c);
+      else if (c < 0x20)
+         fprintf(f, "\\u%04x", c);
+      else
+         fputc(c, f);
+   }
+   fputc('"', f);
+}
+
+static void
+radv_aco_export_config_json(FILE *f, const struct ac_shader_config *c)
+{
+   fprintf(f,
+           "{\"num_sgprs\":%u,\"num_vgprs\":%u,\"num_shared_vgprs\":%u,\"spilled_sgprs\":%u,"
+           "\"spilled_vgprs\":%u,\"lds_size\":%u,\"spi_ps_input_ena\":%u,\"spi_ps_input_addr\":%u,"
+           "\"float_mode\":%u,\"scratch_bytes_per_wave\":%u,\"wgp_mode\":%s,\"rsrc1\":%u,\"rsrc2\":%u,"
+           "\"rsrc3\":%u}",
+           c->num_sgprs, c->num_vgprs, c->num_shared_vgprs, c->spilled_sgprs, c->spilled_vgprs, c->lds_size,
+           c->spi_ps_input_ena, c->spi_ps_input_addr, c->float_mode, c->scratch_bytes_per_wave,
+           c->wgp_mode ? "true" : "false", c->rsrc1, c->rsrc2, c->rsrc3);
+}
+
+struct radv_aco_export_name {
+   const char *name;
+   int index; /* position inside an array field, or -1 */
+   struct ac_arg arg;
+};
+
+#define RADV_ACO_EXPORT_MAX_NAMES (AC_MAX_ARGS * 2)
+
+static unsigned
+radv_aco_export_collect_names(const struct radv_shader_args *a, enum amd_gfx_level gfx_level,
+                              struct radv_aco_export_name *out)
+{
+   unsigned n = 0;
+#define ONE(field)                                                                                                     \
+   do {                                                                                                                \
+      if (a->field.used)                                                                                               \
+         out[n++] = (struct radv_aco_export_name){#field, -1, a->field};                                               \
+   } while (0)
+#define ARR(field, count)                                                                                              \
+   do {                                                                                                                \
+      for (unsigned i_ = 0; i_ < (count); i_++)                                                                        \
+         if (a->field[i_].used)                                                                                        \
+            out[n++] = (struct radv_aco_export_name){#field, (int)i_, a->field[i_]};                                   \
+   } while (0)
+   ONE(ac.ring_offsets);
+   ARR(descriptors, MAX_SETS);
+   ONE(ac.push_constants);
+   ONE(ac.dynamic_descriptors);
+   for (unsigned i = 0; i < AC_MAX_INLINE_PUSH_CONSTS; i++)
+      if (a->ac.inline_push_consts[i].used)
+         out[n++] = (struct radv_aco_export_name){"ac.inline_push_consts", (int)i, a->ac.inline_push_consts[i]};
+   ONE(ac.num_work_groups);
+   /* GFX12 declares workgroup_ids[i].used = true without allocating an SGPR slot
+    * (radv_shader_args.c: "if (gfx_level >= GFX12) args->ac.workgroup_ids[i].used = true"). Their
+    * arg_index is meaningless and must not be mapped to a slot. */
+   if (gfx_level < GFX12)
+      ARR(ac.workgroup_ids, 3);
+   ONE(ac.tg_size);
+   ONE(ac.scratch_offset);
+   ONE(ac.local_invocation_ids_packed);
+   ONE(ac.local_invocation_id_x);
+   ONE(ac.local_invocation_id_y);
+   ONE(ac.local_invocation_id_z);
+   ONE(ac.draw_id);
+   ONE(ac.task_ring_entry);
+   ONE(ac.view_index);
+#undef ONE
+#undef ARR
+   return n;
+}
+
+static void
+radv_aco_export_args_json(FILE *f, const struct radv_shader_args *a, enum amd_gfx_level gfx_level)
+{
+   struct radv_aco_export_name *names = calloc(RADV_ACO_EXPORT_MAX_NAMES, sizeof(*names));
+   unsigned num_names = radv_aco_export_collect_names(a, gfx_level, names);
+   const struct ac_shader_args *ac = &a->ac;
+
+   fprintf(f, "{\"arg_count\":%u,\"num_sgprs_used\":%u,\"num_vgprs_used\":%u,\"num_user_sgprs\":%u,",
+           ac->arg_count, ac->num_sgprs_used, ac->num_vgprs_used, a->num_user_sgprs);
+   fprintf(f, "\"load_grid_size_from_user_sgpr\":%s,\"explicit_scratch_args\":%s,",
+           a->load_grid_size_from_user_sgpr ? "true" : "false", a->explicit_scratch_args ? "true" : "false");
+   fprintf(f, "\"inline_push_const_mask\":\"%016" PRIx64 "\",", ac->inline_push_const_mask);
+
+   fprintf(f, "\"args\":[");
+   for (unsigned i = 0; i < ac->arg_count; i++) {
+      const char *name = NULL;
+      int index = -1;
+      unsigned matches = 0;
+      for (unsigned j = 0; j < num_names; j++) {
+         if (names[j].arg.arg_index == i) {
+            if (!matches) {
+               name = names[j].name;
+               index = names[j].index;
+            }
+            matches++;
+         }
+      }
+      fprintf(f, "%s{\"slot\":%u,\"file\":\"%s\",\"offset\":%u,\"size\":%u,\"type\":\"%s\",\"skip\":%s,"
+                 "\"pending_vmem\":%s,\"preserved\":%s,\"field\":",
+              i ? "," : "", i, ac->args[i].file == AC_ARG_SGPR ? "sgpr" : "vgpr", ac->args[i].offset,
+              ac->args[i].size, ac->args[i].type == AC_ARG_CONST_ADDR ? "const_addr" : "value",
+              ac->args[i].skip ? "true" : "false", ac->args[i].pending_vmem ? "true" : "false",
+              ac->args[i].preserved ? "true" : "false");
+      if (name)
+         radv_aco_export_json_str(f, name);
+      else
+         fputs("null", f);
+      fprintf(f, ",\"field_index\":%d,\"field_alias_count\":%u}", index, matches);
+   }
+   fprintf(f, "],");
+
+   fprintf(f, "\"gfx12_implicit_workgroup_ids\":[%s,%s,%s],", ac->workgroup_ids[0].used && gfx_level >= GFX12 ? "true" : "false",
+           ac->workgroup_ids[1].used && gfx_level >= GFX12 ? "true" : "false",
+           ac->workgroup_ids[2].used && gfx_level >= GFX12 ? "true" : "false");
+
+   fprintf(f, "\"user_sgprs_locs\":{\"descriptor_sets_enabled\":%u,\"descriptor_sets\":[", a->user_sgprs_locs.descriptor_sets_enabled);
+   for (unsigned i = 0; i < MAX_SETS; i++)
+      fprintf(f, "%s{\"sgpr_idx\":%d,\"num_sgprs\":%u}", i ? "," : "", a->user_sgprs_locs.descriptor_sets[i].sgpr_idx,
+              a->user_sgprs_locs.descriptor_sets[i].num_sgprs);
+   fprintf(f, "],\"shader_data\":[");
+   for (unsigned i = 0; i < AC_UD_MAX_UD; i++)
+      fprintf(f, "%s{\"ud\":%u,\"sgpr_idx\":%d,\"num_sgprs\":%u}", i ? "," : "", i,
+              a->user_sgprs_locs.shader_data[i].sgpr_idx, a->user_sgprs_locs.shader_data[i].num_sgprs);
+   fprintf(f, "]}}");
+   free(names);
+}
+
+static const char *
+radv_aco_export_symbol_name(enum aco_symbol_id id)
+{
+   switch (id) {
+   case aco_symbol_invalid: return "invalid";
+   case aco_symbol_scratch_addr_lo: return "scratch_addr_lo";
+   case aco_symbol_scratch_addr_hi: return "scratch_addr_hi";
+   case aco_symbol_const_data_addr: return "const_data_addr";
+   }
+   return "unknown";
+}
+
+static void
+radv_aco_export_write_file(const char *dir, const char *name, const void *data, size_t size)
+{
+   char path[4096];
+   snprintf(path, sizeof(path), "%s/%s", dir, name);
+   FILE *f = fopen(path, "wb");
+   if (!f) {
+      fprintf(stderr, "radv_aco_export: cannot write %s: %s\n", path, strerror(errno));
+      abort();
+   }
+   if (size && fwrite(data, 1, size, f) != size) {
+      fprintf(stderr, "radv_aco_export: short write %s\n", path);
+      abort();
+   }
+   fclose(f);
+}
+
+static void
+radv_aco_export_emit(struct radv_device *device, const struct radv_shader_binary *binary,
+                     struct nir_shader *const *shaders, int shader_count, const struct radv_shader_args *args,
+                     const struct aco_compiler_options *ac_opts, const struct aco_shader_info *ac_info,
+                     const struct radv_shader_stage_key *stage_key, const struct radv_nir_compiler_options *options)
+{
+   const char *root = radv_aco_export_dir();
+   struct radv_aco_export_stash *s = &radv_aco_export_stash_tls;
+   /* RADV-internal (meta/helper) compute shaders are not application shaders: never exported. */
+   if (!root || !s->valid || shader_count != 1 || shaders[0]->info.stage != MESA_SHADER_COMPUTE ||
+       shaders[0]->info.internal) {
+      radv_aco_export_stash_clear();
+      return;
+   }
+
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   const struct radeon_info *ri = &pdev->info;
+   const struct radv_shader_info *info = &binary->info;
+
+   char dir[4096];
+   unsigned n = p_atomic_inc_return(&radv_aco_export_counter) - 1;
+   snprintf(dir, sizeof(dir), "%s/compute-%u", root, n);
+   if (mkdir(root, 0777) && errno != EEXIST) {
+      fprintf(stderr, "radv_aco_export: mkdir %s: %s\n", root, strerror(errno));
+      abort();
+   }
+   if (mkdir(dir, 0777) && errno != EEXIST) {
+      fprintf(stderr, "radv_aco_export: mkdir %s: %s\n", dir, strerror(errno));
+      abort();
+   }
+
+   /* RADV's own precomputed registers, computed by the driver function on a copy. */
+   struct radv_shader *tmp = calloc(1, sizeof(*tmp));
+   tmp->info = *info;
+   tmp->config = binary->config;
+   radv_precompute_registers(device, tmp);
+
+   radv_aco_export_write_file(dir, "shader.bin", s->code, (size_t)s->code_dw * 4);
+   radv_aco_export_write_file(dir, "aco.disasm.txt", s->disasm ? s->disasm : "", s->disasm_size ? s->disasm_size - 1 : 0);
+
+   {
+      char *nir_text = NULL;
+      size_t nir_size = 0;
+      struct u_memstream mem;
