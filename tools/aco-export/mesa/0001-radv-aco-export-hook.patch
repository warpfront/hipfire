    select_program(program.get(), shader_count, shaders, &config, options, info, args);
 
    std::string llvm_ir = aco_postprocess_shader(options, program);
+   export_measure_typed_regs(program.get());
 
    /* assembly */
    std::vector<uint32_t> code;
