+/* hipfire offline export: measure register use from the final typed post-RA instructions (every fixed
+ * Operand / Definition PhysReg range), after all ACO passes and before assembly. Ordinary SGPRs are
+ * s0..s105; s106/s107 are VCC; everything else (>=108) is a special register (TTMP, M0, EXEC, ...). */
+static void
+export_measure_typed_regs(Program* program)
+{
+   unsigned ord = 0, vgpr = 0, vcc = 0, other_special = 0;
+   uint32_t reads[4] = {0, 0, 0, 0}, defs[4] = {0, 0, 0, 0};
+   auto account = [&](PhysReg r, unsigned dwords, uint32_t* mask) {
+      for (unsigned i = r.reg(); i < r.reg() + dwords; i++) {
+         if (i >= 256) {
+            vgpr = std::max(vgpr, i - 256 + 1);
+         } else if (i < 106) {
+            ord = std::max(ord, i + 1);
+            mask[i / 32] |= 1u << (i % 32);
+         } else if (i < 108) {
+            vcc = 1;
+         } else {
+            other_special = 1;
+         }
+      }
+   };
+   for (Block& block : program->blocks) {
+      for (aco_ptr<Instruction>& instr : block.instructions) {
+         for (Operand& op : instr->operands) {
+            if (op.isConstant() || op.isUndefined() || !op.isFixed())
+               continue;
+            account(op.physReg(), op.size(), reads);
+         }
+         for (Definition& def : instr->definitions) {
+            if (!def.isFixed())
+               continue;
+            account(def.physReg(), def.size(), defs);
+         }
+      }
+   }
+
+   /* Typed entry liveness over the linear CFG: an ordinary SGPR is live-in at the entry iff some path reads it
+    * before every write. p_startpgm is skipped (it only names the entry values); conditional-move style
+    * SALU defs (name contains "cmov") do not kill. */
+   const unsigned nblocks = program->blocks.size();
+   std::vector<std::array<uint32_t, 4>> use_b(nblocks, {0, 0, 0, 0}), def_b(nblocks, {0, 0, 0, 0}),
+      live_in(nblocks, {0, 0, 0, 0});
+   auto touch = [](PhysReg r, unsigned dwords, uint32_t* mask) {
+      for (unsigned i = r.reg(); i < r.reg() + dwords && i < 106; i++)
+         mask[i / 32] |= 1u << (i % 32);
+   };
+   for (Block& block : program->blocks) {
+      const unsigned b = block.index;
+      for (aco_ptr<Instruction>& instr : block.instructions) {
+         if (instr->opcode == aco_opcode::p_startpgm)
+            continue;
+         const bool conditional = strstr(instr_info.name[(int)instr->opcode], "cmov") != NULL;
+         for (Operand& op : instr->operands) {
+            if (op.isConstant() || op.isUndefined() || !op.isFixed())
+               continue;
+            uint32_t m[4] = {0, 0, 0, 0};
+            touch(op.physReg(), op.size(), m);
+            for (unsigned w = 0; w < 4; w++)
+               use_b[b][w] |= m[w] & ~def_b[b][w];
+         }
+         if (conditional)
+            continue;
+         for (Definition& def : instr->definitions) {
+            if (!def.isFixed())
+               continue;
+            touch(def.physReg(), def.size(), def_b[b].data());
+         }
+      }
+   }
+   for (bool changed = true; changed;) {
+      changed = false;
+      for (unsigned bi = nblocks; bi-- > 0;) {
+         std::array<uint32_t, 4> out = {0, 0, 0, 0};
+         for (unsigned s : program->blocks[bi].linear_succs)
+            for (unsigned w = 0; w < 4; w++)
+               out[w] |= live_in[s][w];
+         for (unsigned w = 0; w < 4; w++) {
+            const uint32_t in = use_b[bi][w] | (out[w] & ~def_b[bi][w]);
+            if (in != live_in[bi][w]) {
+               live_in[bi][w] = in;
+               changed = true;
+            }
+         }
+      }
+   }
+   uint32_t entry_live[4] = {0, 0, 0, 0};
+   if (nblocks)
+      for (unsigned w = 0; w < 4; w++)
+         entry_live[w] = live_in[0][w];
+   aco_export_typed_ordinary_sgprs = ord;
+   aco_export_typed_vgprs = vgpr;
+   aco_export_typed_vcc = vcc;
+   aco_export_typed_other_special = other_special;
+   for (unsigned i = 0; i < 4; i++) {
+      aco_export_typed_sgpr_read_mask[i] = reads[i];
+      aco_export_typed_sgpr_def_mask[i] = defs[i];
+      aco_export_typed_entry_live_mask[i] = entry_live[i];
+   }
+}
+
 } /* end namespace */
 
