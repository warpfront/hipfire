+        HBFLY8(0x041F, 1);
+        HBFLY8(0x081F, 2);
+        HBFLY8(0x101F, 4);
+        HBFLY8(0x201F, 8);
+        HBFLY8(0x401F, 16);
+        #undef HBFLY8
+        #undef HBFLY
+
+        const float s = 0.0625f;
+        float4 out0, out1;
+        out0.x = v0 * s * s20.x;
+        out0.y = v1 * s * s20.y;
+        out0.z = v2 * s * s20.z;
+        out0.w = v3 * s * s20.w;
+        out1.x = v4 * s * s21.x;
+        out1.y = v5 * s * s21.y;
+        out1.z = v6 * s * s21.z;
+        out1.w = v7 * s * s21.w;
+        *reinterpret_cast<float4*>(x_rot_b + base) = out0;
+        *reinterpret_cast<float4*>(x_rot_b + base + 4) = out1;
+    }
+}

