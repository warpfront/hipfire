            if(row_lane_id >= 2)
                output = scan_op(t, output);
        }
        if(VirtualWaveSize > 4)
        {
            T t = warp_move_dpp<T, 0x114>(output); // row_shr:4
            if(row_lane_id >= 4)
                output = scan_op(t, output);
        }
        if(VirtualWaveSize > 8)
        {
