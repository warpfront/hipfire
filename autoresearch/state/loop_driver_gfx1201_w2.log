         }
-        {
-            LOAD_X8(base0 + 512);
-            DOG_X8(gate_ptr + (g + 2) * 136, a2.x);
-            DOG_X8(up_ptr + (g + 2) * 136, a2.y);
+    }
+
+    // Requant FP32 → Q8 — OUTSIDE the token loop.
+    // Only the final state is quantized (intermediate tokens stay FP32 in LDS).
+#if defined(__gfx1200__) || defined(__gfx1201__)
+    // Production decode carries the error-feedback buffer. Keep that path as
+    // the gfx12 fallthrough so the cold stochastic-rounding body does not
+    // disrupt the requant hot path; all arithmetic and memory operations are
+    // otherwise unchanged.
+    const bool use_ef = __builtin_expect(s_ef_residual != nullptr, 1);
+#else
+    const bool use_ef = (s_ef_residual != nullptr);
+#endif
+    for (int r = 0; r < TILE_ROWS; r++) {
