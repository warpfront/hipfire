+// lookahead, this adds no values live across the reduction barrier.
 
 __launch_bounds__(256, 1)
 extern "C" __global__ void fused_rmsnorm_mq_rotate(
@@ -48,6 +54,15 @@
     // Phase 1a: accumulate sum-of-squares (same stride/order as baseline).
     float local_sum = 0.0f;
     for (int i = tid; i < K; i += block_size) {
+#if defined(__gfx1200__) || defined(__gfx1201__)
+        // Four 256-byte cacheline leaders cover the future 256-float slab.
+        // The hint is gfx12-only; every other arch compiles the original
+        // loop byte-identically.
+        if ((tid & 63) == 0 && i + (block_size << 1) < K) {
+            __builtin_amdgcn_s_prefetch_data(
+                (const void*)(x_b + i + (block_size << 1)), 0);
+        }
+#endif
         float v = x_b[i];
         local_sum += v * v;
     }

