+    // One flag beyond the eight warp partials. The first barrier below
+    // publishes both the flag initialization and all warp sums.
+    volatile int* rms_ready = reinterpret_cast<volatile int*>(reduce + 8);
+    if (tid == 0) *rms_ready = 0;
+#endif
