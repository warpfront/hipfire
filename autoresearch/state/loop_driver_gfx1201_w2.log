-        const int base0 = g * 256 + tid * 8;
+            float kv = s0*k0 + s1*k1 + s2*k2 + s3*k3;
+            for (int o = 16; o > 0; o >>= 1)
+                kv += __shfl_down(kv, o);
+            kv = __shfl(kv, 0);
+
+            const float v_row =
