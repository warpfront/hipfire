diff --git a/exp_R4c3_work.hip b/exp_R4c3_work.hip
index 87da980e4c4be95048f51ee0e71271add05288af..464441f6751440916715b6c8f60311ea6a7cfb80
--- a/exp_R4c3_work.hip
+++ b/exp_R4c3_work.hip
@@ -16,6 +16,16 @@
 // multi-issue is on the critical path of the per-row state machine under
 // low-occ decode (n_tokens=1); packing raises effective LDS bandwidth
 // without raising VGPR (still 4 live floats, just as a vector).
+//
+// VARIANT R4c3 gdn_q8_packed_transpose (gfx12 only):
+// The Q8 state reload below issues four strided byte loads per lane.  Across
+// the wave those are four contiguous 32-byte planes from the same 128-byte
+// row.  Load the row once as 32 packed dwords, then transpose its four byte
+// planes with shuffles.  This keeps the exact signed-byte -> float -> scale
+// math while trading three VMEM instructions for four wave shuffles.  The
+// measured gfx1201 shape is L2-resident but low-occupancy/mixed-memory, so
+// VMEM issue latency rather than DRAM bandwidth is the mechanism under test.
+// Keep every other architecture on the byte-identical source path.
 
 #include <hip/hip_runtime.h>
 #include <hip/hip_fp16.h>
@@ -54,11 +64,31 @@
     for (int r = 0; r < TILE_ROWS; r++) {
         const float scale = s_scales[h * HD + row_start + r];
         const signed char* src = sq_base + r * HD;
+#if defined(__gfx1200__) || defined(__gfx1201__)
+        const unsigned int packed =
+            *reinterpret_cast<const unsigned int*>(src + tid * 4);
+        const int byte_shift = (tid & 3) * 8;
+        const int packed_lane = tid >> 2;
+        const signed char q0 = (signed char)
+            ((__shfl(packed, packed_lane) >> byte_shift) & 0xffu);
+        const signed char q1 = (signed char)
+            ((__shfl(packed, packed_lane + 8) >> byte_shift) & 0xffu);
+        const signed char q2 = (signed char)
+            ((__shfl(packed, packed_lane + 16) >> byte_shift) & 0xffu);
+        const signed char q3 = (signed char)
+            ((__shfl(packed, packed_lane + 24) >> byte_shift) & 0xffu);
         S_f4[r * 32 + tid] = make_float4(
+            scale * (float)q0,
+            scale * (float)q1,
+            scale * (float)q2,
+            scale * (float)q3);
+#else
+        S_f4[r * 32 + tid] = make_float4(
             scale * (float)src[tid],
             scale * (float)src[tid + 32],
             scale * (float)src[tid + 64],
             scale * (float)src[tid + 96]);
+#endif
     }
 
     for (int t = 0; t < n_tokens; t++) {

