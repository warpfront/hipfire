    15	//     guarantees expert_offsets aligned to BLOCK_M = 16).
    16	//   - Each lane m_lane = tid & 15 corresponds to one slot AND one M-row.
    17	//   - X is gathered via sorted_slot_index[slot_start + m_lane]; -1
    18	//     padding lanes substitute zero rows for the B operand.
    19	//
    20	// Grid: [ceil(M/16), m_total/16]. Block: [32]. LDS: 0.
    21	
    22	typedef _Float16 __attribute__((ext_vector_type(8))) half8_t;
    23	typedef float    __attribute__((ext_vector_type(8))) float8_t;
    24	
    25	// `x_row_div` controls how sorted_slot_index maps to X_src rows:
    26	//   gate_up: X_src = x_rot_batch[N × K], x_row_div = K_TOP → x_row = flat / K_TOP
    27	//   down:    X_src = rot_batch[total_slots × K], x_row_div = 1 → x_row = flat
    28	__launch_bounds__(32, 2)
    29	extern "C" __global__ void gemm_hfq4g256_moe_grouped_wmma_gfx12(
    30	    const unsigned long long* __restrict__ expert_weight_ptrs, // [E]
    31	    const int*                __restrict__ expert_tile_ids,    // [m_total / 16]
    32	    const int*                __restrict__ sorted_slot_index,  // [m_total]
    33	    const _Float16*           __restrict__ X_src,              // [n_rows × K]
    34	    float*                    __restrict__ Y_grouped,          // [m_total × M]
    35	    int M, int K, int x_row_div, int m_total
    36	) {
    37	    const int tid = threadIdx.x;
    38	    const int row_start = blockIdx.x * 16;
    39	    const int tile_y = blockIdx.y;
    40	    const int slot_start = tile_y * 16;
    41	
    42	    if (row_start >= M || slot_start >= m_total) return;
    43	
    44	    // Sentinel early-return: expert_tile_ids[tile_y] == -1 marks tiles
    45	    // beyond the live m_total (the dispatcher may launch up to
    46	    // m_total_max/16 tiles to skip the m_total dtoh sync, since the
    47	    // scatter pre-fills the upper-bound range with -1).
    48	    const int expert_id = expert_tile_ids[tile_y];
    49	    if (expert_id < 0) return;
    50	
    51	    const int m_lane = tid & 15;
    52	    const int k_grp  = tid >> 4;
    53	
    54	    const char* __restrict__ A = reinterpret_cast<const char*>(expert_weight_ptrs[expert_id]);
    55	
    56	    // X gather (per m_lane; both k_grp lanes for the same m_lane read the
    57	    // same source row). -1 padding lanes contribute a zero B row.
    58	    const int slot_idx = slot_start + m_lane;
    59	    int x_row = -1;
    60	    if (slot_idx < m_total) {
    61	        const int flat = sorted_slot_index[slot_idx];
    62	        if (flat >= 0) {
    63	            x_row = (x_row_div > 1) ? (flat / x_row_div) : flat;
    64	        }
    65	    }
    66	    const _Float16* x_base = (x_row >= 0) ? (X_src + (long long)x_row * K) : (const _Float16*)nullptr;
    67	
    68	    // A-row selection: pad OOB lanes to the last valid M-row (gfx11 trick
    69	    // — the masked output write below discards the result anyway).
    70	    const int safe_row = (row_start + m_lane < M) ? (row_start + m_lane) : (M - 1);
    71	    const int groups_per_row = K / 256;
    72	    const char* row_base = A + (long long)safe_row * groups_per_row * 136;
    73	
    74	    float8_t acc = {0, 0, 0, 0, 0, 0, 0, 0};
    75	
    76	    const half8_t zero_b = {0, 0, 0, 0, 0, 0, 0, 0};
    77	
    78	    for (int g = 0; g < groups_per_row; g++) {
    79	        const char* gp = row_base + g * 136;
    80	        // k_grp 0/1 share the same A-row header for a given m_lane. Load sc/zp
    81	        // once on k_grp==0 and broadcast via shfl — halves redundant header
    82	        // traffic on a mem-busy kernel (value-identical to dual loads).
    83	        unsigned int sc_bits = 0u, zp_bits = 0u;
    84	        if (k_grp == 0) {
    85	            sc_bits = *(const unsigned int*)(gp);
    86	            zp_bits = *(const unsigned int*)(gp + 4);
    87	        }
    88	        sc_bits = __shfl(sc_bits, m_lane);
    89	        zp_bits = __shfl(zp_bits, m_lane);
    90	        _Float16 sc_h = (_Float16)__builtin_bit_cast(float, sc_bits);
    91	        _Float16 zp_h = (_Float16)__builtin_bit_cast(float, zp_bits);
    92	        const _Float16* xg = (x_base != nullptr) ? (x_base + g * 256) : nullptr;
    93	
    94	        #define DQ8(pk) \
    95	            a_reg[0] = sc_h * (_Float16)(float)(((pk) >>  0) & 0xFu) + zp_h; \
    96	            a_reg[1] = sc_h * (_Float16)(float)(((pk) >>  4) & 0xFu) + zp_h; \
    97	            a_reg[2] = sc_h * (_Float16)(float)(((pk) >>  8) & 0xFu) + zp_h; \
    98	            a_reg[3] = sc_h * (_Float16)(float)(((pk) >> 12) & 0xFu) + zp_h; \
    99	            a_reg[4] = sc_h * (_Float16)(float)(((pk) >> 16) & 0xFu) + zp_h; \
   100	            a_reg[5] = sc_h * (_Float16)(float)(((pk) >> 20) & 0xFu) + zp_h; \
   101	            a_reg[6] = sc_h * (_Float16)(float)(((pk) >> 24) & 0xFu) + zp_h; \
   102	            a_reg[7] = sc_h * (_Float16)(float)(((pk) >> 28) & 0xFu) + zp_h
   103	
   104	        for (int kt = 0; kt < 16; kt += 4) {
   105	            const int k_off_a = (kt + 0) * 16;
   106	            const int k_off_b = (kt + 1) * 16;
   107	            const int k_off_c = (kt + 2) * 16;
   108	            const int k_off_d = (kt + 3) * 16;
   109	
   110	            unsigned int pka = *(const unsigned int*)(gp + 8 + k_off_a / 2 + k_grp * 4);
   111	            unsigned int pkb = *(const unsigned int*)(gp + 8 + k_off_b / 2 + k_grp * 4);
   112	            unsigned int pkc = *(const unsigned int*)(gp + 8 + k_off_c / 2 + k_grp * 4);
   113	            unsigned int pkd = *(const unsigned int*)(gp + 8 + k_off_d / 2 + k_grp * 4);
   114	
   115	            half8_t b_a, b_b, b_c, b_d;
   116	            if (xg != nullptr) {
   117	                b_a = *(const half8_t*)(xg + k_off_a + k_grp * 8);
   118	                b_b = *(const half8_t*)(xg + k_off_b + k_grp * 8);
   119	                b_c = *(const half8_t*)(xg + k_off_c + k_grp * 8);
   120	                b_d = *(const half8_t*)(xg + k_off_d + k_grp * 8);
   121	            } else {
   122	                b_a = zero_b; b_b = zero_b; b_c = zero_b; b_d = zero_b;
   123	            }
   124	
   125	            half8_t a_reg;
   126	            DQ8(pka);
   127	            acc = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(a_reg, b_a, acc);
   128	            DQ8(pkb);
   129	            acc = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(a_reg, b_b, acc);
   130	            DQ8(pkc);
   131	            acc = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(a_reg, b_c, acc);
   132	            DQ8(pkd);
   133	            acc = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(a_reg, b_d, acc);
   134	        }
   135	        #undef DQ8
   136	    }
   137	
   138	    // gfx12 wave32 WMMA C-mapping: acc[j] = C[8*k_grp + j][m_lane].
   139	    // Use direct store (=) since Y_grouped is fresh per call.
   140	    const int out_col = slot_start + m_lane;
