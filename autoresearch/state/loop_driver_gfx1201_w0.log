/bin/bash -lc "printf '%s\\n' '--- case-studies.md 401-568 ---'; sed -n '401,568p' /home/kaden/hipfire-loop/.aw/sw_card1/.agents/skills/hipfire-kernel-tuning/case-studies.md" in /home/kaden/hipfire-loop/.aw/sw_card1
