+        zp_bits = __shfl(zp_bits, 0); \
+        float sc = __builtin_bit_cast(float, sc_bits); \
+        float zp = __builtin_bit_cast(float, zp_bits); \
+        unsigned int pk = *(const unsigned int*)((gp) + 8 + boff); \
