   120	        const float ssc = row_scale_f * cvt_e4m3_scale_to_f32(*(const unsigned char*)gp) * 0.88f;
   121	        const unsigned int ew = *(const unsigned int*)(gp + 1 + cw_off);
   122	        const int base = g * 256 + tid * 8;
   123	        float pe[8];
   124	        e8_decode_index(ew, pe);
