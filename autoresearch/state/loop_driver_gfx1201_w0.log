+    float acc0 = 0.0f, acc1 = 0.0f;
+    float bcc0 = 0.0f, bcc1 = 0.0f;
+    float ccc0 = 0.0f, ccc1 = 0.0f;
+    float dcc0 = 0.0f, dcc1 = 0.0f;
+
+#if defined(__gfx1200__) || defined(__gfx1201__)
+    // gfx12-only metadata broadcast: all lanes consume the exact bits loaded
+    // by lane 0, while the per-lane packed-word load and FMA order are unchanged.
+    #define DOG_X8(gp, a, x0, x1, x2, x3, x4, x5, x6, x7) do { \
