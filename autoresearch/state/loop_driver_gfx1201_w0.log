BASE=();VAR=();BK=();VK=();BC=OK;VC=OK
sample(){ local n=$1 r d c k; for r in $(seq 1 "$n"); do
  read d c k < <(measure /tmp/v2_base_$ID); BASE+=("$d");BK+=("$k");[ "$c" = BAD ]&&BC=BAD
