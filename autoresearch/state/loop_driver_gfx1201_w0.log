 "base_runs":[float(x) for x in bs.split()],"var_runs":[float(x) for x in vs.split()]}
open(ledger,"a").write(json.dumps(rec)+"\n")
out={k:rec[k] for k in ("label","verdict","mwu_dominance","delta_pct","rounds","var_coh","win_commit")}
