    // groups==2: only slots 0/1 live; (a0+a1) ≡ baseline (a0+a1)+(a2+a3) with a2=a3=0.
    float acc = acc0 + acc1;
    float bcc = bcc0 + bcc1;
    float ccc = ccc0 + ccc1;
    float dcc = dcc0 + dcc1;
