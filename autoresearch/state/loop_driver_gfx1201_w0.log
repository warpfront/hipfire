     5	#include <hip/hip_runtime.h>
     6	
     7	extern "C" __global__ void transpose_f32(
     8	    const float* __restrict__ in_data,
     9	    float* __restrict__ out_data,
    10	    int rows, int cols
    11	) {
    12	    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    13	    int total = rows * cols;
    14	    if (idx >= total) return;
    15	    int r = idx / cols;
    16	    int c = idx % cols;
    17	    out_data[c * rows + r] = in_data[idx];
    18	}

