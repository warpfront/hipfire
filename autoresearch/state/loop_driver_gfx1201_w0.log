     1	#include <hip/hip_runtime.h>
     2	
     3	// Atomic-free variant of `gemv_hfq4g256_moe_down_residual_scaled_k8_indexed_batched`.
     4	//
     5	// Same per-(token, krank) GEMV compute. Instead of `atomicAdd(scale * acc)`
     6	// into a shared `x_residual[N × M]` row (K_TOP-way contention per output
     7	// cell, observed ~387 GiB/s on R9700/gfx1201 vs the sister gate_up at
     8	// 954 GiB/s with the same MQ4 layout but no atomic), this kernel writes
     9	// each (token, krank) result to its own row in an expanded buffer
    10	// `expert_outputs[N × K_TOP × M]`. A separate `moe_down_combine_k8_batched`
    11	// kernel folds K_TOP outputs back into the residual stream with topk_weights
    12	// applied — see kernels/src/moe_down_combine_k8_batched.hip.
    13	//
    14	// Shapes (vs the residual_scaled variant):
    15	//   expert_ptrs    : [n_exp]                — unchanged
    16	//   topk_indices   : [N × K_TOP]            — unchanged
    17	//   rot_batch      : [N × K_TOP × K]        — unchanged
    18	//   expert_outputs : [N × K_TOP × M]        — replaces x_residual; non-atomic
    19	// Note: `topk_weights` is NOT consumed here; the combine kernel applies the
    20	// scale during reduction over K_TOP. Dropping the weights load also saves
    21	// a small amount of bandwidth.
    22	//
    23	// Grid: (M, K_TOP, N). Block = 32 threads. No atomic ops — each output
    24	// address is written by exactly one workgroup, so the writes are pure
    25	// stores.
    26	//
    27	// VARIANT R17c1 down_g2_hoist_x16:
    28	// BOD: L2-resident/mixed occ~43% mem_busy~44% (post g2_branchless_fulltile WIN).
    29	// Current body: per-group LOAD_X8 then 4 DOGs → x-load serializes with weight
    30	// DOG for each of the 2 groups. residual/multirow R13/R15 WIN was hoisting
    31	// full x for the group-quad BEFORE dual-row DOG so weight MAC dual-issues
    32	// against resident x under L2-resident weights. Apply that here: float4×4
    33	// hoist of both groups' 16 x lanes first, then all 8 DOGs (4 rows × 2
    34	// groups) with x resident. Value-preserving: same sc/zp/pk, same FMA order
    35	// per DOG, same pairwise slot fold + shfl reduce + masked store.
    36	
    37	__launch_bounds__(32, 16)
    38	extern "C" __global__ void gemv_hfq4g256_moe_down_k8_indexed_batched_expanded(
    39	    const unsigned long long* __restrict__ expert_ptrs, // [n_exp]
    40	    const int*   __restrict__ topk_indices,              // [N × K_TOP]
    41	    const float* __restrict__ rot_batch,                 // [N × K_TOP × K]
    42	    float*       __restrict__ expert_outputs,            // [N × K_TOP × M]
    43	    int M, int K, int K_TOP
    44	) {
    45	    const int row0 = blockIdx.x * 4;
    46	    if (row0 >= M) return;
    47	    const int row1 = row0 + 1;
    48	    const int row2 = row0 + 2;
    49	    const int row3 = row0 + 3;
    50	    const bool have_row1 = row1 < M;
    51	    const bool have_row2 = row2 < M;
    52	    const bool have_row3 = row3 < M;
    53	    const int krank = blockIdx.y;
    54	    const int bid = blockIdx.z;
    55	    const int tid = threadIdx.x;
    56	
    57	    const int routing_base = bid * K_TOP;
    58	    const int expert_id = topk_indices[routing_base + krank];
    59	    const char* __restrict__ A =
    60	        reinterpret_cast<const char*>(expert_ptrs[expert_id]);
    61	    const float* __restrict__ x =
    62	        rot_batch + ((long long)bid * K_TOP + krank) * K;
    63	
    64	    // K=512 → 2 groups; row stride matches baseline (groups*136).
    65	    const int groups_per_row = K / 256;
    66	    const long long row_stride = (long long)groups_per_row * 136;
    67	    // Clamp OOB rows to row0 for weight reads (safe in-bounds); store still masked.
    68	    const char* row_ptr0 = A + (long long)row0 * row_stride;
    69	    const char* row_ptr1 = A + (long long)(have_row1 ? row1 : row0) * row_stride;
    70	    const char* row_ptr2 = A + (long long)(have_row2 ? row2 : row0) * row_stride;
    71	    const char* row_ptr3 = A + (long long)(have_row3 ? row3 : row0) * row_stride;
    72	    const int boff = tid * 4;
    73	
    74	    // gfx12: initiate the four first-demand group-0 cacheline fetches while
    75	    // the existing x float4 hoist provides independent VMEM work.  Group 1
    76	    // is adjacent and already covered by the group-0 compute window.
    77	#if defined(__gfx1200__) || defined(__gfx1201__)
    78	    __builtin_amdgcn_s_prefetch_data((const void*)row_ptr0, 0);
    79	    __builtin_amdgcn_s_prefetch_data((const void*)row_ptr1, 0);
    80	    __builtin_amdgcn_s_prefetch_data((const void*)row_ptr2, 0);
    81	    __builtin_amdgcn_s_prefetch_data((const void*)row_ptr3, 0);
    82	#endif
    83	
    84	    // 2 live pairwise slots/row (acc2/acc3 would stay 0 on groups==2).
    85	    float acc0 = 0.0f, acc1 = 0.0f;
    86	    float bcc0 = 0.0f, bcc1 = 0.0f;
    87	    float ccc0 = 0.0f, ccc1 = 0.0f;
    88	    float dcc0 = 0.0f, dcc1 = 0.0f;
    89	
    90	    #define DOG_X8(gp, a, x0, x1, x2, x3, x4, x5, x6, x7) do { \
    91	        float sc = __builtin_bit_cast(float, *(const unsigned int*)(gp)); \
    92	        float zp = __builtin_bit_cast(float, *(const unsigned int*)((gp) + 4)); \
    93	        unsigned int pk = *(const unsigned int*)((gp) + 8 + boff); \
    94	        (a) += (sc * (float)((pk) & 0xFu)         + zp) * (x0) \
    95	             + (sc * (float)(((pk) >> 4) & 0xFu)  + zp) * (x1) \
    96	             + (sc * (float)(((pk) >> 8) & 0xFu)  + zp) * (x2) \
    97	             + (sc * (float)(((pk) >> 12) & 0xFu) + zp) * (x3) \
    98	             + (sc * (float)(((pk) >> 16) & 0xFu) + zp) * (x4) \
    99	             + (sc * (float)(((pk) >> 20) & 0xFu) + zp) * (x5) \
   100	             + (sc * (float)(((pk) >> 24) & 0xFu) + zp) * (x6) \
   101	             + (sc * (float)(((pk) >> 28) & 0xFu) + zp) * (x7); \
   102	    } while (0)
   103	
   104	    // Hoist both groups' 16 x elements (float4×4) before any weight DOG.
   105	    const int base0 = tid * 8;
   106	    const float4 xv0a = *reinterpret_cast<const float4*>(x + base0);
   107	    const float4 xv0b = *reinterpret_cast<const float4*>(x + base0 + 4);
   108	    const float4 xv1a = *reinterpret_cast<const float4*>(x + base0 + 256);
   109	    const float4 xv1b = *reinterpret_cast<const float4*>(x + base0 + 260);
   110	
   111	    // Group 0 → pairwise slot 0 (matches baseline tail g=0 → acc0).
   112	    DOG_X8(row_ptr0 + 0 * 136, acc0,
   113	           xv0a.x, xv0a.y, xv0a.z, xv0a.w, xv0b.x, xv0b.y, xv0b.z, xv0b.w);
   114	    DOG_X8(row_ptr1 + 0 * 136, bcc0,
   115	           xv0a.x, xv0a.y, xv0a.z, xv0a.w, xv0b.x, xv0b.y, xv0b.z, xv0b.w);
   116	    DOG_X8(row_ptr2 + 0 * 136, ccc0,
   117	           xv0a.x, xv0a.y, xv0a.z, xv0a.w, xv0b.x, xv0b.y, xv0b.z, xv0b.w);
   118	    DOG_X8(row_ptr3 + 0 * 136, dcc0,
   119	           xv0a.x, xv0a.y, xv0a.z, xv0a.w, xv0b.x, xv0b.y, xv0b.z, xv0b.w);
   120	
   121	    // Group 1 → pairwise slot 1 (matches baseline tail g=1 → acc1).
   122	    DOG_X8(row_ptr0 + 1 * 136, acc1,
