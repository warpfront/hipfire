    // Group geometry is wave-uniform (K, warp_id only), so it is safe before
    // rms exists. Keep the prefetch path gfx12-only: other fleet arches must
    // compile the baseline schedule byte-for-byte.
    const int groups_total = K / 256;
    const int groups_per_warp = (groups_total + num_warps - 1) / num_warps;
    const int warp_group_start = warp_id * groups_per_warp;
    const int d0 = lane_id * 8;

    float4 pref_x0, pref_x1, pref_w0, pref_w1;
    float4 s10, s11, s20, s21;
    const int pref_group = warp_group_start;
    const bool have_pref = (groups_per_warp > 0 && pref_group < groups_total);

    // Phase 1a: same loads and accumulation order as baseline. At the
    // midpoint, issue the same first-group x/w loads that baseline issues
    // after the loop; they are consumed only after rms is published.
    float local_sum = 0.0f;
    const int n_iters = (K + block_size - 1) / block_size;
    const int mid_at = (n_iters + 1) >> 1;
    int iter = 0;
    for (int i = tid; i < K; i += block_size) {
        float v = x_b[i];
        local_sum += v * v;
        iter++;
        if (iter == mid_at && have_pref) {
            const int base = pref_group * 256 + d0;
            pref_x0 = *reinterpret_cast<const float4*>(x_b + base);
            pref_x1 = *reinterpret_cast<const float4*>(x_b + base + 4);
            pref_w0 = *reinterpret_cast<const float4*>(weight + base);
            pref_w1 = *reinterpret_cast<const float4*>(weight + base + 4);
        }
    }
#else
    // Baseline schedule for non-gfx12 devices, kept in the original order.
    float local_sum = 0.0f;
    for (int i = tid; i < K; i += block_size) {
        float v = x_b[i];
        local_sum += v * v;
    }

    const int groups_total = K / 256;
    const int groups_per_warp = (groups_total + num_warps - 1) / num_warps;
    const int warp_group_start = warp_id * groups_per_warp;
    const int d0 = lane_id * 8;

    float4 pref_x0, pref_x1, pref_w0, pref_w1;
    float4 s10, s11, s20, s21;
    const int pref_group = warp_group_start;
    const bool have_pref = (groups_per_warp > 0 && pref_group < groups_total);
    if (have_pref) {
        const int base = pref_group * 256 + d0;
        pref_x0 = *reinterpret_cast<const float4*>(x_b + base);
        pref_x1 = *reinterpret_cast<const float4*>(x_b + base + 4);
        pref_w0 = *reinterpret_cast<const float4*>(weight + base);
        pref_w1 = *reinterpret_cast<const float4*>(weight + base + 4);
    }
