   142	        #pragma unroll
   143	        for (int j = 0; j < 8; j++) {
   144	            int out_row = row_start + 8 * k_grp + j;
   145	            if (out_row < M) {
   146	                Y_grouped[(long long)out_col * M + out_row] = acc[j];
   147	            }
   148	        }
   149	    }
   150	}

