   126	              + ssc*pe[4]*x[base+4] + ssc*pe[5]*x[base+5] + ssc*pe[6]*x[base+6] + ssc*pe[7]*x[base+7];
   127	    }
   128	    if (tail >= 3) {
   129	        const int g = (quads << 2) + 2;
