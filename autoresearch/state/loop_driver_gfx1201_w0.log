      BLOB=$(git hash-object -w "$VARIANT" 2>/dev/null); TIDX="/tmp/v2idx_$ID"; rm -f "$TIDX"
      if [ -n "$BLOB" ] && GIT_INDEX_FILE="$TIDX" git read-tree "$CUR" 2>/dev/null \
