   131	        const float ssc = row_scale_f * cvt_e4m3_scale_to_f32(*(const unsigned char*)gp) * 0.88f;
   132	        const unsigned int ew = *(const unsigned int*)(gp + 1 + cw_off);
   133	        const int base = g * 256 + tid * 8;
