     for (int r = 0; r < TILE_ROWS; r++) {
         const float scale = s_scales[h * HD + row_start + r];
         const signed char* src = sq_base + r * HD;
+#if defined(__gfx1200__) || defined(__gfx1201__)
+        // Each four-lane group owns one aligned dword of each 32-byte
+        // quarter.  The broadcast keeps the original lane-to-byte mapping,
+        // so the arithmetic and reduction order are unchanged.
+        const int group = tid & ~3;
+        const int byte_shift = (tid & 3) * 8;
+        unsigned int w0 = 0, w1 = 0, w2 = 0, w3 = 0;
+        if ((tid & 3) == 0) {
+            w0 = *reinterpret_cast<const unsigned int*>(src + group);
+            w1 = *reinterpret_cast<const unsigned int*>(src + 32 + group);
+            w2 = *reinterpret_cast<const unsigned int*>(src + 64 + group);
+            w3 = *reinterpret_cast<const unsigned int*>(src + 96 + group);
+        }
+        w0 = __shfl(w0, group);
+        w1 = __shfl(w1, group);
+        w2 = __shfl(w2, group);
+        w3 = __shfl(w3, group);
+        S_f4[r * 32 + tid] = make_float4(
+            scale * (float)(signed char)(w0 >> byte_shift),
+            scale * (float)(signed char)(w1 >> byte_shift),
+            scale * (float)(signed char)(w2 >> byte_shift),
+            scale * (float)(signed char)(w3 >> byte_shift));
+#else
         S_f4[r * 32 + tid] = make_float4(
             scale * (float)src[tid],
             scale * (float)src[tid + 32],
             scale * (float)src[tid + 64],
