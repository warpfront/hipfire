     1	// SPDX-License-Identifier: Apache-2.0
     2	// Copyright (c) 2026 Kaden Schutt
     3	// hipfire — see LICENSE and NOTICE in the project root.
     4	//
     5	// Fast variant of gated_delta_net_q8 for the default MQ4/HFQ4 path.
     6	// Supports EF residual (sigma-delta) but always does single-end requant
     7	// OUTSIDE the per-token loop. No per-token requant mode.
     8	//
     9	// VARIANT R14c1 gdn_lds_float4_pack:
    10	// BOD: mem-active(mixed) occ~17% mem_busy~33% L2~86% vgpr=64 LDS=2048.
    11	// Baseline stores each lane's 4 HD-slices (tid, tid+32, tid+64, tid+96)
    12	// as four scalar LDS floats → 4 loads + 4 stores per row per token.
    13	// Pack as float4 S_f4[row*32 + tid] (same 2048 B footprint): one b128-class
    14	// LDS transaction per row touch. Math identical (same 4-way partials, same
    15	// shfl_down reduce tree, same update/requant). Hypothesis: LDS scalar
    16	// multi-issue is on the critical path of the per-row state machine under
    17	// low-occ decode (n_tokens=1); packing raises effective LDS bandwidth
    18	// without raising VGPR (still 4 live floats, just as a vector).
    19	
    20	#include <hip/hip_runtime.h>
    21	#include <hip/hip_fp16.h>
    22	
    23	#define HD 128
    24	#define TILE_ROWS 4
    25	
    26	extern "C" __launch_bounds__(32, 8)
    27	__global__ void gated_delta_net_q8_fast(
    28	    const float* __restrict__ q,
    29	    const float* __restrict__ k,
    30	    const float* __restrict__ v,
    31	    const float* __restrict__ gate,
    32	    const float* __restrict__ beta,
    33	    signed char* __restrict__ s_q8,
    34	    float* __restrict__ s_scales,
    35	    float* __restrict__ output,
    36	    int n_tokens,
    37	    int n_heads,
    38	    int head_dim,
    39	    unsigned int frame,
    40	    __half* __restrict__ s_ef_residual
    41	) {
    42	    const int h = blockIdx.x;
    43	    const int tile = blockIdx.y;
    44	    if (h >= n_heads) return;
    45	    const int tid = threadIdx.x;
    46	    const int stride = n_heads * HD;
    47	    const int row_start = tile * TILE_ROWS;
    48	
    49	    // Packed layout: S_f4[r * 32 + tid] = {S[r][tid], S[r][tid+32],
    50	    // S[r][tid+64], S[r][tid+96]} — same 4*128 floats as the scalar tile.
    51	    __shared__ float4 S_f4[TILE_ROWS * 32];  // 4 KiB
    52	
    53	    signed char* sq_base = s_q8 + h * HD * HD + row_start * HD;
    54	    for (int r = 0; r < TILE_ROWS; r++) {
    55	        const float scale = s_scales[h * HD + row_start + r];
    56	        const signed char* src = sq_base + r * HD;
    57	        S_f4[r * 32 + tid] = make_float4(
    58	            scale * (float)src[tid],
    59	            scale * (float)src[tid + 32],
    60	            scale * (float)src[tid + 64],
    61	            scale * (float)src[tid + 96]);
    62	    }
    63	
    64	    for (int t = 0; t < n_tokens; t++) {
    65	        const float* q_t = q + t * stride + h * HD;
    66	        const float* k_t = k + t * stride + h * HD;
    67	        const float* v_t = v + t * stride + h * HD;
    68	        float alpha = expf(gate[t * n_heads + h]);
    69	        float beta_v = beta[t * n_heads + h];
    70	
    71	        float k0 = k_t[tid], k1 = k_t[tid+32], k2 = k_t[tid+64], k3 = k_t[tid+96];
    72	        float q0 = q_t[tid], q1 = q_t[tid+32], q2 = q_t[tid+64], q3 = q_t[tid+96];
    73	        const float4 v_rows = *reinterpret_cast<const float4*>(v_t + row_start);
    74	
    75	        float out0 = 0.0f, out1 = 0.0f, out2 = 0.0f, out3 = 0.0f;
    76	        for (int r = 0; r < TILE_ROWS; r++) {
    77	            int row = row_start + r;
    78	            float4 s = S_f4[r * 32 + tid];
    79	            float s0 = s.x, s1 = s.y, s2 = s.z, s3 = s.w;
    80	
    81	            float kv = s0*k0 + s1*k1 + s2*k2 + s3*k3;
    82	            for (int o = 16; o > 0; o >>= 1)
    83	                kv += __shfl_down(kv, o);
    84	            kv = __shfl(kv, 0);
    85	
    86	            const float v_row =
    87	                (r == 0) ? v_rows.x :
    88	                (r == 1) ? v_rows.y :
    89	                (r == 2) ? v_rows.z : v_rows.w;
    90	            float delta = (v_row - alpha * kv) * beta_v;
    91	
    92	            s0 = alpha * s0 + k0 * delta;
    93	            s1 = alpha * s1 + k1 * delta;
    94	            s2 = alpha * s2 + k2 * delta;
    95	            s3 = alpha * s3 + k3 * delta;
    96	            S_f4[r * 32 + tid] = make_float4(s0, s1, s2, s3);
    97	
    98	            float out_v = s0*q0 + s1*q1 + s2*q2 + s3*q3;
    99	            for (int o = 16; o > 0; o >>= 1)
   100	                out_v += __shfl_down(out_v, o);
   101	            if (tid == 0) {
   102	                if (r == 0) out0 = out_v;
   103	                else if (r == 1) out1 = out_v;
   104	                else if (r == 2) out2 = out_v;
   105	                else out3 = out_v;
   106	            }
   107	        }
   108	        if (tid == 0) {
   109	            *reinterpret_cast<float4*>(output + t * stride + h * HD + row_start) =
   110	                make_float4(out0, out1, out2, out3);
   111	        }
   112	    }
   113	
   114	    // Requant FP32 → Q8 — OUTSIDE the token loop.
   115	    // Only the final state is quantized (intermediate tokens stay FP32 in LDS).
   116	    const bool use_ef = (s_ef_residual != nullptr);
   117	    for (int r = 0; r < TILE_ROWS; r++) {
   118	        int rr = row_start + r;
   119	        float4 s = S_f4[r * 32 + tid];
   120	        float s0 = s.x, s1 = s.y, s2 = s.z, s3 = s.w;
   121	
   122	        __half* efr = use_ef ? (s_ef_residual + h * HD * HD + rr * HD) : nullptr;
   123	        if (use_ef) {
   124	            s0 += __half2float(efr[tid]);
   125	            s1 += __half2float(efr[tid+32]);
   126	            s2 += __half2float(efr[tid+64]);
   127	            s3 += __half2float(efr[tid+96]);
   128	        }
   129	
   130	        float my_max = fmaxf(fmaxf(fabsf(s0), fabsf(s1)), fmaxf(fabsf(s2), fabsf(s3)));
   131	        for (int o = 16; o > 0; o >>= 1)
   132	            my_max = fmaxf(my_max, __shfl_xor(my_max, o));
   133	
   134	        float inv_s = (my_max > 0.0f) ? (127.0f / my_max) : 0.0f;
   135	
   136	        signed char* dst = sq_base + r * HD;
   137	        if (use_ef) {
   138	            // Deterministic round-to-nearest with EF residual update.
   139	            float scale = (my_max > 0.0f) ? (my_max / 127.0f) : 1.0f;
   140	            float qf0 = fminf(fmaxf(rintf(s0 * inv_s), -128.0f), 127.0f);
   141	            float qf1 = fminf(fmaxf(rintf(s1 * inv_s), -128.0f), 127.0f);
   142	            float qf2 = fminf(fmaxf(rintf(s2 * inv_s), -128.0f), 127.0f);
   143	            float qf3 = fminf(fmaxf(rintf(s3 * inv_s), -128.0f), 127.0f);
   144	            efr[tid]      = __float2half(s0 - qf0 * scale);
   145	            efr[tid+32]   = __float2half(s1 - qf1 * scale);
   146	            efr[tid+64]   = __float2half(s2 - qf2 * scale);
   147	            efr[tid+96]   = __float2half(s3 - qf3 * scale);
   148	            dst[tid]      = (signed char)qf0;
   149	            dst[tid+32]   = (signed char)qf1;
   150	            dst[tid+64]   = (signed char)qf2;
   151	            dst[tid+96]   = (signed char)qf3;
   152	            if (tid == 0) s_scales[h * HD + rr] = scale;
   153	        } else {
   154	            // Stochastic rounding.
   155	            unsigned int rng = (unsigned int)(h * 1664525u + rr * 1013904223u
   156	                             + tid * 214013u + frame * 2531011u);
   157	            #define STOCH_ROUND(val) ({ \
   158	                rng = rng * 1664525u + 1013904223u; \
   159	                float noise = (float)(rng >> 8) * (1.0f / 16777216.0f); \
   160	                (signed char)fminf(fmaxf(floorf((val) * inv_s + noise), -128.0f), 127.0f); \
   161	            })
   162	            dst[tid]      = STOCH_ROUND(s0);
   163	            dst[tid+32]   = STOCH_ROUND(s1);
   164	            dst[tid+64]   = STOCH_ROUND(s2);
   165	            dst[tid+96]   = STOCH_ROUND(s3);
   166	            #undef STOCH_ROUND
   167	            if (tid == 0) {
   168	                float scale = (my_max > 0.0f) ? (my_max / 127.0f) : 1.0f;
   169	                s_scales[h * HD + rr] = scale;
   170	            }
   171	        }
   172	    }
   173	}
