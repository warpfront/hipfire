+#include <hip/hip_runtime.h>
+
+// Fused RMSNorm + FWHT rotation for MagnumQuant inputs.
+//
+// R22c1 gfx12 experiment: keep only the first half of the first-group
+// x/weight prefetch live across the RMS reduction.  The remaining half is
+// loaded after rms is published, preserving the exact multiply/FWHT/store
+// math while shortening the prefetch live range by eight float values.
+// Other architectures retain the baseline source text below.
+
+#if defined(__gfx1200__) || defined(__gfx1201__)
+__launch_bounds__(256, 1)
+#else
+__launch_bounds__(256, 1)
+#endif
+extern "C" __global__ void fused_rmsnorm_mq_rotate(
+    const float* __restrict__ x,
+    const float* __restrict__ weight,
+    const float* __restrict__ signs1,
+    const float* __restrict__ signs2,
+    float* __restrict__ x_rot,
+    int K,
+    float eps
+) {
