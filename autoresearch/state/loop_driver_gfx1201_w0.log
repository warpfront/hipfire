    22	#include <hip/hip_runtime.h>
    23	
    24	__device__ __forceinline__ float cvt_e4m3_scale_to_f32(unsigned char b) {
    25	    const int exp = (b >> 3) & 0xF;
    26	    const unsigned mant = (unsigned)(b & 0x7);
    27	    if (exp == 0) return 0.015625f * ((float)mant) * 0.125f;
    28	    if (exp == 0xF && mant == 7u) return 448.0f;
    29	    const float pow2 = __builtin_bit_cast(float, ((unsigned int)(exp + 120)) << 23);
    30	    return pow2 * (1.0f + ((float)mant) * 0.125f);
    31	}
    32	
    33	__device__ __forceinline__ void e8_decode_index(unsigned int idx, float p[8]) {
    34	    const int coset = (int)((idx >> 31) & 1u);
    35	    unsigned int e[8];
    36	    unsigned int sl = 0u;
    37	    for (int i = 0; i < 7; i++) { e[i] = (idx >> (unsigned)(4 * i)) & 0xFu; sl += e[i]; }
    38	    const unsigned int e7_high = (idx >> 28) & 0x7u;
    39	    const unsigned int p7 = e7_high << 1;
    40	    const unsigned int lsb = (sl + p7) & 1u;
    41	    e[7] = p7 | lsb;
    42	    for (int i = 0; i < 8; i++) { float c = (float)((int)e[i] - 7); p[i] = coset ? c + 0.5f : c; }
    43	}
    44	
    45	// 4-way unroll row accumulator. Same contract as the gate_up twin.
    46	// K must be a multiple of 256 (groups_per_row integer); A3B has K=2048 → 8 groups → quads=2.
    47	__device__ __forceinline__ float e8_moe_row_acc_dgpu(
    48	    const char* __restrict__ A, const float* __restrict__ x, int row, int K, int tid
    49	) {
    50	    const int groups_per_row  = K / 256;
    51	    const int row_block_bytes = (K / 32) * 17;
    52	    const long long row_off   = (long long)row * (16 + (long long)row_block_bytes);
    53	    const char* hdr    = A + row_off;
    54	    const char* row_ptr = hdr + 16;
    55	    const float row_scale_f = (float)__builtin_bit_cast(_Float16, *(const unsigned short*)hdr);
    56	
    57	    const int block_in_iter   = tid >> 2;
    58	    const int cw_off          = (tid & 3) * 4;
    59	    const int thread_block_off = block_in_iter * 17;
    60	
    61	    float acc0 = 0.0f, acc1 = 0.0f, acc2 = 0.0f, acc3 = 0.0f;
    62	
    63	    const int quads = groups_per_row >> 2;
    64	    const int tail  = groups_per_row & 3;
    65	
    66	    for (int q = 0; q < quads; q++) {
    67	        const int g = q << 2;
    68	        const char* gp0 = row_ptr + (long long)g       * 136 + thread_block_off;
    69	        const char* gp1 = row_ptr + (long long)(g + 1) * 136 + thread_block_off;
    70	        const char* gp2 = row_ptr + (long long)(g + 2) * 136 + thread_block_off;
    71	        const char* gp3 = row_ptr + (long long)(g + 3) * 136 + thread_block_off;
    72	
    73	        const float ssc0 = row_scale_f * cvt_e4m3_scale_to_f32(*(const unsigned char*)gp0) * 0.88f;
    74	        const float ssc1 = row_scale_f * cvt_e4m3_scale_to_f32(*(const unsigned char*)gp1) * 0.88f;
    75	        const float ssc2 = row_scale_f * cvt_e4m3_scale_to_f32(*(const unsigned char*)gp2) * 0.88f;
    76	        const float ssc3 = row_scale_f * cvt_e4m3_scale_to_f32(*(const unsigned char*)gp3) * 0.88f;
    77	
    78	        const unsigned int ew0 = *(const unsigned int*)(gp0 + 1 + cw_off);
    79	        const unsigned int ew1 = *(const unsigned int*)(gp1 + 1 + cw_off);
    80	        const unsigned int ew2 = *(const unsigned int*)(gp2 + 1 + cw_off);
    81	        const unsigned int ew3 = *(const unsigned int*)(gp3 + 1 + cw_off);
    82	
    83	        const int base0 = g * 256 + tid * 8;
    84	        const int base1 = base0 + 256;
    85	        const int base2 = base0 + 512;
    86	        const int base3 = base0 + 768;
