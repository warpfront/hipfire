  BASE_KSRC="/tmp/cai_base_$ID.hip"; git show "$BASE_SHA:$KSRC" > "$BASE_KSRC" 2>/dev/null
  CAG=$(KSRC_DIR="$WT/kernels/src" bash "$MAIN/autoresearch/harness/cross_arch_guard.sh" "$VARIANT" "$BASE_KSRC" $OTHER_A 2>/dev/null)
