125:if [ -z "$PB" ] || [ "$PB" != "$PC" ]; then [ -f "$GPULK" ] && gpu_release >/dev/null 2>&1; echo "{\"arch\":\"$ARCH\",\"label\":\"$LABEL\",\"verdict\":\"PARITY_FAIL\"}"; exit 0; fi
128:sample(){ local n=$1 r d c k; for r in $(seq 1 "$n"); do
132:fstats(){ python3 - "${BASE[*]}" "${VAR[*]}" <<'PY'
134:b=[float(x) for x in sys.argv[1].split()];v=[float(x) for x in sys.argv[2].split()]
135:n=len(v)*len(b); f=sum((1.0 if x>y else .5 if x==y else 0) for x in v for y in b)/n if n else .5
136:bm=st.median(b);vm=st.median(v);d=100*(vm-bm)/bm if bm else 0
137:print(f"{f:.4f} {d:.3f} {bm:.2f} {vm:.2f}")
141:read F DELTA BM VM < <(fstats)
143:  sample 2; read F DELTA BM VM < <(fstats)
146:# ---- gating + verdict ----
147:BCK=$(python3 -c "import statistics as s;a=[$(IFS=,;echo "${BK[*]}")];print(int(s.median(a)) if a else 0)" 2>/dev/null)
148:VCK=$(python3 -c "import statistics as s;a=[$(IFS=,;echo "${VK[*]}")];print(int(s.median(a)) if a else 0)" 2>/dev/null)
150:if [ "$VC" = BAD ] || [ "$BC" = BAD ]; then VERDICT=COHERENCE_FAIL
151:elif [ "$CLK_OK" != 1 ]; then VERDICT=VOID
152:elif awk "BEGIN{exit !($F>=$WIN_F && $DELTA>$FLOOR)}"; then VERDICT=WIN
153:elif awk "BEGIN{exit !($F<=$DEAD_F || ($DELTA< -$FLOOR && $F<=0.35))}"; then VERDICT=DEAD
154:else VERDICT=INCONCLUSIVE; fi
155:# ---- CROSS-ARCH ISOLATION GUARD (policy: a win tuned for THIS arch must NOT change ANY other fleet arch's
156:#      compiled code — -any% cross-arch is unacceptable). Byte-exact preprocessor-invariance: if the edit shifts
157:#      another arch's device TU, demote WIN -> CROSS_ARCH (must arch-gate the change behind #if defined(__gfxNNNN__)
158:#      or move it to a .gfxNNNN file); it does NOT advance the baseline. Arch-suffixed / unpreprocessable = skip. ----
160:if [ "$VERDICT" = WIN ]; then
161:  OTHER_A=""; for a in ${CROSS_ARCH_ARCHS:-gfx1100 gfx1151 gfx1030 gfx1201}; do [ "$a" = "$ARCH" ] || OTHER_A="$OTHER_A $a"; done
164:  rm -f "$BASE_KSRC"
165:  case "$CAG" in CROSS_ARCH:*) VERDICT=CROSS_ARCH; CROSS_NOTE="corrupts device codegen on${CAG#CROSS_ARCH:} — arch-gate the change (#if defined(__gfx12__)) or use a .gfxNNNN variant" ;; esac
166:fi
168:#      Optimistic concurrency: build the win commit on the CURRENT baseline tip and CAS the ref forward under a
169:#      per-arch commit lock. A same-kernel staleness guard rejects the advance if another worker already moved
170:#      THIS kernel since we measured (our delta would be against a now-stale version of the file) -> re-measured
172:#      are caught by the periodic coherence fold). This is what makes the fleet COMPOUND wins across worktrees
173:#      instead of each worker re-counting one cumulative gain against a frozen baseline (Bug 1). ----
175:if [ "$VERDICT" = WIN ]; then
176:  BREF="refs/heads/${BASELINE_REF#refs/heads/}"
178:    flock 7
180:    if [ -n "$CUR" ] && git diff --quiet "$BASE_SHA" "$CUR" -- "$KSRC" 2>/dev/null; then
181:      BLOB=$(git hash-object -w "$VARIANT" 2>/dev/null); TIDX="/tmp/v2idx_$ID"; rm -f "$TIDX"
182:      if [ -n "$BLOB" ] && GIT_INDEX_FILE="$TIDX" git read-tree "$CUR" 2>/dev/null \
183:         && GIT_INDEX_FILE="$TIDX" git update-index --add --cacheinfo "100644,$BLOB,$KSRC" 2>/dev/null; then
186:              commit-tree "$TREE" -p "$CUR" -m "WIN $LABEL $KERNEL f=$F d=${DELTA}% rounds=$ROUNDS" 2>/dev/null)
187:        [ -n "$NEW" ] && git update-ref "$BREF" "$NEW" "$CUR" 2>/dev/null && git rev-parse --short "$NEW" > "/tmp/v2win_$ID"
188:      fi
189:      rm -f "$TIDX"
190:    else echo STALE_KERNEL_RACE > "/tmp/v2win_$ID"; fi
192:  W=$(cat "/tmp/v2win_$ID" 2>/dev/null); rm -f "/tmp/v2win_$ID"
194:  git checkout "$BASELINE_REF" -- kernels/src/ 2>/dev/null; git clean -fdq kernels/src/ 2>/dev/null
195:fi
196:# ---- per-variant PROFILE on EVERY verdict (so the agent sees WHY it won/lost + what to try next,
197:#      not a bare scalar — this is what stops it flying blind under the 5-run permutation budget) ----
199:if [ "$VERDICT" != "BASELINE_BUILD_FAIL" ] && [ "$VERDICT" != "VARIANT_BUILD_FAIL" ]; then
201:  BPC="/tmp/baseprof_${ARCH}_$(echo "$KERNEL" | tr / _)"   # base profiled ONCE per kernel, cached + reused across its variants
204:fi
205:[ -f "$GPULK" ] && gpu_release >/dev/null 2>&1   # GPU phase done -> release the run-queue for the next queued certify
206:rm -f /tmp/v2_base_$ID /tmp/v2_var_$ID
207:# self-describing provenance: DAEMON-reported GPU arch (rocminfo lies), baseline sha, variant blob sha, prompt md5
208:# -> a measurement_hash so no tok/s in the ledger is ever orphaned from the exact {arch,kernels,model,prompt} it ran on.
209:GPU_ARCH=$(grep -oiE 'gfx[0-9]+' "/tmp/v2e_$ID" 2>/dev/null | head -1); rm -f "/tmp/v2e_$ID"
210:PROMPT_MD5=$(printf '%s' 'Write a detailed paragraph about the history and future of computing.' | md5sum | cut -d' ' -f1)
215:(arch,kern,label,variant,verdict,rounds,f,delta,bm,vm,bc,vc,committed,ledger,bs,vs,bp,vp,cross_note,gpu_arch,base_sha,var_sha,prompt_md5,model)=sys.argv[1:25]
216:def prow(p):
217:  # match the profile row by KERNEL: the arg is the SOURCE-FILE base name, but rocprof reports the RUNTIME
218:  # SYMBOL name, and they can diverge after the core (gate_up file "..._indexed_batched" vs symbol
219:  # "..._k8_indexed"). So: exact/prefix-either-direction wins outright; else best LEADING-TOKEN overlap (>=4
220:  # core tokens, so moe_gate_up != moe_down which split at token 4). This is the "no profile" fix.
223:  if not isinstance(d, dict): return None   # "null"/list/scalar profile -> no row (don't crash the ledger write)
225:  for r in d.get("rows",[]):
227:    for a,b in zip(kt,rt):
228:      if a==b: n+=1
230:    if rk==kern or rk.startswith(kern) or kern.startswith(rk): n=999
231:    if n>bestn: bestn=n; best=r
232:  if best and bestn>=4:
233:    return {x:best.get(x) for x in ("wall_pct","occ","l2_hit_pct","mem_busy","vgpr","lds")}
236:roof={"target_base":b,"target_var":v} if (b or v) else None
238:fb=[]
239:if b and v:
241:  if bg is not None and vg is not None and vg>bg+2: fb.append(f"VGPR {bg}->{vg}")
242:  if bo and vo and vo<bo*0.85: fb.append(f"occ {bo}->{vo}% DROPPED-WAVES(you overloaded=the row-reuse regression mode; cut registers/use global_load_lds)")
243:  if vo is not None and vo<5: fb.append(f"occ {vo}% CATASTROPHIC-UNDEROCC(per-wave MLP ring is the lever here)")
244:  elif vmb is not None and vo is not None and vmb<70 and vo>=20: fb.append(f"mem_busy {vmb}%+occ {vo}%=TLP already hides latency, NOT MLP-limited")
245:  if vl is not None and vl<30: fb.append(f"L2-hit {vl}% CACHE-NOT-FIXED(DRAM-thrash; SLC/stream the write-once weights, keep x/KV resident)")
246:  if vo is not None and vmb is not None and vo>85 and vmb>85: fb.append("SATURATED at roofline-leave it")
247:feedback="; ".join(fb) if fb else ("no profile" if not v else "no clear lever signal")
248:if cross_note: feedback = "CROSS_ARCH " + cross_note + ((" | " + feedback) if fb else "")
250:# — reproducible + cross-session-comparable, so a number is never orphaned from its config (the "where is the baseline" gap).
252:rec={"arch":arch,"gpu_arch":gpu_arch or None,"measurement_hash":mhash,"kernel":kern,"label":label,"variant":variant,"verdict":verdict,
253: "WIN":verdict=="WIN","mwu_dominance":round(float(f),3),"rounds":int(rounds),
254: "base_decode":round(float(bm),2),"var_decode":round(float(vm),2),"delta_pct":round(float(delta),2),
255: "base_coh":bc,"var_coh":vc,"win_commit":committed or None,"roofline":roof,"profile_feedback":feedback,
257: "base_runs":[float(x) for x in bs.split()],"var_runs":[float(x) for x in vs.split()]}
259:out={k:rec[k] for k in ("label","verdict","mwu_dominance","delta_pct","rounds","var_coh","win_commit")}
260:out["profile_feedback"]=feedback; out["target_var"]=v

