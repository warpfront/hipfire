+    // limiter is per-block latency rather than resident-wave capacity.  On
+    // gfx1100 assign independent FWHT groups directly by warp stride.  This
+    // removes the ceil-divide, start multiply, and inner bounds break from
+    // the hot path; arithmetic within every group is unchanged.  Preserve
+    // the original source on all other fleet architectures.
+#if defined(__gfx1100__)
+    for (int group = warp_id; group < groups_total; group += num_warps) {
+#else
     const int groups_per_warp = (groups_total + num_warps - 1) / num_warps;
     const int warp_group_start = warp_id * groups_per_warp;
 
     for (int gi = 0; gi < groups_per_warp; gi++) {
         const int group = warp_group_start + gi;
         if (group >= groups_total) break;
+#endif
 
         const int d0 = lane_id * 8;
         const int base = group * 256 + d0;

