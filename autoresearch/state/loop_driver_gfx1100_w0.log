n=len(v)*len(b); f=sum((1.0 if x>y else .5 if x==y else 0) for x in v for y in b)/n if n else .5
bm=st.median(b);vm=st.median(v);d=100*(vm-bm)/bm if bm else 0
print(f"{f:.4f} {d:.3f} {bm:.2f} {vm:.2f}")
PY
}
