+    // gfx1100: XOR partners are in-range for every power-of-two stage.
+    // Lane 0 retains the baseline pairwise reduction order exactly.
+    for (int offset = 16; offset > 0; offset >>= 1)
+        gacc += __shfl_xor(gacc, offset);
+    for (int offset = 16; offset > 0; offset >>= 1)
+        uacc += __shfl_xor(uacc, offset);
+#else
+    for (int offset = 16; offset > 0; offset >>= 1)
+        gacc += __shfl_down(gacc, offset);
+    for (int offset = 16; offset > 0; offset >>= 1)
+        uacc += __shfl_down(uacc, offset);
+#endif
+
+    if (tid == 0) {
+        y_gate[krank * mi + row] = gacc;
+        y_up[krank * mi + row] = uacc;
+    }
+}
