  [ -s "$BPC" ] || rp /tmp/v2_base_$ID > "$BPC"
  BP=$(cat "$BPC"); VP=$(rp /tmp/v2_var_$ID)
fi
[ -f "$GPULK" ] && gpu_release >/dev/null 2>&1   # GPU phase done -> release the run-queue for the next queued certify
rm -f /tmp/v2_base_$ID /tmp/v2_var_$ID
