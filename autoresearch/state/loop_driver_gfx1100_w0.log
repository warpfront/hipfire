/bin/bash -lc "for f in /home/kaden/hipfire-loop/.aw/sw_card0/.agents/skills/hipfire-kernel-tuning/playbook.md /home/kaden/hipfire-loop/.aw/sw_card0/.agents/skills/hipfire-kernel-tuning/levers.md /home/kaden/hipfire-loop/.aw/sw_card0/.agents/skills/hipfire-kernel-tuning/cross-arch.md /home/kaden/hipfire-loop/.aw/sw_card0/.agents/skills/hipfire-kernel-tuning/case-studies.md; do sed -n '1,1000p' \""'$f"; done' in /home/kaden/hipfire-loop/.aw/sw_card0
