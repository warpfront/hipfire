+++ b/exp_R5c0.hip
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+#include <hip/hip_runtime.h>
+
+#if defined(__gfx1100__)
+// RDNA3 value-preserving packed-nibble extraction.  Splitting the word into
+// low/high nibble byte lanes once removes the per-term shift-and-mask chain;
