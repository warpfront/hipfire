diff --git a//tmp/exp_R3c0.hip b//tmp/exp_R3c0.hip
index 41b018507fa11ea687fe53616b513846f31bbdac..f2f0078da1888f18f7a05fbca219f49bd1e99ac3
--- a//tmp/exp_R3c0.hip
+++ b//tmp/exp_R3c0.hip
@@ -32,10 +32,27 @@
     const int krank = blockIdx.y;
     const int tid = threadIdx.x;
 
+    // The routing choice is uniform across the wave.  On gfx1100, make
+    // the two dependent routing loads explicitly lane-local and broadcast
+    // the resulting address so they cannot become redundant per-lane VMEM.
+#if defined(__gfx1100__)
+    unsigned long long expert_addr = 0;
+    if (threadIdx.x == 0) {
+        const int expert_id = topk_indices[krank];
+        expert_addr = expert_ptrs[expert_id];
+    }
+    unsigned int expert_addr_lo = (unsigned int)expert_addr;
+    unsigned int expert_addr_hi = (unsigned int)(expert_addr >> 32);
+    expert_addr_lo = __shfl(expert_addr_lo, 0);
+    expert_addr_hi = __shfl(expert_addr_hi, 0);
+    expert_addr = ((unsigned long long)expert_addr_hi << 32) | expert_addr_lo;
+    const char* __restrict__ A = reinterpret_cast<const char*>(expert_addr);
+#else
     // Read expert_id from device and index into the pointer table.
     const int expert_id = topk_indices[krank];
     const char* __restrict__ A =
         reinterpret_cast<const char*>(expert_ptrs[expert_id]);
+#endif
 
     const int groups_per_row = K / 256;
     const char* gate_ptr = A + (long long)row * groups_per_row * 136;

