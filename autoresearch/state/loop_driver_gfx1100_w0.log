  # definition/launch signature is exactly `<KERNEL>(` (word-anchored, so k8 != k8_indexed). Parity gate backstops.
  RES=""
  for f in $(grep -rlE "__global__.*\b${KERNEL}[[:space:]]*\(" kernels/src/*.hip 2>/dev/null); do
