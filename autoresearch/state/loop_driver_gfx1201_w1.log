diff --git a//tmp/exp_R11c2.hip b//tmp/exp_R11c2.hip
index 87da980e4c4be95048f51ee0e71271add05288af..3d2fb3207830eb7c42b8036c4f1262375298bd05
--- a//tmp/exp_R11c2.hip
+++ b//tmp/exp_R11c2.hip
@@ -46,6 +46,114 @@
     const int stride = n_heads * HD;
     const int row_start = tile * TILE_ROWS;
 
+#if defined(__gfx1200__) || defined(__gfx1201__)
+    // Decode is overwhelmingly a single-token invocation.  In that case each
+    // row's state is read, updated, consumed, and requantized exactly once, so
+    // it need not make the generic path's LDS round trip.  Keep the row-local
+    // arithmetic and RNG order identical; the generic path below handles every
+    // multi-token call unchanged.
+    if (n_tokens == 1) {
+        const float* q_t = q + h * HD;
+        const float* k_t = k + h * HD;
+        const float* v_t = v + h * HD;
+        const float alpha = expf(gate[h]);
+        const float beta_v = beta[h];
+        const float k0 = k_t[tid], k1 = k_t[tid + 32];
+        const float k2 = k_t[tid + 64], k3 = k_t[tid + 96];
+        const float q0 = q_t[tid], q1 = q_t[tid + 32];
+        const float q2 = q_t[tid + 64], q3 = q_t[tid + 96];
+        const float4 v_rows = *reinterpret_cast<const float4*>(v_t + row_start);
+        const bool use_ef = (s_ef_residual != nullptr);
+        signed char* const sq_base = s_q8 + h * HD * HD + row_start * HD;
+        float out0 = 0.0f, out1 = 0.0f, out2 = 0.0f, out3 = 0.0f;
+
+        #pragma unroll
+        for (int r = 0; r < TILE_ROWS; ++r) {
+            const int rr = row_start + r;
+            const float scale_in = s_scales[h * HD + rr];
+            const signed char* src = sq_base + r * HD;
+            float s0 = scale_in * (float)src[tid];
+            float s1 = scale_in * (float)src[tid + 32];
+            float s2 = scale_in * (float)src[tid + 64];
+            float s3 = scale_in * (float)src[tid + 96];
+
+            float kv = s0 * k0 + s1 * k1 + s2 * k2 + s3 * k3;
+            for (int o = 16; o > 0; o >>= 1)
+                kv += __shfl_down(kv, o);
+            kv = __shfl(kv, 0);
+
+            const float v_row =
+                (r == 0) ? v_rows.x :
+                (r == 1) ? v_rows.y :
+                (r == 2) ? v_rows.z : v_rows.w;
+            const float delta = (v_row - alpha * kv) * beta_v;
+            s0 = alpha * s0 + k0 * delta;
+            s1 = alpha * s1 + k1 * delta;
+            s2 = alpha * s2 + k2 * delta;
+            s3 = alpha * s3 + k3 * delta;
+
+            float out_v = s0 * q0 + s1 * q1 + s2 * q2 + s3 * q3;
+            for (int o = 16; o > 0; o >>= 1)
+                out_v += __shfl_down(out_v, o);
+            if (tid == 0) {
+                if (r == 0) out0 = out_v;
+                else if (r == 1) out1 = out_v;
+                else if (r == 2) out2 = out_v;
+                else out3 = out_v;
+            }
+
+            __half* efr = use_ef ? (s_ef_residual + h * HD * HD + rr * HD) : nullptr;
+            if (use_ef) {
+                s0 += __half2float(efr[tid]);
+                s1 += __half2float(efr[tid + 32]);
+                s2 += __half2float(efr[tid + 64]);
+                s3 += __half2float(efr[tid + 96]);
+            }
+
+            float my_max = fmaxf(fmaxf(fabsf(s0), fabsf(s1)), fmaxf(fabsf(s2), fabsf(s3)));
+            for (int o = 16; o > 0; o >>= 1)
+                my_max = fmaxf(my_max, __shfl_xor(my_max, o));
+            const float inv_s = (my_max > 0.0f) ? (127.0f / my_max) : 0.0f;
+            signed char* dst = sq_base + r * HD;
+            if (use_ef) {
+                const float scale_out = (my_max > 0.0f) ? (my_max / 127.0f) : 1.0f;
+                const float qf0 = fminf(fmaxf(rintf(s0 * inv_s), -128.0f), 127.0f);
+                const float qf1 = fminf(fmaxf(rintf(s1 * inv_s), -128.0f), 127.0f);
+                const float qf2 = fminf(fmaxf(rintf(s2 * inv_s), -128.0f), 127.0f);
+                const float qf3 = fminf(fmaxf(rintf(s3 * inv_s), -128.0f), 127.0f);
+                efr[tid]      = __float2half(s0 - qf0 * scale_out);
+                efr[tid + 32] = __float2half(s1 - qf1 * scale_out);
+                efr[tid + 64] = __float2half(s2 - qf2 * scale_out);
+                efr[tid + 96] = __float2half(s3 - qf3 * scale_out);
+                dst[tid]      = (signed char)qf0;
+                dst[tid + 32] = (signed char)qf1;
+                dst[tid + 64] = (signed char)qf2;
+                dst[tid + 96] = (signed char)qf3;
+                if (tid == 0) s_scales[h * HD + rr] = scale_out;
+            } else {
+                unsigned int rng = (unsigned int)(h * 1664525u + rr * 1013904223u
+                                 + tid * 214013u + frame * 2531011u);
+                #define STOCH_ROUND_N1(val) ({ \
+                    rng = rng * 1664525u + 1013904223u; \
+                    float noise = (float)(rng >> 8) * (1.0f / 16777216.0f); \
+                    (signed char)fminf(fmaxf(floorf((val) * inv_s + noise), -128.0f), 127.0f); \
+                })
+                dst[tid]      = STOCH_ROUND_N1(s0);
+                dst[tid + 32] = STOCH_ROUND_N1(s1);
+                dst[tid + 64] = STOCH_ROUND_N1(s2);
+                dst[tid + 96] = STOCH_ROUND_N1(s3);
+                #undef STOCH_ROUND_N1
+                if (tid == 0)
+                    s_scales[h * HD + rr] = (my_max > 0.0f) ? (my_max / 127.0f) : 1.0f;
+            }
+        }
+        if (tid == 0)
+            *reinterpret_cast<float4*>(output + h * HD + row_start) =
+                make_float4(out0, out1, out2, out3);
+        return;
+    }
+#endif
+
     // Packed layout: S_f4[r * 32 + tid] = {S[r][tid], S[r][tid+32],
     // S[r][tid+64], S[r][tid+96]} — same 4*128 floats as the scalar tile.
     __shared__ float4 S_f4[TILE_ROWS * 32];  // 4 KiB

