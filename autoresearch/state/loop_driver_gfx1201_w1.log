     1	// SPDX-License-Identifier: Apache-2.0
     2	// Copyright (c) 2026 Kaden Schutt
     3	// hipfire — see LICENSE and NOTICE in the project root.
     4	
     5	#include <hip/hip_runtime.h>
     6	
     7	// HFQ4-G256 GEMV with fused residual add: y[row] += A[row] · x.
     8	//
     9	// VARIANT R36c1 res_w_preload:
    10	// BOD residual mixed (occ~23%, mem_busy~45%, L2~78%, vgpr=72): post
    11	// R15 hoist_x32, free micro-schedule (DOG order / LDS-x) is exhausted —
    12	// TLP already hides latency. Gate_up R35c2 won by fully separating the
    13	// weight MEMORY phase from the DOG VALU phase after x-hoist: sequential
    14	// sc/zp/pk streams for the whole group-quad, then a pure FMA burst.
    15	//
    16	// Hypothesis: same separation helps residual's dual-row weight stream
    17	// (2 rows × 4 groups = 8 headers). Baseline interleaves load+FMA per
