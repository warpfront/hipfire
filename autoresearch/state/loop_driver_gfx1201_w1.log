  for r in d.get("rows",[]):
    rk=r.get("kernel",""); rt=rk.split("_"); n=0
    for a,b in zip(kt,rt):
      if a==b: n+=1
      else: break
    if rk==kern or rk.startswith(kern) or kern.startswith(rk): n=999
    if n>bestn: bestn=n; best=r
  if best and bestn>=4:
