   183	         && GIT_INDEX_FILE="$TIDX" git update-index --add --cacheinfo "100644,$BLOB,$KSRC" 2>/dev/null; then
   184	        TREE=$(GIT_INDEX_FILE="$TIDX" git write-tree 2>/dev/null)
   185	        NEW=$(git -c user.email=151092359+Kaden-Schutt@users.noreply.github.com -c user.name="Kaden Schutt" \
   186	              commit-tree "$TREE" -p "$CUR" -m "WIN $LABEL $KERNEL f=$F d=${DELTA}% rounds=$ROUNDS" 2>/dev/null)
