codex
The profile confirms a single-block, 8-wave kernel with only 18% memory activity and 48 VGPRs. Prior attempts exhausted reductions, sign timing, generic prefetch, and X-in-LDS. I’ll test a distinct gfx12-only weight staging layout: issue weight loads alongside the existing sum pass, write a bank-conflict-free LDS transpose, then consume that staging after RMS—trading live weight registers for LDS without changing arithmetic.
apply patch
patch: completed
/tmp/exp_R25c2.hip
diff --git a//tmp/exp_R25c2.hip b//tmp/exp_R25c2.hip
index 6305b87bc6d25bc107f28bbf125fdf11a7718329..0a10dc4f67ffeac6c53f2f4a95323dc99aba8df7
--- a//tmp/exp_R25c2.hip
+++ b//tmp/exp_R25c2.hip
@@ -1,146 +1,208 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
 #include <hip/hip_runtime.h>
-#include <hip/hip_fp16.h>
 
-// gfx12 (RDNA4) sister of `gemm_hfq4g256_moe_grouped_wmma_k2`. Same
-// four levers as the validated gfx12 ports (PR #56) on the residual k2:
-//   1. WMMA builtin: __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12
-//   2. A/B operands: half8_t (8 fp16/lane) instead of half16_t.
-//   3. K dim split across 2 lane-groups (k_grp = tid >> 4); each carries
-//      a half of the 16-K tile.
-//   4. C-output mapping: acc[j] = C[8*k_grp + j][m_lane].
-//
-// Per-block contract (unchanged from the gfx11 grouped variant):
-//   - Tile (blockIdx.x, blockIdx.y) owns a 16-row × 16-slot output tile.
-//   - All 16 slots share the same expert (Phase 2's pad-then-scan
-//     guarantees expert_offsets aligned to BLOCK_M = 16).
-//   - Each lane m_lane = tid & 15 corresponds to one slot AND one M-row.
-//   - X is gathered via sorted_slot_index[slot_start + m_lane]; -1
-//     padding lanes substitute zero rows for the B operand.
+// R25c2 rms_p1_weight_lds_soa (gfx12 only):
 //
-// Grid: [ceil(M/16), m_total/16]. Block: [32]. LDS: 0.
-
-typedef _Float16 __attribute__((ext_vector_type(8))) half8_t;
-typedef float    __attribute__((ext_vector_type(8))) float8_t;
+// The A3B decode shape is K=2048 and one 256-thread workgroup, so it has
+// only eight runnable waves.  Its BOD row is latency/occupancy-starved
+// (0.1% global occupancy, 18.1% mem_busy, 48 VGPR).  The current shared
+// frontier keeps the first FWHT group's x and weight vectors live across
+// the reduction.  This candidate retains the early issue point but stages
+// every weight load during Phase 1a into the already allocated dynamic LDS.
+// The SoA layout maps Phase-2 lane l's components j to [j * 32 + l], so a
+// wave reads unique LDS banks.  It removes the live prefetched weight
+// vectors rather than adding a deeper prefetch ring.  X, RMS, FWHT, signs,
+// and output arithmetic retain their exact order.  The entire altered path
+// is gfx12-gated so all other architectures preprocess to the base path.
 
-// `x_row_div` controls how sorted_slot_index maps to X_src rows:
-//   gate_up: X_src = x_rot_batch[N × K], x_row_div = K_TOP → x_row = flat / K_TOP
-//   down:    X_src = rot_batch[total_slots × K], x_row_div = 1 → x_row = flat
-__launch_bounds__(32, 2)
-extern "C" __global__ void gemm_hfq4g256_moe_grouped_wmma_gfx12(
-    const unsigned long long* __restrict__ expert_weight_ptrs, // [E]
-    const int*                __restrict__ expert_tile_ids,    // [m_total / 16]
-    const int*                __restrict__ sorted_slot_index,  // [m_total]
-    const _Float16*           __restrict__ X_src,              // [n_rows × K]
-    float*                    __restrict__ Y_grouped,          // [m_total × M]
-    int M, int K, int x_row_div, int m_total
+__launch_bounds__(256, 1)
+extern "C" __global__ void fused_rmsnorm_mq_rotate(
+    const float* __restrict__ x,
+    const float* __restrict__ weight,
+    const float* __restrict__ signs1,
+    const float* __restrict__ signs2,
+    float* __restrict__ x_rot,
+    int K,
+    float eps
 ) {
+    extern __shared__ float smem[];
+#if defined(__gfx1200__) || defined(__gfx1201__)
+    // Host reserves K floats plus the 256-float reduction buffer.
+    float* w_stage = smem;             // [K], each group is component-major
+    float* reduce = smem + K;          // [256]
+#else
+    float* reduce = smem;              // [256]
+#endif
+
     const int tid = threadIdx.x;
-    const int row_start = blockIdx.x * 16;
-    const int tile_y = blockIdx.y;
-    const int slot_start = tile_y * 16;
+    const int block_size = blockDim.x; // 256
+    const int lane_id = tid & 31;
+    const int warp_id = tid >> 5;      // 0..7
+    const int num_warps = block_size >> 5;
 
-    if (row_start >= M || slot_start >= m_total) return;
+    const long long batch_off = (long long)blockIdx.x * K;
