--- harness candidate handling ---
     1	#!/usr/bin/env bash
     2	# ab_certify_v2.sh <arch> <dev> <card> <model> <kernel> <label> <variant.hip>
     3	# Harness-v2 certify. Core change vs v1: ADAPTIVE SAMPLING instead of fixed 4/8 rounds +
     4	# magnitude floor. Sample until the MWU dominance f decisively resolves, so real-but-noisy
     5	# 2-3% marginals get captured and true noise is rejected. Wins commit to a per-card
     6	# wins-only branch (loop/card<N>); everything logs to the JSONL. NO fold until rollover.
     7	#
     8	# Verdict:  f>=0.90 & delta>FLOOR & gated -> WIN
     9	#           f<=0.65 (or delta<-FLOOR & f<=0.35) & gated -> DEAD
    10	#           0.65<f<0.90 at CAP rounds -> INCONCLUSIVE (parked; re-openable on rerun)
    11	#           var_coh=BAD -> COHERENCE_FAIL ;  clock skew -> VOID   (both regardless of f)
    12	set -u
    13	ARCH=$1 DEV=$2 CARD=$3 MODEL=$4 KERNEL=$5 LABEL=$6 VARIANT=$7
    14	MAIN="${AR_MAIN:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/../.." && pwd)}"   # derive repo root from THIS script's location (was ~/hipfire); AR_MAIN overrides. Makes deps/ledger/worktree resolve against whichever checkout invoked the grader.
    15	WT="${WT_OVERRIDE:-$MAIN/.aw/sw_card${CARD}}"   # WT_OVERRIDE = per-worker worktree for the swarm (parallel builds must not share kernels/src+target)
    16	export PATH=$HOME/.bun/bin:$PATH
    17	export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"; export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"   # pin the Rust toolchain BEFORE the HOME override (else rustup can't find its default toolchain in the isolated .swhome)
    18	export HOME="$WT/.swhome"; mkdir -p "$HOME/.hipfire"
    19	export HIPFIRE_DAEMON_ID="sw_card${CARD}"; ID="$HIPFIRE_DAEMON_ID"
    20	export CARGO_TARGET_DIR="$WT/target"
    21	FLOOR=0.15                # just above clock-noise; f carries the reliability
    22	CAP=16                    # max A/B rounds before parking INCONCLUSIVE
    23	WIN_F=0.90 ; DEAD_F=0.65  # resolve band edges
    24	BASELINE_REF="${BASELINE_REF:-loop_baseline_gfx1201}"   # env-overridable (smoke tests use an isolated ref)
    25	CARD_BRANCH="loop/card${CARD}"
    26	# clock-skew gate reads DRM pp_dpm_sclk. The WORKTREE slot (CARD) need not match the DRM card
    27	# index of the GPU under test (e.g. gfx1151 = HIP dev 1 = DRM card1, but its worktree is sw_card2).
    28	# SCLK env override lets the caller point the gate at the ACTUAL device's clock node.
    29	SCLK="${SCLK:-/sys/class/drm/card${CARD}/device/pp_dpm_sclk}"
    30	ORACLE="${ORACLE:-$MAIN/autoresearch/harness/oracle_profile.sh}"   # persistent (NOT /tmp); env-overridable
    31	KSRC="kernels/src/${KERNEL}.hip"
    32	LEDGER="$MAIN/autoresearch/ledger/swarm_${ARCH}_${KERNEL}.jsonl"
    33	cd "$WT" || { echo "{\"label\":\"$LABEL\",\"error\":\"no worktree $WT\"}"; exit 1; }
    34	# reset the target kernel to the CURRENT baseline (SHARED advancing frontier — every worker inherits the
    35	# fleet's accumulated wins here, so each variant is measured INCREMENTALLY against the current best, not a
    36	# frozen 2am snapshot). BASE_SHA pins the exact tip we build+measure against for the cache key + staleness guard.
    37	git checkout "$BASELINE_REF" -- kernels/src/ 2>/dev/null || git checkout -- kernels/src/ 2>/dev/null
    38	git clean -fdq kernels/src/ 2>/dev/null
    39	BASE_SHA=$(git rev-parse "$BASELINE_REF" 2>/dev/null || git rev-parse HEAD 2>/dev/null)
    40	# ---- Bug-2 guard: kernels are EMBEDDED via include_str! (no runtime disk-by-name loader), and the BOD names
    41	#      __global__ SYMBOLS whose source often lives in a differently-named base file. A swap into a file that is
    42	#      NOT compiled in — or a variant byte-identical to the baseline — is a NO-OP recompile whose A/B "win" is a
    43	#      pure measurement phantom (the overnight 26-wins inflation). Resolve symbol->source, else reject. --------
    44	emit_reject(){ # $1=verdict $2=note -> minimal ledger row (counts toward exhaustion) + stdout + exit
    45	  mkdir -p "$(dirname "$LEDGER")"
    46	  python3 - "$ARCH" "$KERNEL" "$LABEL" "$(basename "$VARIANT")" "$1" "$2" "$LEDGER" <<'PY'
    47	import sys,json
    48	arch,kern,label,variant,verdict,note,ledger=sys.argv[1:8]
    49	open(ledger,"a").write(json.dumps({"arch":arch,"kernel":kern,"label":label,"variant":variant,
    50	  "verdict":verdict,"WIN":False,"mwu_dominance":0.0,"rounds":0,"delta_pct":0.0,"note":note})+"\n")
    51	print(json.dumps({"label":label,"verdict":verdict,"note":note}))
    52	PY
    53	  exit 0
    54	}
    55	if ! grep -rqF "$(basename "$KSRC")" crates/*/src/ 2>/dev/null; then
    56	  # KERNEL is a __global__ symbol, not a compiled-in file: retarget to the UNIQUE include_str!'d .hip whose
    57	  # definition/launch signature is exactly `<KERNEL>(` (word-anchored, so k8 != k8_indexed). Parity gate backstops.
    58	  RES=""
    59	  for f in $(grep -rlE "__global__.*\b${KERNEL}[[:space:]]*\(" kernels/src/*.hip 2>/dev/null); do
    60	    grep -rqF "$(basename "$f")" crates/*/src/ 2>/dev/null && RES="$RES $(basename "$f")"
    61	  done
    62	  set -- $RES
    63	  if [ "$#" -eq 1 ]; then KSRC="kernels/src/$1"
    64	  else emit_reject DEAD_FILE "kernels/src/${KERNEL}.hip not compiled in (include_str!) and symbol->file is $#-way — un-targetable via file-swap"; fi
    65	fi
    66	# no-op EDIT guard: the variant must differ from the baseline version of the (possibly-resolved) file
    67	if [ -s "$VARIANT" ] && git show "$BASE_SHA:$KSRC" 2>/dev/null | cmp -s - "$VARIANT"; then
    68	  emit_reject NO_OP "variant byte-identical to baseline $KSRC — no real edit"
    69	fi
    70	DB=target/release/examples/daemon
    71	build(){ cargo build --release --example daemon --features deltanet -p hipfire-runtime 2>&1 | grep -qiE "^error|error\[" && return 1; return 0; }
    72	measure(){ local bin=$1 out=/tmp/v2m_${ID}.jsonl clkf=/tmp/v2m_${ID}.clk
    73	  rm -f .hipfire_kernels/*/"${KERNEL}".hsaco "$clkf" 2>/dev/null
    74	  ( for _ in $(seq 1 40); do grep '\*' "$SCLK" 2>/dev/null|grep -oiE "[0-9]+Mhz"|grep -oE "[0-9]+"|head -1; sleep 0.4; done > "$clkf" ) & local s=$!
    75	  printf '{"type":"load","model":"%s","params":{"max_seq":2048,"kv_mode":"q8"}}
    76	{"type":"generate","id":"w1","prompt":"Explain hash maps briefly.","temperature":0.0,"max_tokens":32}
    77	{"type":"generate","id":"w2","prompt":"Explain hash maps briefly.","temperature":0.0,"max_tokens":32}
    78	{"type":"generate","id":"m1","prompt":"Write a detailed paragraph about the history and future of computing.","temperature":0.0,"max_tokens":128}
    79	{"type":"unload"}
    80	' "$MODEL" | HIP_VISIBLE_DEVICES=$DEV "$bin" 2>"/tmp/v2e_$ID" > "$out"   # keep stderr -> daemon-reported GPU arch (rocminfo lies)
    81	  kill "$s" 2>/dev/null; wait "$s" 2>/dev/null
    82	  python3 - "$out" "$clkf" <<'PY'
    83	import json,sys
    84	dec=None;m1=""
    85	for l in open(sys.argv[1]):
    86	 try:d=json.loads(l)
    87	 except:continue
    88	 if d.get("type")=="done" and d.get("id")=="m1":dec=d.get("kernel_decode_tok_s") or d.get("decode_tok_s") or dec
    89	 if d.get("type")=="token" and d.get("id")=="m1":m1+=d.get("text","")
    90	t=m1.split();u=(len(set(t))/len(t)) if t else 0
    91	try:c=[int(x) for x in open(sys.argv[2]) if x.strip()]
    92	except:c=[]
    93	print(f"{dec if dec is not None else 0:.2f} {'OK' if (len(t)>15 and u>0.35) else 'BAD'} {max(c) if c else 0}")
    94	PY
    95	}
    96	# build baseline + variant (keep both binaries). The baseline daemon is cached KEYED BY THE BASELINE_REF TIP
    97	# SHA (not a frozen per-campaign file): all workers on one baseline generation reuse ONE build, and the cache
    98	# auto-invalidates the instant the shared baseline ADVANCES — so every A/B measures the variant against the
    99	# CURRENT best-of-fleet, never a stale snapshot (Bug 1: a frozen PREBUILT_BASE re-counted one cumulative gain
   100	# as a fresh win every round). A per-SHA flock collapses the N-worker rebuild on a fresh advance to one build.
   101	PBDIR="${PREBUILT_BASE_DIR:-/tmp}"; PBCACHE="$PBDIR/v2_pbase_${ARCH}_${BASE_SHA}"
   102	(
   103	  flock 9
   104	  if [ ! -s "$PBCACHE" ]; then
   105	    build && { cp "$DB" "$PBCACHE.$$" && mv -f "$PBCACHE.$$" "$PBCACHE"; }
   106	  fi
   107	) 9>"$PBDIR/.v2pbase_${ARCH}_${BASE_SHA}.lock"
   108	if [ ! -s "$PBCACHE" ]; then echo "{\"arch\":\"$ARCH\",\"label\":\"$LABEL\",\"verdict\":\"BASELINE_BUILD_FAIL\"}"; exit 0; fi
   109	cp "$PBCACHE" /tmp/v2_base_$ID
   110	cp "$VARIANT" "$KSRC"
   111	if ! build; then git checkout "$BASELINE_REF" -- kernels/src/ 2>/dev/null; echo "{\"arch\":\"$ARCH\",\"label\":\"$LABEL\",\"verdict\":\"VARIANT_BUILD_FAIL\"}"; exit 0; fi
   112	cp "$DB" /tmp/v2_var_$ID
   113	git checkout "$BASELINE_REF" -- kernels/src/ 2>/dev/null; git clean -fdq kernels/src/ 2>/dev/null
   114	# ---- GPU RUN-QUEUE: serialize measure+profile across parallel certifies (flock) so concurrent A/Bs don't
   115	#      thrash the GPU and produce garbage tok/s (the builds above ran UNLOCKED = parallel/CPU, the bottleneck).
   116	#      Reentrant within a process tree + kernel auto-releases on death. This is what makes a build-parallel /
   117	#      measure-serial swarm safe to fan out onto one card.
   118	GPULK="$MAIN/scripts/gpu-lock.sh"; [ -f "$GPULK" ] && { . "$GPULK"; gpu_acquire "cert_${ARCH}_c${CARD}_${LABEL}" >/dev/null 2>&1; }
   119	# ---- PARITY GATE: candidate token-ids MUST equal baseline at temp0 (catches coherent-but-wrong .hip changes) ----
   120	pids(){ rm -f .hipfire_kernels/*/*.hsaco 2>/dev/null; printf '{"type":"load","model":"%s","params":{"max_seq":2048,"kv_mode":"q8"}}
   121	{"type":"generate","id":"p","prompt":"Write a detailed paragraph about the history and future of computing.","temperature":0.0,"max_tokens":48}
   122	{"type":"unload"}
   123	' "$MODEL" | HIPFIRE_EMIT_TOKEN_IDS=1 HIP_VISIBLE_DEVICES=$DEV "$1" 2>/dev/null | python3 -c "import json,sys;print(','.join(str(json.loads(l).get('tok_id')) for l in sys.stdin if chr(34)+'committed'+chr(34) in l and chr(34)+'p'+chr(34) in l))"; }
   124	PB=$(pids /tmp/v2_base_$ID); PC=$(pids /tmp/v2_var_$ID)
   125	if [ -z "$PB" ] || [ "$PB" != "$PC" ]; then [ -f "$GPULK" ] && gpu_release >/dev/null 2>&1; echo "{\"arch\":\"$ARCH\",\"label\":\"$LABEL\",\"verdict\":\"PARITY_FAIL\"}"; exit 0; fi
   126	# ---- ADAPTIVE SAMPLING ----
   127	BASE=();VAR=();BK=();VK=();BC=OK;VC=OK
   128	sample(){ local n=$1 r d c k; for r in $(seq 1 "$n"); do
   129	  read d c k < <(measure /tmp/v2_base_$ID); BASE+=("$d");BK+=("$k");[ "$c" = BAD ]&&BC=BAD
   130	  read d c k < <(measure /tmp/v2_var_$ID);  VAR+=("$d"); VK+=("$k");[ "$c" = BAD ]&&VC=BAD
   131	done; }
   132	fstats(){ python3 - "${BASE[*]}" "${VAR[*]}" <<'PY'
   133	import sys,statistics as st
   134	b=[float(x) for x in sys.argv[1].split()];v=[float(x) for x in sys.argv[2].split()]
   135	n=len(v)*len(b); f=sum((1.0 if x>y else .5 if x==y else 0) for x in v for y in b)/n if n else .5
   136	bm=st.median(b);vm=st.median(v);d=100*(vm-bm)/bm if bm else 0
   137	print(f"{f:.4f} {d:.3f} {bm:.2f} {vm:.2f}")
