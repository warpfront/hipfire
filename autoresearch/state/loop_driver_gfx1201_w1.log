+    // row's state is read, updated, consumed, and requantized exactly once, so
+    // it need not make the generic path's LDS round trip.  Keep the row-local
+    // arithmetic and RNG order identical; the generic path below handles every
+    // multi-token call unchanged.
+    if (n_tokens == 1) {
+        const float* q_t = q + h * HD;
+        const float* k_t = k + h * HD;
+        const float* v_t = v + h * HD;
