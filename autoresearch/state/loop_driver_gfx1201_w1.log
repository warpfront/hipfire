     7	// Fused RMSNorm + FWHT rotation for MagnumQuant inputs.
     8	//
     9	// VARIANT R29c1 rms_p1_pref_xw:
    10	// BOD latency/occ-starved (occ=0.2%, mem_busy=18.3%, L2=73.8%, vgpr=48):
    11	// decode launches grid=[1] so occupancy is STRUCTURALLY capped (1 block /
    12	// 64 CUs). R11 fwht_softpipe1 (next-group softpipe) was INCONCLUSIVE and
    13	// only added VGPR (48→72) without raising waves. Softpipe of NEXT group
    14	// is also a no-op for the A3B hot shape K=2048 (groups_total=8 =
    15	// num_warps → groups_per_warp=1).
    16	//
    17	// Hypothesis: the real latency to hide is Phase-1b's two barriers + warp
    18	// reduce + rsqrt — currently the first (and only) group's x/weight loads
    19	// wait until AFTER rms is published. Prefetch this warp's first group's
    20	// x+weight (+ lane-local signs1/2) immediately after Phase-1a sum-of-
    21	// squares, so those global loads overlap the reduction tree. Math is
    22	// identical: still ((x*w)*rms)*s1 then FWHT then *s2/16. Only load
    23	// issue time moves earlier.
    24	
    25	__launch_bounds__(256, 1)
    26	extern "C" __global__ void fused_rmsnorm_mq_rotate(
    27	    const float* __restrict__ x,
    28	    const float* __restrict__ weight,
    29	    const float* __restrict__ signs1,
    30	    const float* __restrict__ signs2,
    31	    float* __restrict__ x_rot,
    32	    int K,
    33	    float eps
    34	) {
    35	    extern __shared__ float smem[];
    36	    float* reduce = smem;              // [256]
    37	
    38	    const int tid = threadIdx.x;
    39	    const int block_size = blockDim.x; // 256
    40	    const int lane_id = tid & 31;
    41	    const int warp_id = tid >> 5;      // 0..7
    42	    const int num_warps = block_size >> 5;
    43	
    44	    const long long batch_off = (long long)blockIdx.x * K;
    45	    const float* x_b     = x     + batch_off;
    46	          float* x_rot_b = x_rot + batch_off;
    47	
    48	    // Phase 1a: accumulate sum-of-squares (same stride/order as baseline).
    49	    float local_sum = 0.0f;
    50	    for (int i = tid; i < K; i += block_size) {
    51	        float v = x_b[i];
    52	        local_sum += v * v;
    53	    }
    54	
    55	    // Prefetch first FWHT group's x/weight (+ lane-local signs) so the
    56	    // loads ride under Phase-1b barriers. groups layout is wave-uniform
    57	    // (depends only on K and warp_id), so this is safe before rms exists.
    58	    const int groups_total = K / 256;
    59	    const int groups_per_warp = (groups_total + num_warps - 1) / num_warps;
    60	    const int warp_group_start = warp_id * groups_per_warp;
    61	    const int d0 = lane_id * 8;
    62	
    63	    float4 pref_x0, pref_x1, pref_w0, pref_w1;
    64	    float4 s10, s11, s20, s21;
    65	    const int pref_group = warp_group_start;
    66	    const bool have_pref = (groups_per_warp > 0 && pref_group < groups_total);
    67	    if (have_pref) {
    68	        const int base = pref_group * 256 + d0;
    69	        pref_x0 = *reinterpret_cast<const float4*>(x_b + base);
    70	        pref_x1 = *reinterpret_cast<const float4*>(x_b + base + 4);
    71	        pref_w0 = *reinterpret_cast<const float4*>(weight + base);
    72	        pref_w1 = *reinterpret_cast<const float4*>(weight + base + 4);
    73	    }
    74	    // signs1/2 are indexed only by lane (not group) — load once for the warp.
    75	    s10 = *reinterpret_cast<const float4*>(signs1 + d0);
    76	    s11 = *reinterpret_cast<const float4*>(signs1 + d0 + 4);
    77	    s20 = *reinterpret_cast<const float4*>(signs2 + d0);
    78	    s21 = *reinterpret_cast<const float4*>(signs2 + d0 + 4);
    79	
    80	    // Phase 1b: block reduction -> RMS (unchanged tree).
    81	    float warp_sum = local_sum;
    82	    warp_sum += __shfl_down(warp_sum, 16);
    83	    warp_sum += __shfl_down(warp_sum, 8);
    84	    warp_sum += __shfl_down(warp_sum, 4);
    85	    warp_sum += __shfl_down(warp_sum, 2);
    86	    warp_sum += __shfl_down(warp_sum, 1);
    87	    if (lane_id == 0) reduce[warp_id] = warp_sum;
    88	    __syncthreads();
    89	
    90	    if (tid < 32) {
    91	        warp_sum = (tid < num_warps) ? reduce[tid] : 0.0f;
    92	        warp_sum += __shfl_down(warp_sum, 4);
    93	        warp_sum += __shfl_down(warp_sum, 2);
    94	        warp_sum += __shfl_down(warp_sum, 1);
    95	        if (tid == 0) reduce[0] = rsqrtf(warp_sum / (float)K + eps);
    96	    }
    97	    __syncthreads();
    98	    const float rms = reduce[0];
    99	
   100	    // Phase 2: FWHT. First group uses prefetched x/w; later groups (if any)
   101	    // load as before. signs already in registers.
   102	    for (int gi = 0; gi < groups_per_warp; gi++) {
   103	        const int group = warp_group_start + gi;
   104	        if (group >= groups_total) break;
   105	
   106	        const int base = group * 256 + d0;
   107	
   108	        float4 x0, x1, w0, w1;
   109	        if (gi == 0 && have_pref) {
   110	            x0 = pref_x0; x1 = pref_x1;
   111	            w0 = pref_w0; w1 = pref_w1;
   112	        } else {
   113	            x0 = *reinterpret_cast<const float4*>(x_b + base);
   114	            x1 = *reinterpret_cast<const float4*>(x_b + base + 4);
   115	            w0 = *reinterpret_cast<const float4*>(weight + base);
   116	            w1 = *reinterpret_cast<const float4*>(weight + base + 4);
   117	        }
   118	
   119	        // Exact multiply order: ((x * weight) * rms) * sign.
   120	        float v0 = x0.x * w0.x * rms * s10.x;
   121	        float v1 = x0.y * w0.y * rms * s10.y;
   122	        float v2 = x0.z * w0.z * rms * s10.z;
   123	        float v3 = x0.w * w0.w * rms * s10.w;
   124	        float v4 = x1.x * w1.x * rms * s11.x;
   125	        float v5 = x1.y * w1.y * rms * s11.y;
   126	        float v6 = x1.z * w1.z * rms * s11.z;
   127	        float v7 = x1.w * w1.w * rms * s11.w;
   128	
   129	        // Local butterfly: strides 1, 2, 4.
   130	        float t;
   131	        t = v0; v0 = v0 + v1; v1 = t - v1;
   132	        t = v2; v2 = v2 + v3; v3 = t - v3;
   133	        t = v4; v4 = v4 + v5; v5 = t - v5;
   134	        t = v6; v6 = v6 + v7; v7 = t - v7;
   135	
   136	        t = v0; v0 = v0 + v2; v2 = t - v2;
   137	        t = v1; v1 = v1 + v3; v3 = t - v3;
   138	        t = v4; v4 = v4 + v6; v6 = t - v6;
   139	        t = v5; v5 = v5 + v7; v7 = t - v7;
   140	
   141	        t = v0; v0 = v0 + v4; v4 = t - v4;
   142	        t = v1; v1 = v1 + v5; v5 = t - v5;
   143	        t = v2; v2 = v2 + v6; v6 = t - v6;
   144	        t = v3; v3 = v3 + v7; v7 = t - v7;
   145	
   146	        #define HBFLY(v, pat, str) do { \
   147	            float _p = __int_as_float(__builtin_amdgcn_ds_swizzle(__float_as_int(v), (pat))); \
   148	            if (lane_id & (str)) { (v) = _p - (v); } else { (v) = (v) + _p; } \
   149	        } while (0)
   150	        #define HBFLY8(pat, str) \
   151	            HBFLY(v0,pat,str); HBFLY(v1,pat,str); HBFLY(v2,pat,str); HBFLY(v3,pat,str); \
   152	            HBFLY(v4,pat,str); HBFLY(v5,pat,str); HBFLY(v6,pat,str); HBFLY(v7,pat,str)
   153	
   154	        HBFLY8(0x041F, 1);
   155	        HBFLY8(0x081F, 2);
   156	        HBFLY8(0x101F, 4);
   157	        HBFLY8(0x201F, 8);
   158	        HBFLY8(0x401F, 16);
   159	        #undef HBFLY8
   160	        #undef HBFLY
   161	
   162	        const float s = 0.0625f;
   163	        float4 out0;
   164	        float4 out1;
   165	        out0.x = v0 * s * s20.x;
   166	        out0.y = v1 * s * s20.y;
   167	        out0.z = v2 * s * s20.z;
   168	        out0.w = v3 * s * s20.w;
   169	        out1.x = v4 * s * s21.x;
   170	        out1.y = v5 * s * s21.y;
   171	        out1.z = v6 * s * s21.z;
   172	        out1.w = v7 * s * s21.w;
   173	        *reinterpret_cast<float4*>(x_rot_b + base) = out0;
   174	        *reinterpret_cast<float4*>(x_rot_b + base + 4) = out1;
   175	    }
   176	}

