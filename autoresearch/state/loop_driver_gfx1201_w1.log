     5	#include <hip/hip_runtime.h>
     6	
     7	// 4-way fused HFQ4-G256 GEMV for the Qwen3.5 DeltaNet linear-attention
     8	// layer preamble. One kernel launch performs all four projections from a
     9	// single shared x_rot input:
    10	//
    11	//   y_qkv   = W_qkv   · x_rot      (M=qkv_m,   e.g. 6144 on 0.8B)
    12	//   y_z     = W_z     · x_rot      (M=z_m,     e.g. 2048)
    13	//   y_beta  = W_beta  · x_rot      (M=beta_m,  e.g. 16)
    14	//   y_alpha = W_alpha · x_rot      (M=alpha_m, e.g. 16)
    15	//
    16	// Grid = qkv_m + z_m + beta_m + alpha_m workgroups × 32 threads. Each
    17	// workgroup picks its target matrix/row via blockIdx.x range check, then
    18	// runs the SAME 4x-unroll inner loop as gemv_hfq4g256.hip — including
    19	// the 5302926 tail-group accumulator fix (acc[g%4], not all-into-acc0).
    20	//
    21	// Arch coverage: works on every RDNA generation (gfx1010 / gfx1013 /
    22	// gfx1030 / gfx1100+) because gemv_hfq4g256.hip and its arch variants
    23	// were unified onto the same 4-accumulator inner loop after the 5302926
    24	// fix. The launch_bounds(32, 16) target matches the gfx1100 register
    25	// budget; on gfx1010 this is the same single-wave-per-SIMD-half
    26	// occupancy used by the standalone gemv_hfq4g256.hip — both kernels
    27	// share the same VGPR pressure profile.
    28	//
    29	// Why fuse:
    30	//   1. Four launches → one → saves ~3 × (host submit + dispatch floor)
    31	//      per LA layer. On gfx1100 that's ~36 µs/layer ≈ ~640 µs per
    32	//      forward. On gfx1010 the per-launch dispatch floor is even higher,
    33	//      so the relative win is at least as large.
    34	//   2. The 16-wave w_beta and w_alpha launches are catastrophically
    35	//      under-subscribed on their own (16 / N_max_waves slots ≪ 1%).
    36	//      Co-scheduling them with the 6144-wave wqkv body lets the wave
    37	//      scheduler keep real work in flight during the tails.
    38	//
    39	// Bit-exact with four sequential gemv_hfq4g256 calls — the inner loop
    40	// is a verbatim copy.
    41	
    42	__launch_bounds__(32, 16)
    43	extern "C" __global__ void fused_qkvza_hfq4g256(
    44	    const char*  __restrict__ A_qkv,
    45	    const char*  __restrict__ A_z,
    46	    const char*  __restrict__ A_beta,
    47	    const char*  __restrict__ A_alpha,
    48	    const float* __restrict__ x,
    49	    float*       __restrict__ y_qkv,
    50	    float*       __restrict__ y_z,
    51	    float*       __restrict__ y_beta,
    52	    float*       __restrict__ y_alpha,
    53	    int qkv_m, int z_m, int beta_m, int alpha_m,
    54	    int K
    55	) {
    56	    const int gid = blockIdx.x;
    57	    const int total_m = qkv_m + z_m + beta_m + alpha_m;
    58	    if (gid >= total_m) return;
    59	
    60	    // Route this workgroup to its matrix + output row.
    61	    const char* A;
    62	    float* y;
    63	    int row;
    64	    if (gid < qkv_m) {
    65	        A = A_qkv;   y = y_qkv;   row = gid;
    66	    } else if (gid < qkv_m + z_m) {
    67	        A = A_z;     y = y_z;     row = gid - qkv_m;
    68	    } else if (gid < qkv_m + z_m + beta_m) {
    69	        A = A_beta;  y = y_beta;  row = gid - (qkv_m + z_m);
    70	    } else {
    71	        A = A_alpha; y = y_alpha; row = gid - (qkv_m + z_m + beta_m);
    72	    }
    73	
    74	    const int tid = threadIdx.x;
    75	    const int groups_per_row = K / 256;
    76	    const char* row_ptr = A + (long long)row * groups_per_row * 136;
    77	    const int boff = tid * 4;
    78	
    79	    // Four accumulators for the 4x group unroll. Tail groups go back into
    80	    // acc[gi] to preserve the 4-way interleaving the combine step assumes
    81	    // (this is the 5302926 bug fix — DO NOT collapse into acc0).
    82	    float acc0 = 0.0f, acc1 = 0.0f, acc2 = 0.0f, acc3 = 0.0f;
    83	    const int quads = groups_per_row >> 2;
    84	    const int tail  = groups_per_row & 3;
    85	
    86	    for (int q = 0; q < quads; q++) {
    87	        const int g = q << 2;
    88	        const char* gp0 = row_ptr + g * 136;
    89	        const char* gp1 = gp0 + 136;
    90	        const char* gp2 = gp1 + 136;
    91	        const char* gp3 = gp2 + 136;
    92	#if defined(__gfx1200__) || defined(__gfx1201__)
    93	        // R4c0_qkvza_spref272: L2-resident BOD (occ~35% mem_busy~41%);
    94	        // soft-prefetch next quad weights (+272B = 2 groups) while this quad's DOG runs.
    95	        // gfx12-ONLY: s_prefetch_data needs target feature gfx12-insts. The ENTIRE block is
    96	        // gated so gfx11/gfx10 (RDNA1-3) compile BYTE-IDENTICALLY to the pre-lever kernel —
    97	        // zero effect on any other arch's codegen. Hint only; identical load/FMA stream.
    98	        if (q + 1 < quads) {
    99	            __builtin_amdgcn_s_prefetch_data((const void*)(gp0 + 272), 0);
   100	        }
   101	#endif
   102	
   103	        float sc0 = __builtin_bit_cast(float, *(const unsigned int*)(gp0));
   104	        float zp0 = __builtin_bit_cast(float, *(const unsigned int*)(gp0 + 4));
   105	        float sc1 = __builtin_bit_cast(float, *(const unsigned int*)(gp1));
   106	        float zp1 = __builtin_bit_cast(float, *(const unsigned int*)(gp1 + 4));
   107	        float sc2 = __builtin_bit_cast(float, *(const unsigned int*)(gp2));
   108	        float zp2 = __builtin_bit_cast(float, *(const unsigned int*)(gp2 + 4));
   109	        float sc3 = __builtin_bit_cast(float, *(const unsigned int*)(gp3));
   110	        float zp3 = __builtin_bit_cast(float, *(const unsigned int*)(gp3 + 4));
   111	
   112	        unsigned int pk0 = *(const unsigned int*)(gp0 + 8 + boff);
   113	        unsigned int pk1 = *(const unsigned int*)(gp1 + 8 + boff);
   114	        unsigned int pk2 = *(const unsigned int*)(gp2 + 8 + boff);
   115	        unsigned int pk3 = *(const unsigned int*)(gp3 + 8 + boff);
   116	
   117	        int base = g * 256 + tid * 8;
   118	
   119	        #define DOG(pk, sc, zp, b, a) \
   120	            (a) += (sc * (float)((pk) & 0xFu)        + zp) * x[(b)]     \
   121	                 + (sc * (float)(((pk) >> 4) & 0xFu)  + zp) * x[(b) + 1] \
   122	                 + (sc * (float)(((pk) >> 8) & 0xFu)  + zp) * x[(b) + 2] \
   123	                 + (sc * (float)(((pk) >> 12) & 0xFu) + zp) * x[(b) + 3] \
   124	                 + (sc * (float)(((pk) >> 16) & 0xFu) + zp) * x[(b) + 4] \
   125	                 + (sc * (float)(((pk) >> 20) & 0xFu) + zp) * x[(b) + 5] \
   126	                 + (sc * (float)(((pk) >> 24) & 0xFu) + zp) * x[(b) + 6] \
   127	                 + (sc * (float)(((pk) >> 28) & 0xFu) + zp) * x[(b) + 7]
   128	
   129	        DOG(pk0, sc0, zp0, base,       acc0);
   130	        DOG(pk1, sc1, zp1, base + 256, acc1);
   131	        DOG(pk2, sc2, zp2, base + 512, acc2);
   132	        DOG(pk3, sc3, zp3, base + 768, acc3);
   133	        #undef DOG
   134	    }
   135	
   136	    // Tail handling: preserve acc[gi] interleaving. See 5302926 bug report.
   137	    #define TAIL_DOG(pk, sc, zp, b, a) \
   138	        (a) += (sc * (float)((pk) & 0xFu)        + zp) * x[(b)]     \
   139	             + (sc * (float)(((pk) >>  4) & 0xFu) + zp) * x[(b) + 1] \
   140	             + (sc * (float)(((pk) >>  8) & 0xFu) + zp) * x[(b) + 2] \
   141	             + (sc * (float)(((pk) >> 12) & 0xFu) + zp) * x[(b) + 3] \
   142	             + (sc * (float)(((pk) >> 16) & 0xFu) + zp) * x[(b) + 4] \
   143	             + (sc * (float)(((pk) >> 20) & 0xFu) + zp) * x[(b) + 5] \
   144	             + (sc * (float)(((pk) >> 24) & 0xFu) + zp) * x[(b) + 6] \
   145	             + (sc * (float)(((pk) >> 28) & 0xFu) + zp) * x[(b) + 7]
   146	
   147	    if (tail >= 1) {
   148	        const int g = quads << 2;
   149	        const char* gp = row_ptr + g * 136;
   150	        float sc = __builtin_bit_cast(float, *(const unsigned int*)(gp));
   151	        float zp = __builtin_bit_cast(float, *(const unsigned int*)(gp + 4));
   152	        unsigned int pk = *(const unsigned int*)(gp + 8 + boff);
   153	        int base = g * 256 + tid * 8;
   154	        TAIL_DOG(pk, sc, zp, base, acc0);
   155	    }
   156	    if (tail >= 2) {
   157	        const int g = (quads << 2) + 1;
   158	        const char* gp = row_ptr + g * 136;
   159	        float sc = __builtin_bit_cast(float, *(const unsigned int*)(gp));
   160	        float zp = __builtin_bit_cast(float, *(const unsigned int*)(gp + 4));
   161	        unsigned int pk = *(const unsigned int*)(gp + 8 + boff);
   162	        int base = g * 256 + tid * 8;
   163	        TAIL_DOG(pk, sc, zp, base, acc1);
   164	    }
   165	    if (tail >= 3) {
   166	        const int g = (quads << 2) + 2;
   167	        const char* gp = row_ptr + g * 136;
   168	        float sc = __builtin_bit_cast(float, *(const unsigned int*)(gp));
   169	        float zp = __builtin_bit_cast(float, *(const unsigned int*)(gp + 4));
   170	        unsigned int pk = *(const unsigned int*)(gp + 8 + boff);
   171	        int base = g * 256 + tid * 8;
   172	        TAIL_DOG(pk, sc, zp, base, acc2);
   173	    }
   174	    #undef TAIL_DOG
   175	
   176	    float acc = (acc0 + acc1) + (acc2 + acc3);
   177	    for (int offset = 16; offset > 0; offset >>= 1)
   178	        acc += __shfl_down(acc, offset);
   179	
   180	    if (tid == 0) y[row] = acc;
   181	}

