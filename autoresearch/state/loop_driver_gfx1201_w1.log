#      not a bare scalar — this is what stops it flying blind under the 5-run permutation budget) ----
BP="null"; VP="null"
if [ "$VERDICT" != "BASELINE_BUILD_FAIL" ] && [ "$VERDICT" != "VARIANT_BUILD_FAIL" ]; then
