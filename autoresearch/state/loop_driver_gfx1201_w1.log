+                s2 += __half2float(efr[tid + 64]);
+                s3 += __half2float(efr[tid + 96]);
+            }
+
+            float my_max = fmaxf(fmaxf(fabsf(s0), fabsf(s1)), fmaxf(fabsf(s2), fabsf(s3)));
+            for (int o = 16; o > 0; o >>= 1)
+                my_max = fmaxf(my_max, __shfl_xor(my_max, o));
+            const float inv_s = (my_max > 0.0f) ? (127.0f / my_max) : 0.0f;
+            signed char* dst = sq_base + r * HD;
+            if (use_ef) {
+                const float scale_out = (my_max > 0.0f) ? (my_max / 127.0f) : 1.0f;
+                const float qf0 = fminf(fmaxf(rintf(s0 * inv_s), -128.0f), 127.0f);
+                const float qf1 = fminf(fmaxf(rintf(s1 * inv_s), -128.0f), 127.0f);
+                const float qf2 = fminf(fmaxf(rintf(s2 * inv_s), -128.0f), 127.0f);
+                const float qf3 = fminf(fmaxf(rintf(s3 * inv_s), -128.0f), 127.0f);
+                efr[tid]      = __float2half(s0 - qf0 * scale_out);
+                efr[tid + 32] = __float2half(s1 - qf1 * scale_out);
+                efr[tid + 64] = __float2half(s2 - qf2 * scale_out);
+                efr[tid + 96] = __float2half(s3 - qf3 * scale_out);
+                dst[tid]      = (signed char)qf0;
+                dst[tid + 32] = (signed char)qf1;
+                dst[tid + 64] = (signed char)qf2;
+                dst[tid + 96] = (signed char)qf3;
