14:MAIN="${AR_MAIN:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/../.." && pwd)}"   # derive repo root from THIS script's location (was ~/hipfire); AR_MAIN overrides. Makes deps/ledger/worktree resolve against whichever checkout invoked the grader.
