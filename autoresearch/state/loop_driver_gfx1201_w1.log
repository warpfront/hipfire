     7	// HFQ4-G256 GEMV with fused residual add: y[row] += A[row] · x.
     8	//
     9	// VARIANT R36c1 res_w_preload:
    10	// BOD residual mixed (occ~23%, mem_busy~45%, L2~78%, vgpr=72): post
    11	// R15 hoist_x32, free micro-schedule (DOG order / LDS-x) is exhausted —
    12	// TLP already hides latency. Gate_up R35c2 won by fully separating the
    13	// weight MEMORY phase from the DOG VALU phase after x-hoist: sequential
    14	// sc/zp/pk streams for the whole group-quad, then a pure FMA burst.
    15	//
    16	// Hypothesis: same separation helps residual's dual-row weight stream
    17	// (2 rows × 4 groups = 8 headers). Baseline interleaves load+FMA per
    18	// DOG; here load all 8 sc/zp/pk first (row0 g0..g3 then row1 g0..g3 —
    19	// sequential along each row_ptr), then 8 DOG FMAs with identical math
    20	// and acc slots. Value-preserving. Expect VGPR up modestly (hold 8
    21	// headers); if DROPPED-WAVES dominates, this path is closed for residual.
    22	
    23	__launch_bounds__(32, 16)
    24	extern "C" __global__ void gemv_hfq4g256_residual(
    25	    const char* __restrict__ A,
    26	    const float* __restrict__ x,
    27	    float* __restrict__ y,
    28	    int M, int K
    29	) {
    30	    const int row0 = blockIdx.x << 1;
    31	    if (row0 >= M) return;
    32	    const int row1 = row0 + 1;
    33	    const bool have_row1 = row1 < M;
    34	    const int tid = threadIdx.x;
    35	
    36	    const int groups_per_row = K / 256;
    37	    const long long row_stride = (long long)groups_per_row * 136;
    38	    const char* row_ptr0 = A + (long long)row0 * row_stride;
    39	    const char* row_ptr1 = A + (long long)(have_row1 ? row1 : row0) * row_stride;
    40	    const int boff = tid * 4;
    41	
    42	    float acc0 = 0.0f, acc1 = 0.0f, acc2 = 0.0f, acc3 = 0.0f;
    43	    float bcc0 = 0.0f, bcc1 = 0.0f, bcc2 = 0.0f, bcc3 = 0.0f;
    44	    const int quads = groups_per_row >> 2;
    45	    const int tail = groups_per_row & 3;
    46	
    47	    #define DOG_X8(sc, zp, pk, a, x0, x1, x2, x3, x4, x5, x6, x7) do { \
    48	        (a) += ((sc) * (float)((pk) & 0xFu)         + (zp)) * (x0) \
    49	             + ((sc) * (float)(((pk) >> 4) & 0xFu)  + (zp)) * (x1) \
    50	             + ((sc) * (float)(((pk) >> 8) & 0xFu)  + (zp)) * (x2) \
    51	             + ((sc) * (float)(((pk) >> 12) & 0xFu) + (zp)) * (x3) \
    52	             + ((sc) * (float)(((pk) >> 16) & 0xFu) + (zp)) * (x4) \
    53	             + ((sc) * (float)(((pk) >> 20) & 0xFu) + (zp)) * (x5) \
    54	             + ((sc) * (float)(((pk) >> 24) & 0xFu) + (zp)) * (x6) \
    55	             + ((sc) * (float)(((pk) >> 28) & 0xFu) + (zp)) * (x7); \
    56	    } while (0)
    57	
    58	    #define LOAD_W(gp, sc, zp, pk) do { \
    59	        (sc) = __builtin_bit_cast(float, *(const unsigned int*)(gp)); \
    60	        (zp) = __builtin_bit_cast(float, *(const unsigned int*)((gp) + 4)); \
    61	        (pk) = *(const unsigned int*)((gp) + 8 + boff); \
    62	    } while (0)
    63	
    64	    for (int q = 0; q < quads; q++) {
    65	        const int g = q << 2;
    66	        const int base0 = g * 256 + tid * 8;
    67	
    68	        // Hoist full 32-wide x for this quad (4 groups × 8) via float4 pairs.
    69	        const float4 xv0a = *reinterpret_cast<const float4*>(x + base0);
    70	        const float4 xv0b = *reinterpret_cast<const float4*>(x + base0 + 4);
    71	        const float4 xv1a = *reinterpret_cast<const float4*>(x + base0 + 256);
    72	        const float4 xv1b = *reinterpret_cast<const float4*>(x + base0 + 260);
    73	        const float4 xv2a = *reinterpret_cast<const float4*>(x + base0 + 512);
    74	        const float4 xv2b = *reinterpret_cast<const float4*>(x + base0 + 516);
    75	        const float4 xv3a = *reinterpret_cast<const float4*>(x + base0 + 768);
    76	        const float4 xv3b = *reinterpret_cast<const float4*>(x + base0 + 772);
    77	
    78	        // Weight MEMORY phase: sequential along row0 then row1 (8 headers).
    79	        float sc0a, zp0a, sc1a, zp1a, sc2a, zp2a, sc3a, zp3a;
    80	        float sc0b, zp0b, sc1b, zp1b, sc2b, zp2b, sc3b, zp3b;
    81	        unsigned int pk0a, pk1a, pk2a, pk3a, pk0b, pk1b, pk2b, pk3b;
    82	        LOAD_W(row_ptr0 + g * 136, sc0a, zp0a, pk0a);
    83	        LOAD_W(row_ptr0 + (g + 1) * 136, sc1a, zp1a, pk1a);
    84	        LOAD_W(row_ptr0 + (g + 2) * 136, sc2a, zp2a, pk2a);
    85	        LOAD_W(row_ptr0 + (g + 3) * 136, sc3a, zp3a, pk3a);
    86	        LOAD_W(row_ptr1 + g * 136, sc0b, zp0b, pk0b);
    87	        LOAD_W(row_ptr1 + (g + 1) * 136, sc1b, zp1b, pk1b);
    88	        LOAD_W(row_ptr1 + (g + 2) * 136, sc2b, zp2b, pk2b);
    89	        LOAD_W(row_ptr1 + (g + 3) * 136, sc3b, zp3b, pk3b);
    90	
    91	        // Pure FMA phase: same dual-row DOG order and acc slots as baseline.
    92	        DOG_X8(sc0a, zp0a, pk0a, acc0,
    93	               xv0a.x, xv0a.y, xv0a.z, xv0a.w, xv0b.x, xv0b.y, xv0b.z, xv0b.w);
    94	        DOG_X8(sc0b, zp0b, pk0b, bcc0,
