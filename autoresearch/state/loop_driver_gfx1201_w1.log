     5	#include <hip/hip_runtime.h>
     6	
     7	// RDNA4-optimized HFQ4-G256 GEMV.
     8	// Differences from baseline:
     9	//   - 2x group unroll (process 2 groups per iteration, 16 weights/thread)
    10	//   - Software prefetch: s_prefetch_data 2 groups ahead (~272 bytes)
    11	//   - Higher VGPR budget: ~36 VGPRs (RDNA4 allows 96 at max 16-wave occupancy)
    12	//   - Targets gfx1200/gfx1201 (Navi 44/48, RDNA4)
    13	
    14	__launch_bounds__(32, 16)
    15	extern "C" __global__ void gemv_hfq4g256(
    16	    const char* __restrict__ A,
    17	    const float* __restrict__ x,
    18	    float* __restrict__ y,
    19	    int M, int K
    20	) {
    21	    const int row = blockIdx.x;
    22	    if (row >= M) return;
    23	    const int tid = threadIdx.x;
    24	
    25	    const int groups_per_row = K / 256;
    26	    const int row_bytes = groups_per_row * 136;
    27	    const char* row_ptr = A + (long long)row * row_bytes;
    28	
    29	    float acc0 = 0.0f;
    30	    float acc1 = 0.0f;
    31	
    32	    // Process 2 groups per iteration for better ILP
    33	    const int pairs = groups_per_row / 2;
    34	    const int remainder = groups_per_row & 1;
    35	
    36	    for (int gp = 0; gp < pairs; gp++) {
    37	        const int g = gp * 2;
    38	        const char* gptr0 = row_ptr + g * 136;
    39	        const char* gptr1 = gptr0 + 136;
    40	
    41	        // Prefetch 2 groups ahead (272 bytes, well within 32KB distance)
    42	        if (gp + 1 < pairs) {
    43	            __builtin_amdgcn_s_prefetch_data((const void*)(gptr0 + 272), 0);
    44	        }
    45	
    46	        // Group 0
    47	        float scale0 = __builtin_bit_cast(float, *(const unsigned int*)(gptr0));
    48	        float zero0  = __builtin_bit_cast(float, *(const unsigned int*)(gptr0 + 4));
    49	        const unsigned char* nib0 = (const unsigned char*)(gptr0 + 8);
    50	        int base0 = g * 256 + tid * 8;
    51	        int boff0 = tid * 4;
    52	
    53	        unsigned char b0 = nib0[boff0];
    54	        unsigned char b1 = nib0[boff0 + 1];
    55	        unsigned char b2 = nib0[boff0 + 2];
    56	        unsigned char b3 = nib0[boff0 + 3];
    57	
    58	        acc0 += (scale0 * (float)(b0 & 0xF) + zero0) * x[base0]
    59	              + (scale0 * (float)(b0 >> 4)  + zero0) * x[base0 + 1]
    60	              + (scale0 * (float)(b1 & 0xF) + zero0) * x[base0 + 2]
    61	              + (scale0 * (float)(b1 >> 4)  + zero0) * x[base0 + 3]
    62	              + (scale0 * (float)(b2 & 0xF) + zero0) * x[base0 + 4]
    63	              + (scale0 * (float)(b2 >> 4)  + zero0) * x[base0 + 5]
    64	              + (scale0 * (float)(b3 & 0xF) + zero0) * x[base0 + 6]
    65	              + (scale0 * (float)(b3 >> 4)  + zero0) * x[base0 + 7];
    66	
    67	        // Group 1
    68	        float scale1 = __builtin_bit_cast(float, *(const unsigned int*)(gptr1));
    69	        float zero1  = __builtin_bit_cast(float, *(const unsigned int*)(gptr1 + 4));
    70	        const unsigned char* nib1 = (const unsigned char*)(gptr1 + 8);
    71	        int base1 = (g + 1) * 256 + tid * 8;
    72	        int boff1 = tid * 4;
    73	
    74	        b0 = nib1[boff1];
    75	        b1 = nib1[boff1 + 1];
    76	        b2 = nib1[boff1 + 2];
    77	        b3 = nib1[boff1 + 3];
    78	
    79	        acc1 += (scale1 * (float)(b0 & 0xF) + zero1) * x[base1]
    80	              + (scale1 * (float)(b0 >> 4)  + zero1) * x[base1 + 1]
    81	              + (scale1 * (float)(b1 & 0xF) + zero1) * x[base1 + 2]
    82	              + (scale1 * (float)(b1 >> 4)  + zero1) * x[base1 + 3]
    83	              + (scale1 * (float)(b2 & 0xF) + zero1) * x[base1 + 4]
    84	              + (scale1 * (float)(b2 >> 4)  + zero1) * x[base1 + 5]
    85	              + (scale1 * (float)(b3 & 0xF) + zero1) * x[base1 + 6]
    86	              + (scale1 * (float)(b3 >> 4)  + zero1) * x[base1 + 7];
    87	    }
    88	
    89	    // Handle odd remainder group
    90	    if (remainder) {
    91	        const int g = groups_per_row - 1;
    92	        const char* gptr = row_ptr + g * 136;
    93	        float scale = __builtin_bit_cast(float, *(const unsigned int*)(gptr));
    94	        float zero  = __builtin_bit_cast(float, *(const unsigned int*)(gptr + 4));
    95	        const unsigned char* nib = (const unsigned char*)(gptr + 8);
    96	        int base = g * 256 + tid * 8;
    97	        int boff = tid * 4;
    98	
    99	        unsigned char b0 = nib[boff];
   100	        unsigned char b1 = nib[boff + 1];
   101	        unsigned char b2 = nib[boff + 2];
   102	        unsigned char b3 = nib[boff + 3];
   103	
   104	        acc0 += (scale * (float)(b0 & 0xF) + zero) * x[base]
   105	              + (scale * (float)(b0 >> 4)  + zero) * x[base + 1]
   106	              + (scale * (float)(b1 & 0xF) + zero) * x[base + 2]
   107	              + (scale * (float)(b1 >> 4)  + zero) * x[base + 3]
   108	              + (scale * (float)(b2 & 0xF) + zero) * x[base + 4]
   109	              + (scale * (float)(b2 >> 4)  + zero) * x[base + 5]
   110	              + (scale * (float)(b3 & 0xF) + zero) * x[base + 6]
   111	              + (scale * (float)(b3 >> 4)  + zero) * x[base + 7];
   112	    }
   113	
   114	    float acc = acc0 + acc1;
   115	    for (int offset = 16; offset > 0; offset >>= 1)
   116	        acc += __shfl_down(acc, offset);
   117	
   118	    if (tid == 0) y[row] = acc;
   119	}

