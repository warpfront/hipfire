ROUNDS=${#VAR[@]}
# ---- gating + verdict ----
BCK=$(python3 -c "import statistics as s;a=[$(IFS=,;echo "${BK[*]}")];print(int(s.median(a)) if a else 0)" 2>/dev/null)
VCK=$(python3 -c "import statistics as s;a=[$(IFS=,;echo "${VK[*]}")];print(int(s.median(a)) if a else 0)" 2>/dev/null)
