+//
+// R11c2_rms_softpipe_next: decode is single-block (grid.x=1) → measured occ
+// ~0.2% is structural; per-wave serial FWHT groups are the latency path.
+// Soft-pipeline one group ahead: form the NEXT group's pre-butterfly vregs
+// (x*w*rms*s1) while the CURRENT group's local+wave butterfly runs, then
+// store current and promote next→current. Same per-group math order as the
+// serial baseline; only load/compute interleave changes. Distinct from
+// dualgroup_ilp (which butterflies two groups in lockstep and raises VGPR).
 
 __launch_bounds__(256, 1)
 extern "C" __global__ void fused_rmsnorm_mq_rotate(
     const float* __restrict__ x,
     const float* __restrict__ weight,
     const float* __restrict__ signs1,
     const float* __restrict__ signs2,
     float* __restrict__ x_rot,
     int K,
     float eps
 ) {
     extern __shared__ float smem[];
     float* reduce = smem;              // [256]
 
     const int tid = threadIdx.x;
     // R9c2_rms_constgeom: decode always launches the canonical 256-thread,
     // 8-wave block. Make that geometry explicit so the compiler can fold the
     // stride/reduction bounds without changing the arithmetic order.
     const int block_size = 256;
     const int lane_id = tid & 31;
     const int warp_id = tid >> 5;      // 0..7
     const int num_warps = 8;
 
     // Batch row: this block processes x[blockIdx.x * K .. (blockIdx.x+1) * K].
     // For decode (grid.x == 1), offset is 0 and the behaviour is identical
