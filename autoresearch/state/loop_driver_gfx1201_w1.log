#
# Verdict:  f>=0.90 & delta>FLOOR & gated -> WIN
#           f<=0.65 (or delta<-FLOOR & f<=0.35) & gated -> DEAD
#           0.65<f<0.90 at CAP rounds -> INCONCLUSIVE (parked; re-openable on rerun)
