+        const float beta_v = beta[h];
+        const float k0 = k_t[tid], k1 = k_t[tid + 32];
+        const float k2 = k_t[tid + 64], k3 = k_t[tid + 96];
+        const float q0 = q_t[tid], q1 = q_t[tid + 32];
+        const float q2 = q_t[tid + 64], q3 = q_t[tid + 96];
+        const float4 v_rows = *reinterpret_cast<const float4*>(v_t + row_start);
+        const bool use_ef = (s_ef_residual != nullptr);
+        signed char* const sq_base = s_q8 + h * HD * HD + row_start * HD;
+        float out0 = 0.0f, out1 = 0.0f, out2 = 0.0f, out3 = 0.0f;
+
+        #pragma unroll
+        for (int r = 0; r < TILE_ROWS; ++r) {
+            const int rr = row_start + r;
+            const float scale_in = s_scales[h * HD + rr];
+            const signed char* src = sq_base + r * HD;
+            float s0 = scale_in * (float)src[tid];
+            float s1 = scale_in * (float)src[tid + 32];
+            float s2 = scale_in * (float)src[tid + 64];
+            float s3 = scale_in * (float)src[tid + 96];
+
+            float kv = s0 * k0 + s1 * k1 + s2 * k2 + s3 * k3;
+            for (int o = 16; o > 0; o >>= 1)
+                kv += __shfl_down(kv, o);
+            kv = __shfl(kv, 0);
+
+            const float v_row =
+                (r == 0) ? v_rows.x :
+                (r == 1) ? v_rows.y :
+                (r == 2) ? v_rows.z : v_rows.w;
+            const float delta = (v_row - alpha * kv) * beta_v;
+            s0 = alpha * s0 + k0 * delta;
+            s1 = alpha * s1 + k1 * delta;
+            s2 = alpha * s2 + k2 * delta;
+            s3 = alpha * s3 + k3 * delta;
+
+            float out_v = s0 * q0 + s1 * q1 + s2 * q2 + s3 * q3;
+            for (int o = 16; o > 0; o >>= 1)
