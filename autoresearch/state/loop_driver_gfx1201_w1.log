   176	  BREF="refs/heads/${BASELINE_REF#refs/heads/}"
   177	  (
   178	    flock 7
   179	    CUR=$(git rev-parse "$BASELINE_REF" 2>/dev/null)
   180	    if [ -n "$CUR" ] && git diff --quiet "$BASE_SHA" "$CUR" -- "$KSRC" 2>/dev/null; then
   181	      BLOB=$(git hash-object -w "$VARIANT" 2>/dev/null); TIDX="/tmp/v2idx_$ID"; rm -f "$TIDX"
