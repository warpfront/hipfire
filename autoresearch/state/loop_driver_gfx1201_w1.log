     7	// HFQ4-G256 GEMV with fused residual add: y[row] += A[row] · x.
     8	//
     9	// VARIANT R36c1 res_w_preload:
    10	// BOD residual mixed (occ~23%, mem_busy~45%, L2~78%, vgpr=72): post
    11	// R15 hoist_x32, free micro-schedule (DOG order / LDS-x) is exhausted —
    12	// TLP already hides latency. Gate_up R35c2 won by fully separating the
    13	// weight MEMORY phase from the DOG VALU phase after x-hoist: sequential
    14	// sc/zp/pk streams for the whole group-quad, then a pure FMA burst.
    15	//
    16	// Hypothesis: same separation helps residual's dual-row weight stream
    17	// (2 rows × 4 groups = 8 headers). Baseline interleaves load+FMA per
    18	// DOG; here load all 8 sc/zp/pk first (row0 g0..g3 then row1 g0..g3 —
    19	// sequential along each row_ptr), then 8 DOG FMAs with identical math
    20	// and acc slots. Value-preserving. Expect VGPR up modestly (hold 8
    21	// headers); if DROPPED-WAVES dominates, this path is closed for residual.
    22	
    23	#if defined(__gfx1200__) || defined(__gfx1201__)
    24	// RDNA4-only occupancy probe: force the compiler to target 32 resident
    25	// one-wave blocks (64 VGPR/thread budget) on this low-occupancy kernel.
    26	// The non-gfx12 device code remains byte-identical to the baseline.
    27	__launch_bounds__(32, 32)
    28	#else
    29	__launch_bounds__(32, 16)
    30	#endif
    31	extern "C" __global__ void gemv_hfq4g256_residual(
    32	    const char* __restrict__ A,
    33	    const float* __restrict__ x,
    34	    float* __restrict__ y,
    35	    int M, int K
    36	) {
    37	    const int row0 = blockIdx.x << 1;
    38	    if (row0 >= M) return;
    39	    const int row1 = row0 + 1;
    40	    const bool have_row1 = row1 < M;
    41	    const int tid = threadIdx.x;
    42	
    43	    const int groups_per_row = K / 256;
    44	    const long long row_stride = (long long)groups_per_row * 136;
    45	    const char* row_ptr0 = A + (long long)row0 * row_stride;
    46	    const char* row_ptr1 = A + (long long)(have_row1 ? row1 : row0) * row_stride;
    47	    const int boff = tid * 4;
    48	
    49	    float acc0 = 0.0f, acc1 = 0.0f, acc2 = 0.0f, acc3 = 0.0f;
    50	    float bcc0 = 0.0f, bcc1 = 0.0f, bcc2 = 0.0f, bcc3 = 0.0f;
    51	    const int quads = groups_per_row >> 2;
    52	    const int tail = groups_per_row & 3;
    53	
    54	    #define DOG_X8(sc, zp, pk, a, x0, x1, x2, x3, x4, x5, x6, x7) do { \
    55	        (a) += ((sc) * (float)((pk) & 0xFu)         + (zp)) * (x0) \
    56	             + ((sc) * (float)(((pk) >> 4) & 0xFu)  + (zp)) * (x1) \
    57	             + ((sc) * (float)(((pk) >> 8) & 0xFu)  + (zp)) * (x2) \
    58	             + ((sc) * (float)(((pk) >> 12) & 0xFu) + (zp)) * (x3) \
    59	             + ((sc) * (float)(((pk) >> 16) & 0xFu) + (zp)) * (x4) \
    60	             + ((sc) * (float)(((pk) >> 20) & 0xFu) + (zp)) * (x5) \
    61	             + ((sc) * (float)(((pk) >> 24) & 0xFu) + (zp)) * (x6) \
    62	             + ((sc) * (float)(((pk) >> 28) & 0xFu) + (zp)) * (x7); \
    63	    } while (0)
    64	
    65	    #define LOAD_W(gp, sc, zp, pk) do { \
    66	        (sc) = __builtin_bit_cast(float, *(const unsigned int*)(gp)); \
    67	        (zp) = __builtin_bit_cast(float, *(const unsigned int*)((gp) + 4)); \
    68	        (pk) = *(const unsigned int*)((gp) + 8 + boff); \
    69	    } while (0)
    70	
    71	    for (int q = 0; q < quads; q++) {
    72	        const int g = q << 2;
    73	        const int base0 = g * 256 + tid * 8;
    74	
    75	        // Hoist full 32-wide x for this quad (4 groups × 8) via float4 pairs.
    76	        const float4 xv0a = *reinterpret_cast<const float4*>(x + base0);
    77	        const float4 xv0b = *reinterpret_cast<const float4*>(x + base0 + 4);
    78	        const float4 xv1a = *reinterpret_cast<const float4*>(x + base0 + 256);
    79	        const float4 xv1b = *reinterpret_cast<const float4*>(x + base0 + 260);
    80	        const float4 xv2a = *reinterpret_cast<const float4*>(x + base0 + 512);
    81	        const float4 xv2b = *reinterpret_cast<const float4*>(x + base0 + 516);
    82	        const float4 xv3a = *reinterpret_cast<const float4*>(x + base0 + 768);
    83	        const float4 xv3b = *reinterpret_cast<const float4*>(x + base0 + 772);
    84	
    85	        // Weight MEMORY phase: sequential along row0 then row1 (8 headers).
    86	        float sc0a, zp0a, sc1a, zp1a, sc2a, zp2a, sc3a, zp3a;
    87	        float sc0b, zp0b, sc1b, zp1b, sc2b, zp2b, sc3b, zp3b;
    88	        unsigned int pk0a, pk1a, pk2a, pk3a, pk0b, pk1b, pk2b, pk3b;
    89	        LOAD_W(row_ptr0 + g * 136, sc0a, zp0a, pk0a);
    90	        LOAD_W(row_ptr0 + (g + 1) * 136, sc1a, zp1a, pk1a);
    91	        LOAD_W(row_ptr0 + (g + 2) * 136, sc2a, zp2a, pk2a);
    92	        LOAD_W(row_ptr0 + (g + 3) * 136, sc3a, zp3a, pk3a);
    93	        LOAD_W(row_ptr1 + g * 136, sc0b, zp0b, pk0b);
    94	        LOAD_W(row_ptr1 + (g + 1) * 136, sc1b, zp1b, pk1b);
    95	        LOAD_W(row_ptr1 + (g + 2) * 136, sc2b, zp2b, pk2b);
    96	        LOAD_W(row_ptr1 + (g + 3) * 136, sc3b, zp3b, pk3b);
    97	
